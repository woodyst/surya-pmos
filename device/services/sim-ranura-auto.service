[Unit]
Description=Apuntar la sesion del modem a la ranura donde este la SIM
Documentation=https://github.com/woodyst/surya-pmos
# ANTES que ModemManager: si MM arranca con la sesion apuntando a una ranura vacia,
# se queda en bucle de reintentos (locked -> failed) y ya no sale solo.
Before=ModemManager.service
After=rmtfs.service
Wants=rmtfs.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sim-ranura-auto.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
