+/**
+ * imx682_update_controls() - Update control ranges based on streaming mode
+ * @imx682: pointer to imx682 device
+ * @mode: pointer to imx682_mode sensor mode
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_update_controls(struct imx682 *imx682,
+				  const struct imx682_mode *mode)
+{
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx682->link_freq_ctrl, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx682->hblank_ctrl, mode->hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx682->vblank_ctrl, mode->vblank_min,
+					mode->vblank_max, 1, mode->vblank);
+}
