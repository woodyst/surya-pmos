+/**
+ * imx682_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx682 *imx682 = to_imx682(sd);
+	int ret;
+
+	/*
+	 * Hold the sensor in reset, bring the supplies and the input clock up,
+	 * and only then release it, as the vendor's power up sequence does.
+	 */
+	gpiod_set_value_cansleep(imx682->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx682_supply_names),
+				    imx682->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(imx682->inclk);
+	if (ret) {
+		dev_err(imx682->dev, "fail to enable inclk");
+		goto error_reset;
+	}
+
+	usleep_range(1000, 1200);
+
+	gpiod_set_value_cansleep(imx682->reset_gpio, 0);
+	gpiod_set_value_cansleep(imx682->standby_gpio, 1);
+
+	usleep_range(20000, 22000);
+
+	return 0;
+
+error_reset:
+	gpiod_set_value_cansleep(imx682->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(imx682_supply_names),
+			       imx682->supplies);
+
+	return ret;
+}
+
+/**
+ * imx682_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx682 *imx682 = to_imx682(sd);
+
+	gpiod_set_value_cansleep(imx682->standby_gpio, 0);
+	clk_disable_unprepare(imx682->inclk);
+	gpiod_set_value_cansleep(imx682->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(imx682_supply_names),
+			       imx682->supplies);
+
+	return 0;
+}
+
+/**
+ * imx682_init_controls() - Initialize sensor subdevice controls
+ * @imx682: pointer to imx682 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_init_controls(struct imx682 *imx682)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx682->ctrl_handler;
+	const struct imx682_mode *mode = imx682->cur_mode;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 6);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx682->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx682->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx682_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX682_EXPOSURE_MIN,
+					     lpfr - IMX682_EXPOSURE_OFFSET,
+					     IMX682_EXPOSURE_STEP,
+					     IMX682_EXPOSURE_DEFAULT);
+
+	imx682->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx682_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX682_AGAIN_MIN,
+					       IMX682_AGAIN_MAX,
+					       IMX682_AGAIN_STEP,
+					       IMX682_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx682->exp_ctrl);
+
+	imx682->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx682_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx682->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx682_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx682->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx682_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx682->link_freq_ctrl)
+		imx682->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx682->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx682_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX682_REG_MIN,
+						IMX682_REG_MAX,
+						1, mode->hblank);
+	if (imx682->hblank_ctrl)
+		imx682->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	if (ctrl_hdlr->error) {
+		dev_err(imx682->dev, "control init failed: %d",
+			ctrl_hdlr->error);
+		v4l2_ctrl_handler_free(ctrl_hdlr);
+		return ctrl_hdlr->error;
+	}
+
+	imx682->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+}
+
+/**
+ * imx682_probe() - I2C client device binding
+ * @client: pointer to i2c client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_probe(struct i2c_client *client)
+{
+	struct imx682 *imx682;
+	int ret;
+
+	imx682 = devm_kzalloc(&client->dev, sizeof(*imx682), GFP_KERNEL);
+	if (!imx682)
+		return -ENOMEM;
+
+	imx682->dev = &client->dev;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&imx682->sd, client, &imx682_subdev_ops);
+	imx682->sd.internal_ops = &imx682_internal_ops;
+
+	ret = imx682_parse_hw_config(imx682);
+	if (ret) {
+		dev_err(imx682->dev, "HW configuration is not supported");
+		return ret;
+	}
+
+	mutex_init(&imx682->mutex);
+
+	ret = imx682_power_on(imx682->dev);
+	if (ret) {
+		dev_err(imx682->dev, "failed to power-on the sensor");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = imx682_detect(imx682);
+	if (ret) {
+		dev_err(imx682->dev, "failed to find sensor: %d", ret);
+		goto error_power_off;
+	}
+
+	/* Set default mode to max resolution */
+	imx682->cur_mode = &supported_mode;
+	imx682->vblank = imx682->cur_mode->vblank;
+
+	ret = imx682_init_controls(imx682);
+	if (ret) {
+		dev_err(imx682->dev, "failed to init controls: %d", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	imx682->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx682->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	/* Initialize source pad */
+	imx682->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx682->sd.entity, 1, &imx682->pad);
+	if (ret) {
+		dev_err(imx682->dev, "failed to init entity pads: %d", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx682->sd);
+	if (ret < 0) {
+		dev_err(imx682->dev,
+			"failed to register async subdev: %d", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(imx682->dev);
+	pm_runtime_enable(imx682->dev);
+	pm_runtime_idle(imx682->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx682->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(imx682->sd.ctrl_handler);
+error_power_off:
+	imx682_power_off(imx682->dev);
+error_mutex_destroy:
+	mutex_destroy(&imx682->mutex);
+
+	return ret;
+}
+
+/**
+ * imx682_remove() - I2C client device unbinding
+ * @client: pointer to I2C client device
+ */
+static void imx682_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx682 *imx682 = to_imx682(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx682_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx682->mutex);
+}
+
+static const struct dev_pm_ops imx682_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx682_power_off, imx682_power_on, NULL)
+};
+
+static const struct of_device_id imx682_of_match[] = {
+	{ .compatible = "sony,imx682" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, imx682_of_match);
+
+static struct i2c_driver imx682_driver = {
+	.probe = imx682_probe,
+	.remove = imx682_remove,
+	.driver = {
+		.name = "imx682",
+		.pm = &imx682_pm_ops,
+		.of_match_table = imx682_of_match,
+	},
+};
+
+module_i2c_driver(imx682_driver);
+
+MODULE_DESCRIPTION("Sony imx682 sensor driver");
+MODULE_LICENSE("GPL");
