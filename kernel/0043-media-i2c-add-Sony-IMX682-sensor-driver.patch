+		exposure, gain, lpfr);
+
+	ret = imx682_write_reg(imx682, IMX682_REG_HOLD, 1, 1);
+	if (ret)
+		return ret;
+
+	ret = imx682_write_reg(imx682, IMX682_REG_LPFR, 2, lpfr);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx682_write_reg(imx682, IMX682_REG_EXPOSURE_CIT, 2, exposure);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx682_write_reg(imx682, IMX682_REG_AGAIN, 2, gain);
+
+error_release_group_hold:
+	imx682_write_reg(imx682, IMX682_REG_HOLD, 1, 0);
+
+	return ret;
+}
+
+/**
+ * imx682_set_ctrl() - Set subdevice control
+ * @ctrl: pointer to v4l2_ctrl structure
+ *
+ * Supported controls:
+ * - V4L2_CID_VBLANK
+ * - cluster controls:
+ *   - V4L2_CID_ANALOGUE_GAIN
+ *   - V4L2_CID_EXPOSURE
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx682 *imx682 =
+		container_of(ctrl->handler, struct imx682, ctrl_handler);
+	u32 analog_gain;
+	u32 exposure;
+	int ret;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		imx682->vblank = imx682->vblank_ctrl->val;
+
+		dev_dbg(imx682->dev, "Received vblank %u, new lpfr %u",
+			imx682->vblank,
+			imx682->vblank + imx682->cur_mode->height);
+
+		ret = __v4l2_ctrl_modify_range(imx682->exp_ctrl,
+					       IMX682_EXPOSURE_MIN,
+					       imx682->vblank +
+					       imx682->cur_mode->height -
+					       IMX682_EXPOSURE_OFFSET,
+					       1, IMX682_EXPOSURE_DEFAULT);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* Set controls only if sensor is in power on state */
+		if (!pm_runtime_get_if_in_use(imx682->dev))
+			return 0;
+
+		exposure = ctrl->val;
+		analog_gain = imx682->again_ctrl->val;
+
+		dev_dbg(imx682->dev, "Received exp %u, analog gain %u",
+			exposure, analog_gain);
+
+		ret = imx682_update_exp_gain(imx682, exposure, analog_gain);
+
+		pm_runtime_put(imx682->dev);
+
+		break;
+	default:
+		dev_err(imx682->dev, "Invalid control %d", ctrl->id);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+/* V4l2 subdevice control ops*/
+static const struct v4l2_ctrl_ops imx682_ctrl_ops = {
+	.s_ctrl = imx682_set_ctrl,
+};
+
+/**
+ * imx682_enum_mbus_code() - Enumerate V4L2 sub-device mbus codes
+ * @sd: pointer to imx682 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @code: V4L2 sub-device code enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_mode.code;
+
+	return 0;
+}
+
+/**
+ * imx682_enum_frame_size() - Enumerate V4L2 sub-device frame sizes
+ * @sd: pointer to imx682 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fsize: V4L2 sub-device size enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fsize)
+{
+	if (fsize->index > 0)
+		return -EINVAL;
+
+	if (fsize->code != supported_mode.code)
+		return -EINVAL;
+
+	fsize->min_width = supported_mode.width;
+	fsize->max_width = fsize->min_width;
+	fsize->min_height = supported_mode.height;
+	fsize->max_height = fsize->min_height;
+
+	return 0;
+}
+
+/**
+ * imx682_fill_pad_format() - Fill subdevice pad format
+ *                            from selected sensor mode
+ * @imx682: pointer to imx682 device
+ * @mode: pointer to imx682_mode sensor mode
+ * @fmt: V4L2 sub-device format need to be filled
+ */
+static void imx682_fill_pad_format(struct imx682 *imx682,
+				   const struct imx682_mode *mode,
+				   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+/**
+ * imx682_get_pad_format() - Get subdevice pad format
+ * @sd: pointer to imx682 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx682 *imx682 = to_imx682(sd);
+
+	mutex_lock(&imx682->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		fmt->format = *framefmt;
+	} else {
+		imx682_fill_pad_format(imx682, imx682->cur_mode, fmt);
+	}
+
+	mutex_unlock(&imx682->mutex);
+
+	return 0;
+}
+
+/**
+ * imx682_set_pad_format() - Set subdevice pad format
+ * @sd: pointer to imx682 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx682 *imx682 = to_imx682(sd);
+	const struct imx682_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&imx682->mutex);
+
+	mode = &supported_mode;
+	imx682_fill_pad_format(imx682, mode, fmt);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		*framefmt = fmt->format;
+	} else {
+		ret = imx682_update_controls(imx682, mode);
+		if (!ret)
+			imx682->cur_mode = mode;
+	}
+
+	mutex_unlock(&imx682->mutex);
+
+	return ret;
+}
+
+/**
+ * imx682_init_state() - Initialize sub-device state
+ * @sd: pointer to imx682 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct imx682 *imx682 = to_imx682(sd);
+	struct v4l2_subdev_format fmt = { };
+
+	fmt.which = sd_state ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	imx682_fill_pad_format(imx682, &supported_mode, &fmt);
+
+	return imx682_set_pad_format(sd, sd_state, &fmt);
+}
+
+/**
+ * imx682_start_streaming() - Start sensor stream
+ * @imx682: pointer to imx682 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_start_streaming(struct imx682 *imx682)
+{
+	const struct imx682_reg_list *reg_list;
+	int ret;
+
+	/* Write global settings */
+	ret = imx682_write_regs(imx682, imx682_init_regs,
+				ARRAY_SIZE(imx682_init_regs));
+	if (!ret)
+		ret = imx682_write_regs(imx682, imx682_init_regs2,
+					ARRAY_SIZE(imx682_init_regs2));
+	if (ret) {
+		dev_err(imx682->dev, "fail to write init registers");
+		return ret;
+	}
+
+	/* Write sensor mode registers */
+	reg_list = &imx682->cur_mode->reg_list;
+	ret = imx682_write_regs(imx682, reg_list->regs, reg_list->num_of_regs);
+	if (ret) {
+		dev_err(imx682->dev, "fail to write initial registers");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(imx682->sd.ctrl_handler);
+	if (ret) {
+		dev_err(imx682->dev, "fail to setup handler");
+		return ret;
+	}
+
+	/* Start streaming */
+	ret = imx682_write_reg(imx682, IMX682_REG_MODE_SELECT,
+			       1, IMX682_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx682->dev, "fail to start streaming");
+		return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * imx682_stop_streaming() - Stop sensor stream
+ * @imx682: pointer to imx682 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_stop_streaming(struct imx682 *imx682)
+{
+	return imx682_write_reg(imx682, IMX682_REG_MODE_SELECT,
+				1, IMX682_MODE_STANDBY);
+}
+
+/**
+ * imx682_set_stream() - Enable sensor streaming
+ * @sd: pointer to imx682 subdevice
+ * @enable: set to enable sensor streaming
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx682 *imx682 = to_imx682(sd);
+	int ret;
+
+	mutex_lock(&imx682->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(imx682->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = imx682_start_streaming(imx682);
+		if (ret)
+			goto error_power_off;
+	} else {
+		imx682_stop_streaming(imx682);
+		pm_runtime_put(imx682->dev);
+	}
+
+	mutex_unlock(&imx682->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(imx682->dev);
+error_unlock:
+	mutex_unlock(&imx682->mutex);
+
+	return ret;
+}
+
+/**
+ * imx682_detect() - Detect imx682 sensor
+ * @imx682: pointer to imx682 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+static int imx682_detect(struct imx682 *imx682)
+{
+	int ret;
+	u32 val;
+
+	ret = imx682_read_reg(imx682, IMX682_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != IMX682_ID) {
+		dev_err(imx682->dev, "chip id mismatch: %x!=%x",
+			IMX682_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+/**
+ * imx682_parse_hw_config() - Parse HW configuration and check if supported
+ * @imx682: pointer to imx682 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx682_parse_hw_config(struct imx682 *imx682)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx682->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* Request optional reset pin */
+	imx682->reset_gpio = devm_gpiod_get_optional(imx682->dev, "reset",
+						     GPIOD_OUT_LOW);
+	if (IS_ERR(imx682->reset_gpio)) {
+		dev_err(imx682->dev, "failed to get reset gpio %ld",
+			PTR_ERR(imx682->reset_gpio));
+		return PTR_ERR(imx682->reset_gpio);
+	}
+
+	/* Request optional standby pin */
+	imx682->standby_gpio = devm_gpiod_get_optional(imx682->dev, "standby",
+						       GPIOD_OUT_LOW);
+	if (IS_ERR(imx682->standby_gpio)) {
+		dev_err(imx682->dev, "failed to get standby gpio %ld",
+			PTR_ERR(imx682->standby_gpio));
+		return PTR_ERR(imx682->standby_gpio);
+	}
+
+	/* Get sensor input clock */
+	imx682->inclk = devm_clk_get(imx682->dev, NULL);
+	if (IS_ERR(imx682->inclk)) {
+		dev_err(imx682->dev, "could not get inclk");
+		return PTR_ERR(imx682->inclk);
+	}
+
+	rate = clk_get_rate(imx682->inclk);
+	if (rate != IMX682_INCLK_RATE) {
+		dev_err(imx682->dev, "inclk frequency mismatch");
+		return -EINVAL;
+	}
+
+	/* Get optional DT defined regulators */
+	for (i = 0; i < ARRAY_SIZE(imx682_supply_names); i++)
+		imx682->supplies[i].supply = imx682_supply_names[i];
+
+	ret = devm_regulator_bulk_get(imx682->dev,
+				      ARRAY_SIZE(imx682_supply_names),
+				      imx682->supplies);
+	if (ret)
+		return ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX682_NUM_DATA_LANES) {
+		dev_err(imx682->dev,
+			"number of CSI2 data lanes %d is not supported",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx682->dev, "no link frequencies defined");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == IMX682_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops imx682_video_ops = {
+	.s_stream = imx682_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx682_pad_ops = {
+	.enum_mbus_code = imx682_enum_mbus_code,
+	.enum_frame_size = imx682_enum_frame_size,
+	.get_fmt = imx682_get_pad_format,
+	.set_fmt = imx682_set_pad_format,
+};
+
+static const struct v4l2_subdev_ops imx682_subdev_ops = {
+	.video = &imx682_video_ops,
+	.pad = &imx682_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx682_internal_ops = {
+	.init_state = imx682_init_state,
+};
