+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX682 Camera Sensor Driver
+ *
+ * The register tables and the timing below were taken from the sensor module
+ * data the vendor firmware ships for the Xiaomi POCO X3 NFC (surya), and are
+ * cross-checked against the frame rates that same data declares.
+ */
+#include <linux/unaligned.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Streaming Mode */
+#define IMX682_REG_MODE_SELECT	0x0100
+#define IMX682_MODE_STANDBY	0x00
+#define IMX682_MODE_STREAMING	0x01
+
+/* Lines per frame */
+#define IMX682_REG_LPFR		0x0340
+
+/* Chip ID */
+#define IMX682_REG_ID		0x0016
+#define IMX682_ID		0x0682
+
+/* Exposure control */
+#define IMX682_REG_EXPOSURE_CIT	0x0202
+#define IMX682_EXPOSURE_MIN	9
+#define IMX682_EXPOSURE_OFFSET	22
+#define IMX682_EXPOSURE_STEP	1
+#define IMX682_EXPOSURE_DEFAULT	0x0d98
+
+/*
+ * Analog gain control. The gain is 1024 / (1024 - code), as on other Sony
+ * sensors of this generation; the maximum code is not documented in the data
+ * available for this part, so the same limit as the imx412 is used.
+ */
+#define IMX682_REG_AGAIN	0x0204
+#define IMX682_AGAIN_MIN	0
+#define IMX682_AGAIN_MAX	978
+#define IMX682_AGAIN_STEP	1
+#define IMX682_AGAIN_DEFAULT	0
+
+/* Group hold register */
+#define IMX682_REG_HOLD		0x0104
+
+/* Input clock rate */
+#define IMX682_INCLK_RATE	19200000
+
+/*
+ * CSI2 HW configuration. The sensor is wired with three data lanes on the
+ * board this data comes from: both the vendor's lane assignment and
+ * CSI_LANE_MODE (0x0114 = 0x02) in every one of its mode tables say so.
+ */
+#define IMX682_LINK_FREQ	953600000
+#define IMX682_NUM_DATA_LANES	3
+
+#define IMX682_REG_MIN		0x00
+#define IMX682_REG_MAX		0xffff
+
+/**
+ * struct imx682_reg - imx682 sensor register
+ * @address: Register address
+ * @val: Register value
+ */
+struct imx682_reg {
+	u16 address;
+	u8 val;
+};
+
+/**
+ * struct imx682_reg_list - imx682 sensor register list
+ * @num_of_regs: Number of registers in the list
+ * @regs: Pointer to register list
+ */
+struct imx682_reg_list {
+	u32 num_of_regs;
+	const struct imx682_reg *regs;
+};
+
+/**
+ * struct imx682_mode - imx682 sensor mode structure
+ * @width: Frame width
+ * @height: Frame height
+ * @code: Format code
+ * @hblank: Horizontal blanking in lines
+ * @vblank: Vertical blanking in lines
+ * @vblank_min: Minimum vertical blanking in lines
+ * @vblank_max: Maximum vertical blanking in lines
+ * @pclk: Sensor pixel clock
+ * @link_freq_idx: Link frequency index
+ * @reg_list: Register list for sensor mode
+ */
+struct imx682_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_min;
+	u32 vblank_max;
+	u64 pclk;
+	u32 link_freq_idx;
+	struct imx682_reg_list reg_list;
+};
+
+/*
+ * The boards this sensor is found on bring up a second analogue rail besides
+ * the main one. The downstream kernel labels it "vdig", but it is a 2.8V rail
+ * and the digital core is supplied separately at 1.1V, so it is described here
+ * as what its regulator name says it is.
+ */
+static const char * const imx682_supply_names[] = {
+	"dovdd",	/* Digital I/O power */
+	"avdd",		/* Analog power */
+	"avdd2",	/* Second analogue power */
+	"dvdd",		/* Digital core power */
+};
+
+/**
+ * struct imx682 - imx682 sensor device structure
+ * @dev: Pointer to generic device
+ * @client: Pointer to i2c client
+ * @sd: V4L2 sub-device
+ * @pad: Media pad. Only one pad supported
+ * @reset_gpio: Sensor reset gpio
+ * @standby_gpio: Sensor standby gpio
+ * @inclk: Sensor input clock
+ * @supplies: Regulator supplies
+ * @ctrl_handler: V4L2 control handler
+ * @link_freq_ctrl: Pointer to link frequency control
+ * @pclk_ctrl: Pointer to pixel clock control
+ * @hblank_ctrl: Pointer to horizontal blanking control
+ * @vblank_ctrl: Pointer to vertical blanking control
+ * @exp_ctrl: Pointer to exposure control
+ * @again_ctrl: Pointer to analog gain control
+ * @vblank: Vertical blanking in lines
+ * @cur_mode: Pointer to current selected sensor mode
+ * @mutex: Mutex for serializing sensor controls
+ */
+struct imx682 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *standby_gpio;
+	struct clk *inclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx682_supply_names)];
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq_ctrl;
+	struct v4l2_ctrl *pclk_ctrl;
+	struct v4l2_ctrl *hblank_ctrl;
+	struct v4l2_ctrl *vblank_ctrl;
+	struct {
+		struct v4l2_ctrl *exp_ctrl;
+		struct v4l2_ctrl *again_ctrl;
+	};
+	u32 vblank;
+	const struct imx682_mode *cur_mode;
+	struct mutex mutex;
+};
+
+static const s64 link_freq[] = {
+	IMX682_LINK_FREQ,
+};
