From c542221be0e1b0fd6d6f044e307768ad33467958 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Eduardo=20Garc=C3=ADa-M=C3=A1dico=20Portabella?=
 <woodyst@gmail.com>
Date: Fri, 17 Jul 2026 04:01:00 +0200
Subject: [PATCH 043/106] media: i2c: add Sony IMX682 sensor driver

The IMX682 is a 64MP 1/1.7" Quad-Bayer sensor. Add a driver for it,
supporting the 4624x3472 mode it produces by binning the full 9248x6944
array 2x2, at 30fps over three CSI-2 data lanes.

There is no public documentation for this part. The register tables, the
power sequence, the I2C address and the CSI lane count were taken from
the sensor module data the vendor firmware ships for the board this was
developed on, and cross-checked against it: the PLL dividers in each of
the five mode tables reproduce exactly the frame rates that same data
declares for them (7.47, 30, 60.02, 120.09 and 240.12 fps), and the
window registers decode to the 9248x6944 the sensor is specified for.

The three-lane configuration is unusual for a sensor of this size, but
both the vendor's lane assignment and CSI_LANE_MODE (0x0114 = 0x02) in
every mode table agree on it, and 3 lanes at 1.9Gbps carry the 4.8Gbps
this mode needs.

The analogue gain limit is the one thing not derived from that data: the
gain follows the 1024 / (1024 - code) law of other Sony parts of this
generation, but its maximum code is not stated anywhere available, so
the imx412's is used.

Signed-off-by: Edi <woodyst@gmail.com>
---
 drivers/media/i2c/Kconfig  |   10 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx682.c | 1840 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1851 insertions(+)
 create mode 100644 drivers/media/i2c/imx682.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 21a47fee7..06ec2ac4d 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -276,6 +276,16 @@ config VIDEO_IMX412
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx412.
 
+config VIDEO_IMX682
+	tristate "Sony IMX682 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX682 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx682.
+
 config VIDEO_IMX415
 	tristate "Sony IMX415 sensor support"
 	depends on OF_GPIO
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index ee30edcbf..3e72d3bf1 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -60,6 +60,7 @@ obj-$(CONFIG_VIDEO_IMX334) += imx334.o
 obj-$(CONFIG_VIDEO_IMX335) += imx335.o
 obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
+obj-$(CONFIG_VIDEO_IMX682) += imx682.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
