diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 1f88181b8..1ed0cfc18 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -165,6 +165,53 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_hw_free(substream, &data->stream_prepared[cpu_dai->id]);
 }
 
+/*
+ * SLIMBus backends need the bus channel numbers handed to the DSP before its
+ * port will start - without them the ADSP refuses the port outright. The
+ * codec is the one that knows which channels it listens on, so ask it and
+ * pass the answer along.
+ */
+/* Same bounds the other Qualcomm machine drivers use for these arrays. */
+#define SLIM_MAX_TX_PORTS	16
+#define SLIM_MAX_RX_PORTS	13
+
+static int sm8250_slim_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	u32 rx_ch[SLIM_MAX_RX_PORTS], tx_ch[SLIM_MAX_TX_PORTS];
+	u32 rx_ch_cnt = 0, tx_ch_cnt = 0;
+	int ret, i;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		ret = snd_soc_dai_get_channel_map(codec_dai, &tx_ch_cnt, tx_ch,
+						  &rx_ch_cnt, rx_ch);
+		if (ret == -ENOTSUPP)
+			continue;
+		if (ret)
+			return ret;
+
