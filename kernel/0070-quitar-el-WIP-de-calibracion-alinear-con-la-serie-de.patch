-#define VSS_IMEMORY_CMD_MAP_PHYSICAL	0x00011334
-#define VSS_IMEMORY_RSP_MAP		0x00011336
-#define VSS_IMEMORY_CMD_UNMAP		0x00011337
-
-/*
- * A single memory block descriptor table, matching struct
- * vss_imemory_table_t from the downstream driver: a "next table" pointer
- * (unused here, always the single block) followed by one block descriptor.
- * The DSP reads this table by physical address, not the memory it points
- * at, so it needs its own tiny DMA allocation separate from the actual
- * calibration buffer.
- */
-struct q6mvm_memory_table {
-	__le32 next_table_lsw;
-	__le32 next_table_msw;
-	__le32 next_table_size;
-	__le32 block_addr_lsw;
-	__le32 block_addr_msw;
-	__le32 block_size;
-} __packed;
-
-struct vss_imemory_cmd_map_physical_t {
-	struct apr_hdr hdr;
-	u32 table_addr_lsw;
-	u32 table_addr_msw;
-	u32 table_size;
-	u8 is_cached;
-	u16 cache_line_size;
-	u32 access_mask;
-	u32 page_align;
-	u8 min_data_width;
-	u8 max_data_width;
-} __packed;
-
-struct vss_imemory_cmd_unmap_t {
-	struct apr_hdr hdr;
-	u32 mem_handle;
-} __packed;
-
-int q6mvm_map_memory(struct q6voice_session *mvm, struct device *table_dev,
-		     dma_addr_t phys, size_t size, u32 *mem_handle)
-{
-	struct vss_imemory_cmd_map_physical_t cmd;
-	struct q6mvm_memory_table *table;
-	dma_addr_t table_phys;
-	u32 resp[4];
-	int ret;
-
-	/*
-	 * table_dev, not mvm->dev: mvm->dev is a raw apr_device that never
-	 * goes through of_dma_configure() and rejects a dma_mask outright on
-	 * this platform (see q6mvm_probe()). table_dev is expected to be a
-	 * normal OF platform device (q6voice's own) that already has one.
-	 *
-	 * Allocating a full page rather than just sizeof(*table): the
-	 * downstream comment on vss_imemory_table_descriptor_t requires the
-	 * table address be aligned to LCM(cache_line_size, page_align,
-	 * max_data_width) = 4096 here, which dma_alloc_coherent() only
-	 * guarantees for page-sized-or-larger requests, not for a 24-byte
-	 * one. VSS_IMEMORY_CMD_MAP_PHYSICAL failing with error 2 (bad
-	 * param, no crash) after fixing is_cached is consistent with this.
-	 */
-	table = dma_alloc_coherent(table_dev, PAGE_SIZE, &table_phys, GFP_KERNEL);
-	if (!table)
-		return -ENOMEM;
-
-	table->next_table_lsw = 0;
-	table->next_table_msw = 0;
-	table->next_table_size = 0;
-	table->block_addr_lsw = cpu_to_le32(lower_32_bits(phys));
-	table->block_addr_msw = cpu_to_le32(upper_32_bits(phys));
-	table->block_size = cpu_to_le32(size);
-
-	cmd.hdr.pkt_size = sizeof(cmd);
-	cmd.hdr.opcode = VSS_IMEMORY_CMD_MAP_PHYSICAL;
-
-	cmd.table_addr_lsw = lower_32_bits(table_phys);
-	cmd.table_addr_msw = upper_32_bits(table_phys);
-	cmd.table_size = sizeof(*table);
-	/*
-	 * The downstream driver hardcodes is_cached=1 to match its ion
-	 * allocation, which is genuinely CPU-cached and relies on explicit
-	 * cache maintenance around access. dma_alloc_coherent() gives us
-	 * memory that's coherent/non-cached from the CPU's side instead -
-	 * claiming is_cached=1 here would tell the DSP to apply its own
-	 * cache-line coherency handling to a region that was never mapped
-	 * that way, a plausible cause of the hard ADSP crash seen when this
-	 * was first tried with is_cached=1.
-	 */
-	cmd.is_cached = 0;
-	cmd.cache_line_size = 128;
-	cmd.access_mask = 3; /* readable | writable */
-	cmd.page_align = 4096;
-	cmd.min_data_width = 8;
-	cmd.max_data_width = 64;
-
-	ret = q6voice_common_send_resp(mvm, &cmd.hdr, VSS_IMEMORY_RSP_MAP,
-					resp, ARRAY_SIZE(resp));
-	dma_free_coherent(table_dev, PAGE_SIZE, table, table_phys);
-	if (ret)
-		return ret;
-
-	if (!resp[0])
-		return -EIO;
-
-	*mem_handle = resp[0];
-	return 0;
-}
-EXPORT_SYMBOL_GPL(q6mvm_map_memory);
-
-int q6mvm_unmap_memory(struct q6voice_session *mvm, u32 mem_handle)
-{
-	struct vss_imemory_cmd_unmap_t cmd;
-
-	cmd.hdr.pkt_size = sizeof(cmd);
-	cmd.hdr.opcode = VSS_IMEMORY_CMD_UNMAP;
-	cmd.mem_handle = mem_handle;
-
-	return q6voice_common_send(mvm, &cmd.hdr);
-}
-EXPORT_SYMBOL_GPL(q6mvm_unmap_memory);
-
 static int q6mvm_probe(struct apr_device *adev)
 {
 	int ret;
@@ -256,25 +132,6 @@ static int q6mvm_probe(struct apr_device *adev)
 	if (ret)
 		return ret;
 
-	/*
-	 * apr_device instances aren't created through the normal OF platform
-	 * bus (of_platform_populate() below is for the MVM's own children,
-	 * not this device itself), so nothing has called of_dma_configure()
-	 * on it and dev->dma_mask is NULL. q6mvm_map_memory() needs to
-	 * dma_alloc_coherent() a small calibration buffer through this
-	 * device - without this it hits dma_alloc_attrs()'s "device has no
-	 * dma_mask" WARN and silently gets back an unusable allocation.
-	 *
-	 * This must not be fatal to probe: dma_set_mask_and_coherent()
-	 * failing here (seen returning -EIO on this device) previously took
-	 * the whole q6mvm driver down with it, which cascades into q6voice
-	 * failing to bind and the entire sound card disappearing - a much
-	 * worse regression than the DMA warning this was meant to silence.
-	 */
-	ret = dma_set_mask_and_coherent(&adev->dev, DMA_BIT_MASK(32));
-	if (ret)
-		dev_warn(&adev->dev, "failed to set dma mask: %d (vol cal loading will not work)\n", ret);
-
 	return of_platform_populate(adev->dev.of_node, NULL, NULL, &adev->dev);
 }
 
