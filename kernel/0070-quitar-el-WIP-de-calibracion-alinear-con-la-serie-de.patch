@@ -62,87 +44,6 @@ struct q6voice {
 	struct q6voice_path paths[Q6VOICE_PATH_COUNT];
 };
 
-/*
- * Loads the captured RX volume calibration table and registers it with the
- * DSP for this path's vocproc, so VSS_IVOLUME_CMD_SET_STEP (q6cvp_set_rx_
- * volume) has a table to resolve a step against instead of failing with
- * ADSP_EFAILED on every uncalibrated profile. Best-effort like the volume/
- * mute calls right after it: a missing or rejected firmware file just means
- * the volume step keeps failing exactly like before, it doesn't block the
- * call from continuing silently-uncalibrated as it already did.
- */
-static int q6voice_load_vol_cal(struct q6voice_path *p, struct q6voice_session *mvm,
-				 struct q6voice_session *cvp)
-{
-	struct q6voice_path_runtime *rt = p->runtime;
-	struct device *dev = p->v->dev;
-	const struct firmware *fw;
-	int ret;
-
-	ret = request_firmware(&fw, VOL_CAL_FIRMWARE, dev);
-	if (ret)
-		return ret;
-
-	/*
-	 * dev (the q6voice-dais platform device) rather than mvm->dev: the
-	 * latter is a raw apr_device that never goes through of_dma_configure()
-	 * and, on this platform, outright rejects dma_set_mask_and_coherent()
-	 * (-EIO) - confirmed on real hardware, see q6mvm_probe(). dev is a
-	 * normal OF platform device and should have a working dma_mask by
-	 * the usual driver-core default.
-	 */
-	/*
-	 * Round the allocation up to a whole page: VSS_IMEMORY_CMD_MAP_PHYSICAL
-	 * requires the mapped address be aligned to page_align (4096 here),
-	 * which dma_alloc_coherent() only guarantees for page-sized-or-larger
-	 * requests. vol_cal_size stays the firmware's real size - that's what
-	 * gets reported to the DSP - only the allocation itself is padded.
-	 */
-	rt->vol_cal_size = fw->size;
-	rt->vol_cal_cpu = dma_alloc_coherent(dev, PAGE_ALIGN(fw->size), &rt->vol_cal_dma,
-					     GFP_KERNEL);
-	if (!rt->vol_cal_cpu) {
-		release_firmware(fw);
-		return -ENOMEM;
-	}
-	memcpy(rt->vol_cal_cpu, fw->data, fw->size);
-	release_firmware(fw);
-
-	ret = q6mvm_map_memory(mvm, dev, rt->vol_cal_dma, rt->vol_cal_size,
-			       &rt->vol_cal_mem_handle);
-	if (ret)
-		goto free_dma;
-
-	ret = q6cvp_register_vol_cal(cvp, rt->vol_cal_mem_handle,
-				     rt->vol_cal_dma, rt->vol_cal_size);
-	if (ret)
-		goto unmap;
-
-	return 0;
-
-unmap:
-	q6mvm_unmap_memory(mvm, rt->vol_cal_mem_handle);
-	rt->vol_cal_mem_handle = 0;
-free_dma:
-	dma_free_coherent(dev, PAGE_ALIGN(rt->vol_cal_size), rt->vol_cal_cpu, rt->vol_cal_dma);
-	rt->vol_cal_cpu = NULL;
-	return ret;
-}
