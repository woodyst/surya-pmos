Date: Sat, 1 Aug 2026 22:08:02 +0200
Subject: [PATCH 074/106] q6voice+q6routing: disparo de grabacion en llamada
 desde la ruta del mezclador, fiel al vendor

---
 sound/soc/qcom/qdsp6/q6routing.c | 14 +++++++
 sound/soc/qcom/qdsp6/q6voice.c   | 70 ++++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.h   |  1 +
 3 files changed, 85 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6routing.c b/sound/soc/qcom/qdsp6/q6routing.c
index fea2e02d3..3db7e2367 100644
--- a/sound/soc/qcom/qdsp6/q6routing.c
+++ b/sound/soc/qcom/qdsp6/q6routing.c
@@ -23,6 +23,7 @@
 #include "q6asm.h"
 #include "q6adm.h"
 #include "q6routing.h"
+#include "q6voice.h"
 
 #define DRV_NAME "q6routing-component"
 
@@ -515,12 +516,25 @@ static int msm_routing_put_audio_mixer(struct snd_kcontrol *kcontrol,
 
 		session->port_id = be_id;
 		snd_soc_dapm_mixer_update_power(dapm, kcontrol, 1, update);
+
+		/*
+		 * Routing a record port is what asks the voice stream for its
+		 * copy of the call - the vendor stack triggers it from here
+		 * too, with the direction implied by which port got routed.
+		 */
+		if (be_id == VOICE_RECORD_RX || be_id == VOICE_RECORD_TX)
+			q6voice_incall_record_route(be_id == VOICE_RECORD_TX,
+						    true);
 	} else {
 		if (session->port_id == -1 || session->port_id != be_id)
 			return 0;
 
 		session->port_id = -1;
 		snd_soc_dapm_mixer_update_power(dapm, kcontrol, 0, update);
+
+		if (be_id == VOICE_RECORD_RX || be_id == VOICE_RECORD_TX)
+			q6voice_incall_record_route(be_id == VOICE_RECORD_TX,
+						    false);
 	}
 
 	return 1;
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index bf87c1b57..0ad316e5e 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -74,6 +74,76 @@ MODULE_PARM_DESC(incall_taps, "copy call audio to the record/playback pseudo por
  */
 static int record_dirs = 1;	/* downlink only by default: the safe one */
 
+/*
+ * Vendor-faithful in-call record trigger, called from the routing driver
+ * when the mixer route to a record port is toggled. Which direction gets
+ * tapped follows from WHICH port is routed - downlink for VOICE_RECORD_RX,
+ * uplink for VOICE_RECORD_TX, both when both are - with the same flag
+ * machine the vendor stack keeps per session (voc_start_record()).
+ */
+static struct {
+	bool ul, dl;
+} q6voice_rec_state;
+
+int q6voice_incall_record_route(bool tx_port, bool set)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	struct q6voice_session *cvs;
+	int ret = 0, i;
+
+	if (!v)
+		return 0;	/* no voice driver, nothing to do */
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (!p->runtime || !p->runtime->sessions[Q6VOICE_SERVICE_CVS]) {
+			mutex_unlock(&p->lock);
+			continue;
+		}
+		cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+		if (set) {
+			if (q6voice_rec_state.ul && q6voice_rec_state.dl) {
+				mutex_unlock(&p->lock);
+				continue;	/* already recording both */
+			}
+			if (tx_port)
+				q6voice_rec_state.ul = true;
+			else
+				q6voice_rec_state.dl = true;
+			/* going from one direction to both needs a restart */
+			if (q6voice_rec_state.ul && q6voice_rec_state.dl)
+				q6cvs_stop_record(cvs);
+		} else {
+			if (!q6voice_rec_state.ul && !q6voice_rec_state.dl) {
+				mutex_unlock(&p->lock);
+				continue;	/* nothing running */
+			}
+			if (tx_port)
+				q6voice_rec_state.ul = false;
+			else
+				q6voice_rec_state.dl = false;
+			q6cvs_stop_record(cvs);
+		}
+
+		if (q6voice_rec_state.ul || q6voice_rec_state.dl)
+			ret = q6cvs_start_record(cvs, q6voice_rec_state.dl,
+						 q6voice_rec_state.ul);
+		dev_info(v->dev,
+			 "in-call record route %s %s -> taps dl=%d ul=%d: %d\n",
+			 tx_port ? "uplink" : "downlink", set ? "on" : "off",
+			 q6voice_rec_state.dl, q6voice_rec_state.ul, ret);
+		mutex_unlock(&p->lock);
+		return ret;
+	}
+
+	/* no active call: remember nothing, the route alone is harmless */
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_incall_record_route);
+
 static int q6voice_record_now_set(const char *val, const struct kernel_param *kp)
 {
 	struct q6voice *v = q6voice_live;
diff --git a/sound/soc/qcom/qdsp6/q6voice.h b/sound/soc/qcom/qdsp6/q6voice.h
index 5b2d2dd67..e868e6b5e 100644
--- a/sound/soc/qcom/qdsp6/q6voice.h
+++ b/sound/soc/qcom/qdsp6/q6voice.h
@@ -20,6 +20,7 @@ struct q6voice *q6voice_create(struct device *dev);
 int q6voice_start(struct q6voice *v, enum q6voice_path_type path, bool capture);
 int q6voice_stop(struct q6voice *v, enum q6voice_path_type path, bool capture);
 
+int q6voice_incall_record_route(bool tx_port, bool set);
 int q6voice_get_port(struct q6voice *v, enum q6voice_path_type path,
 		     bool capture);
 void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
