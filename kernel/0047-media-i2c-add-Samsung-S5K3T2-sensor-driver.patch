+/**
+ * s5k3t2_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	int ret;
+
+	/*
+	 * Follow the vendor's power up sequence: point the mux at this sensor,
+	 * hold it in reset while the supplies and the input clock come up, and
+	 * release it last.
+	 */
+	gpiod_set_value_cansleep(s5k3t2->select_gpio, 0);
+	usleep_range(1000, 1200);
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s5k3t2_supply_names),
+				    s5k3t2->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators\n");
+		return ret;
+	}
+
+	usleep_range(2000, 2400);
+
+	ret = clk_prepare_enable(s5k3t2->inclk);
+	if (ret) {
+		dev_err(s5k3t2->dev, "fail to enable inclk");
+		goto error_reset;
+	}
+
+	usleep_range(15000, 16000);
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 0);
+
+	usleep_range(5000, 5500);
+
+	return 0;
+
+error_reset:
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(s5k3t2_supply_names),
+			       s5k3t2->supplies);
+
+	return ret;
+}
+
+/**
+ * s5k3t2_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 1);
+	usleep_range(1000, 1200);
+	clk_disable_unprepare(s5k3t2->inclk);
+	usleep_range(1000, 1200);
+	regulator_bulk_disable(ARRAY_SIZE(s5k3t2_supply_names),
+			       s5k3t2->supplies);
+	gpiod_set_value_cansleep(s5k3t2->select_gpio, 1);
+
+	return 0;
+}
+
+/**
+ * s5k3t2_init_controls() - Initialize sensor subdevice controls
+ * @s5k3t2: pointer to s5k3t2 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_init_controls(struct s5k3t2 *s5k3t2)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k3t2->ctrl_handler;
+	const struct s5k3t2_mode *mode = s5k3t2->cur_mode;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 6);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &s5k3t2->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	s5k3t2->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &s5k3t2_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3T2_EXPOSURE_MIN,
+					     lpfr - S5K3T2_EXPOSURE_OFFSET,
+					     S5K3T2_EXPOSURE_STEP,
+					     S5K3T2_EXPOSURE_DEFAULT);
+
+	s5k3t2->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &s5k3t2_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       S5K3T2_AGAIN_MIN,
+					       S5K3T2_AGAIN_MAX,
+					       S5K3T2_AGAIN_STEP,
+					       S5K3T2_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &s5k3t2->exp_ctrl);
+
+	s5k3t2->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&s5k3t2_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	s5k3t2->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &s5k3t2_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	s5k3t2->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&s5k3t2_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (s5k3t2->link_freq_ctrl)
+		s5k3t2->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k3t2->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&s5k3t2_ctrl_ops,
+						V4L2_CID_HBLANK,
+						S5K3T2_REG_MIN,
+						S5K3T2_REG_MAX,
+						1, mode->hblank);
+	if (s5k3t2->hblank_ctrl)
+		s5k3t2->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	if (ctrl_hdlr->error) {
+		dev_err(s5k3t2->dev, "control init failed: %d",
+			ctrl_hdlr->error);
+		v4l2_ctrl_handler_free(ctrl_hdlr);
+		return ctrl_hdlr->error;
+	}
+
+	s5k3t2->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+}
+
+/**
+ * s5k3t2_probe() - I2C client device binding
+ * @client: pointer to i2c client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_probe(struct i2c_client *client)
+{
+	struct s5k3t2 *s5k3t2;
+	int ret;
+
+	s5k3t2 = devm_kzalloc(&client->dev, sizeof(*s5k3t2), GFP_KERNEL);
+	if (!s5k3t2)
+		return -ENOMEM;
+
+	s5k3t2->dev = &client->dev;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&s5k3t2->sd, client, &s5k3t2_subdev_ops);
+	s5k3t2->sd.internal_ops = &s5k3t2_internal_ops;
+
+	ret = s5k3t2_parse_hw_config(s5k3t2);
+	if (ret) {
+		dev_err(s5k3t2->dev, "HW configuration is not supported");
+		return ret;
+	}
+
+	mutex_init(&s5k3t2->mutex);
+
+	ret = s5k3t2_power_on(s5k3t2->dev);
+	if (ret) {
+		dev_err(s5k3t2->dev, "failed to power-on the sensor");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = s5k3t2_detect(s5k3t2);
+	if (ret) {
+		dev_err(s5k3t2->dev, "failed to find sensor: %d", ret);
+		goto error_power_off;
+	}
+
+	/* Set default mode to max resolution */
+	s5k3t2->cur_mode = &supported_mode;
+	s5k3t2->vblank = s5k3t2->cur_mode->vblank;
+
+	ret = s5k3t2_init_controls(s5k3t2);
+	if (ret) {
+		dev_err(s5k3t2->dev, "failed to init controls: %d", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	s5k3t2->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3t2->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	/* Initialize source pad */
+	s5k3t2->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s5k3t2->sd.entity, 1, &s5k3t2->pad);
+	if (ret) {
+		dev_err(s5k3t2->dev, "failed to init entity pads: %d", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3t2->sd);
+	if (ret < 0) {
+		dev_err(s5k3t2->dev,
+			"failed to register async subdev: %d", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(s5k3t2->dev);
+	pm_runtime_enable(s5k3t2->dev);
+	pm_runtime_idle(s5k3t2->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&s5k3t2->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(s5k3t2->sd.ctrl_handler);
+error_power_off:
+	s5k3t2_power_off(s5k3t2->dev);
+error_mutex_destroy:
+	mutex_destroy(&s5k3t2->mutex);
+
+	return ret;
+}
+
+/**
+ * s5k3t2_remove() - I2C client device unbinding
+ * @client: pointer to I2C client device
+ */
+static void s5k3t2_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		s5k3t2_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&s5k3t2->mutex);
+}
+
+static const struct dev_pm_ops s5k3t2_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k3t2_power_off, s5k3t2_power_on, NULL)
+};
+
+static const struct of_device_id s5k3t2_of_match[] = {
+	{ .compatible = "samsung,s5k3t2" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, s5k3t2_of_match);
+
+static struct i2c_driver s5k3t2_driver = {
+	.probe = s5k3t2_probe,
+	.remove = s5k3t2_remove,
+	.driver = {
+		.name = "s5k3t2",
+		.pm = &s5k3t2_pm_ops,
+		.of_match_table = s5k3t2_of_match,
+	},
+};
+
+module_i2c_driver(s5k3t2_driver);
+
+MODULE_DESCRIPTION("Samsung s5k3t2 sensor driver");
+MODULE_LICENSE("GPL");
