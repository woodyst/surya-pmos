+/*
+ * The vendor data declares this mode at 29.90fps, and the mode's own PLL
+ * reproduces that exactly: 19.2MHz / 3 (0x0304) * 185 (0x0306) / (1 (0x0302) *
+ * 7 (0x0300)) is 169.14MHz, four pixels a clock is 676.57MHz, and over the
+ * 5440 (0x0342) by 4160 (0x0340) frame that is 29.90fps.
+ */
+static const struct s5k3t2_mode supported_mode = {
+	.width = 5184,
+	.height = 3880,
+	.hblank = 256,
+	.vblank = 280,
+	.vblank_min = 280,
+	.vblank_max = 61375,
+	.pclk = 676571428,
+	.link_freq_idx = 0,
+	/* Not confirmed: the vendor data does not carry the Bayer order. */
+	.code = MEDIA_BUS_FMT_SGRBG10_1X10,
+	.reg_list = {
+		.num_of_regs = ARRAY_SIZE(mode_5184x3880_regs),
+		.regs = mode_5184x3880_regs,
+	},
+};
+
+static inline struct s5k3t2 *to_s5k3t2(struct v4l2_subdev *subdev)
+{
+	return container_of(subdev, struct s5k3t2, sd);
+}
+
+/**
+ * s5k3t2_read_reg() - Read registers.
+ * @s5k3t2: pointer to s5k3t2 device
+ * @reg: register address
+ * @len: length of bytes to read. Max supported bytes is 4
+ * @val: pointer to register value to be filled.
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_read_reg(struct s5k3t2 *s5k3t2, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&s5k3t2->sd);
+	struct i2c_msg msgs[2] = { };
+	u8 addr_buf[2] = { };
+	u8 data_buf[4] = { };
+	int ret;
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = ARRAY_SIZE(addr_buf);
+	msgs[0].buf = addr_buf;
+
+	/* Read data from register */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+/**
+ * s5k3t2_write_reg() - Write register
+ * @s5k3t2: pointer to s5k3t2 device
+ * @reg: register address
+ * @len: length of bytes. Max supported bytes is 4
+ * @val: register value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_write_reg(struct s5k3t2 *s5k3t2, u16 reg, u32 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&s5k3t2->sd);
+	u8 buf[6] = { };
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << (8 * (4 - len)), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+/**
+ * s5k3t2_write_regs() - Write a list of registers
+ * @s5k3t2: pointer to s5k3t2 device
+ * @regs: list of registers to be written
+ * @len: length of registers array
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_write_regs(struct s5k3t2 *s5k3t2,
+			     const struct s5k3t2_reg *regs, u32 len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = s5k3t2_write_reg(s5k3t2, regs[i].address, 2, regs[i].val);
+		if (ret)
+			return ret;
+
+		/* The soft reset is the only entry the vendor data delays on */
+		if (regs[i].address == 0x6010)
+			fsleep(S5K3T2_RESET_DELAY_US);
+	}
+
+	return 0;
+}
+
+/**
+ * s5k3t2_update_controls() - Update control ranges based on streaming mode
+ * @s5k3t2: pointer to s5k3t2 device
+ * @mode: pointer to s5k3t2_mode sensor mode
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_update_controls(struct s5k3t2 *s5k3t2,
+				  const struct s5k3t2_mode *mode)
+{
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k3t2->link_freq_ctrl, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k3t2->hblank_ctrl, mode->hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(s5k3t2->vblank_ctrl, mode->vblank_min,
+					mode->vblank_max, 1, mode->vblank);
+}
+
+/**
+ * s5k3t2_update_exp_gain() - Set updated exposure and gain
+ * @s5k3t2: pointer to s5k3t2 device
+ * @exposure: updated exposure value
+ * @gain: updated analog gain value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_update_exp_gain(struct s5k3t2 *s5k3t2, u32 exposure, u32 gain)
+{
+	u32 lpfr;
+	int ret;
+
+	lpfr = s5k3t2->vblank + s5k3t2->cur_mode->height;
+
+	dev_dbg(s5k3t2->dev, "Set exp %u, analog gain %u, lpfr %u",
+		exposure, gain, lpfr);
+
+	ret = s5k3t2_write_reg(s5k3t2, S5K3T2_REG_HOLD, 1, 1);
+	if (ret)
+		return ret;
+
+	ret = s5k3t2_write_reg(s5k3t2, S5K3T2_REG_LPFR, 2, lpfr);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = s5k3t2_write_reg(s5k3t2, S5K3T2_REG_EXPOSURE_CIT, 2, exposure);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = s5k3t2_write_reg(s5k3t2, S5K3T2_REG_AGAIN, 2, gain);
+
+error_release_group_hold:
+	s5k3t2_write_reg(s5k3t2, S5K3T2_REG_HOLD, 1, 0);
+
+	return ret;
+}
+
+/**
+ * s5k3t2_set_ctrl() - Set subdevice control
+ * @ctrl: pointer to v4l2_ctrl structure
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3t2 *s5k3t2 =
+		container_of(ctrl->handler, struct s5k3t2, ctrl_handler);
+	u32 analog_gain;
+	u32 exposure;
+	int ret;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		s5k3t2->vblank = s5k3t2->vblank_ctrl->val;
+
+		dev_dbg(s5k3t2->dev, "Received vblank %u, new lpfr %u",
+			s5k3t2->vblank,
+			s5k3t2->vblank + s5k3t2->cur_mode->height);
+
+		ret = __v4l2_ctrl_modify_range(s5k3t2->exp_ctrl,
+					       S5K3T2_EXPOSURE_MIN,
+					       s5k3t2->vblank +
+					       s5k3t2->cur_mode->height -
+					       S5K3T2_EXPOSURE_OFFSET,
+					       1, S5K3T2_EXPOSURE_DEFAULT);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* Set controls only if sensor is in power on state */
+		if (!pm_runtime_get_if_in_use(s5k3t2->dev))
+			return 0;
+
+		exposure = ctrl->val;
+		analog_gain = s5k3t2->again_ctrl->val;
+
+		dev_dbg(s5k3t2->dev, "Received exp %u, analog gain %u",
+			exposure, analog_gain);
+
+		ret = s5k3t2_update_exp_gain(s5k3t2, exposure, analog_gain);
+
+		pm_runtime_put(s5k3t2->dev);
+
+		break;
+	default:
+		dev_err(s5k3t2->dev, "Invalid control %d", ctrl->id);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+/* v4l2_ctrl_ops */
+static const struct v4l2_ctrl_ops s5k3t2_ctrl_ops = {
+	.s_ctrl = s5k3t2_set_ctrl,
+};
+
+/**
+ * s5k3t2_enum_mbus_code() - Enumerate V4L2 sub-device mbus codes
+ * @sd: pointer to s5k3t2 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @code: V4L2 sub-device code enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_mode.code;
+
+	return 0;
+}
+
+/**
+ * s5k3t2_enum_frame_size() - Enumerate V4L2 sub-device frame sizes
+ * @sd: pointer to s5k3t2 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fsize: V4L2 sub-device size enumeration need to be filled
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fsize)
+{
+	if (fsize->index > 0)
+		return -EINVAL;
+
+	if (fsize->code != supported_mode.code)
+		return -EINVAL;
+
+	fsize->min_width = supported_mode.width;
+	fsize->max_width = fsize->min_width;
+	fsize->min_height = supported_mode.height;
+	fsize->max_height = fsize->min_height;
+
+	return 0;
+}
+
+/**
+ * s5k3t2_fill_pad_format() - Fill subdevice pad format
+ *                            from selected sensor mode
+ * @s5k3t2: pointer to s5k3t2 device
+ * @mode: pointer to s5k3t2_mode sensor mode
+ * @fmt: V4L2 sub-device format need to be filled
+ */
+static void s5k3t2_fill_pad_format(struct s5k3t2 *s5k3t2,
+				   const struct s5k3t2_mode *mode,
+				   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+/**
+ * s5k3t2_get_pad_format() - Get subdevice pad format
+ * @sd: pointer to s5k3t2 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+
+	mutex_lock(&s5k3t2->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		fmt->format = *framefmt;
+	} else {
+		s5k3t2_fill_pad_format(s5k3t2, s5k3t2->cur_mode, fmt);
+	}
+
+	mutex_unlock(&s5k3t2->mutex);
+
+	return 0;
+}
+
+/**
+ * s5k3t2_set_pad_format() - Set subdevice pad format
+ * @sd: pointer to s5k3t2 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ * @fmt: V4L2 sub-device format need to be set
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	const struct s5k3t2_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&s5k3t2->mutex);
+
+	mode = &supported_mode;
+	s5k3t2_fill_pad_format(s5k3t2, mode, fmt);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		*framefmt = fmt->format;
+	} else {
+		ret = s5k3t2_update_controls(s5k3t2, mode);
+		if (!ret)
+			s5k3t2->cur_mode = mode;
+	}
+
+	mutex_unlock(&s5k3t2->mutex);
+
+	return ret;
+}
+
+/**
+ * s5k3t2_init_state() - Initialize sub-device state
+ * @sd: pointer to s5k3t2 V4L2 sub-device structure
+ * @sd_state: V4L2 sub-device configuration
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	struct v4l2_subdev_format fmt = { };
+
+	fmt.which = sd_state ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	s5k3t2_fill_pad_format(s5k3t2, &supported_mode, &fmt);
+
+	return s5k3t2_set_pad_format(sd, sd_state, &fmt);
+}
+
+/**
+ * s5k3t2_start_streaming() - Start sensor stream
+ * @s5k3t2: pointer to s5k3t2 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_start_streaming(struct s5k3t2 *s5k3t2)
+{
+	const struct s5k3t2_reg_list *reg_list;
+	int ret;
+
+	/* Write global settings */
+	ret = s5k3t2_write_regs(s5k3t2, s5k3t2_init_regs,
+				ARRAY_SIZE(s5k3t2_init_regs));
+	if (ret) {
+		dev_err(s5k3t2->dev, "fail to write init registers");
+		return ret;
+	}
+
+	/* Write sensor mode registers */
+	reg_list = &s5k3t2->cur_mode->reg_list;
+	ret = s5k3t2_write_regs(s5k3t2, reg_list->regs, reg_list->num_of_regs);
+	if (ret) {
+		dev_err(s5k3t2->dev, "fail to write initial registers");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(s5k3t2->sd.ctrl_handler);
+	if (ret) {
+		dev_err(s5k3t2->dev, "fail to setup handler");
+		return ret;
+	}
+
+	/* Start streaming */
+	ret = s5k3t2_write_reg(s5k3t2, S5K3T2_REG_MODE_SELECT,
+			       1, S5K3T2_MODE_STREAMING);
+	if (ret) {
+		dev_err(s5k3t2->dev, "fail to start streaming");
+		return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * s5k3t2_stop_streaming() - Stop sensor stream
+ * @s5k3t2: pointer to s5k3t2 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_stop_streaming(struct s5k3t2 *s5k3t2)
+{
+	return s5k3t2_write_reg(s5k3t2, S5K3T2_REG_MODE_SELECT,
+				1, S5K3T2_MODE_STANDBY);
+}
+
+/**
+ * s5k3t2_set_stream() - Enable sensor streaming
+ * @sd: pointer to s5k3t2 subdevice
+ * @enable: set to enable sensor streaming
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	int ret;
+
+	mutex_lock(&s5k3t2->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(s5k3t2->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = s5k3t2_start_streaming(s5k3t2);
+		if (ret)
+			goto error_power_off;
+	} else {
+		s5k3t2_stop_streaming(s5k3t2);
+		pm_runtime_put(s5k3t2->dev);
+	}
+
+	mutex_unlock(&s5k3t2->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(s5k3t2->dev);
+error_unlock:
+	mutex_unlock(&s5k3t2->mutex);
+
+	return ret;
+}
+
+/**
+ * s5k3t2_detect() - Detect s5k3t2 sensor
+ * @s5k3t2: pointer to s5k3t2 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+static int s5k3t2_detect(struct s5k3t2 *s5k3t2)
+{
+	int ret;
+	u32 val;
+
+	ret = s5k3t2_read_reg(s5k3t2, S5K3T2_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != S5K3T2_ID) {
+		dev_err(s5k3t2->dev, "chip id mismatch: %x!=%x",
+			S5K3T2_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+/**
+ * s5k3t2_parse_hw_config() - Parse HW configuration and check if supported
+ * @s5k3t2: pointer to s5k3t2 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int s5k3t2_parse_hw_config(struct s5k3t2 *s5k3t2)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3t2->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* Request optional reset pin */
+	s5k3t2->reset_gpio = devm_gpiod_get_optional(s5k3t2->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3t2->reset_gpio)) {
+		dev_err(s5k3t2->dev, "failed to get reset gpio %ld",
+			PTR_ERR(s5k3t2->reset_gpio));
+		return PTR_ERR(s5k3t2->reset_gpio);
+	}
+
+	/*
+	 * The board muxes this sensor and the ultrawide one onto the same
+	 * CSIPHY; this pin picks which of the two drives it. Deasserted picks
+	 * this sensor, as the vendor's power up sequence does.
+	 */
+	s5k3t2->select_gpio = devm_gpiod_get_optional(s5k3t2->dev, "select",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3t2->select_gpio)) {
+		dev_err(s5k3t2->dev, "failed to get select gpio %ld",
+			PTR_ERR(s5k3t2->select_gpio));
+		return PTR_ERR(s5k3t2->select_gpio);
+	}
+
+	/* Get sensor input clock */
+	s5k3t2->inclk = devm_clk_get(s5k3t2->dev, NULL);
+	if (IS_ERR(s5k3t2->inclk)) {
+		dev_err(s5k3t2->dev, "could not get inclk");
+		return PTR_ERR(s5k3t2->inclk);
+	}
+
+	rate = clk_get_rate(s5k3t2->inclk);
+	if (rate != S5K3T2_INCLK_RATE) {
+		dev_err(s5k3t2->dev, "inclk frequency mismatch");
+		return -EINVAL;
+	}
+
+	/* Get DT defined regulators */
+	for (i = 0; i < ARRAY_SIZE(s5k3t2_supply_names); i++)
+		s5k3t2->supplies[i].supply = s5k3t2_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3t2->dev,
+				      ARRAY_SIZE(s5k3t2_supply_names),
+				      s5k3t2->supplies);
+	if (ret)
+		return ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3T2_NUM_DATA_LANES) {
+		dev_err(s5k3t2->dev,
+			"number of CSI2 data lanes %d is not supported",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(s5k3t2->dev, "no link frequencies defined");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == S5K3T2_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops s5k3t2_video_ops = {
+	.s_stream = s5k3t2_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3t2_pad_ops = {
+	.enum_mbus_code = s5k3t2_enum_mbus_code,
+	.enum_frame_size = s5k3t2_enum_frame_size,
+	.get_fmt = s5k3t2_get_pad_format,
+	.set_fmt = s5k3t2_set_pad_format,
+};
+
+static const struct v4l2_subdev_ops s5k3t2_subdev_ops = {
+	.video = &s5k3t2_video_ops,
+	.pad = &s5k3t2_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3t2_internal_ops = {
+	.init_state = s5k3t2_init_state,
+};
