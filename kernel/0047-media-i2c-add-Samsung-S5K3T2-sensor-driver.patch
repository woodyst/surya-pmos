From 8a80156b3416280f8d3af728eb7237320f783ea8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Eduardo=20Garc=C3=ADa-M=C3=A1dico=20Portabella?=
 <woodyst@gmail.com>
Date: Fri, 17 Jul 2026 10:23:15 +0200
Subject: [PATCH 047/106] media: i2c: add Samsung S5K3T2 sensor driver

The 20MP front sensor of the Xiaomi POCO X3 NFC (surya). There is no
driver for this part anywhere, so the register tables, the power up
sequence, the I2C address and the lane count all come from the sensor
module data the vendor firmware ships for this board
(/mnt/vendor/lib/camera/com.qti.sensormodule.j20c_ofilm_s5k3t2_front.bin;
the sunny module carries identical tables).

The data cross-checks: the mode's PLL - 19.2MHz / 3 * 185 / (1 * 7), four
pixels a clock - over the mode's own line length and frame length gives
29.90fps, which is exactly the frame rate the same data declares as a
double, and the sensor's frame counter then ticks at that rate on the
hardware.

The sensor shares CSIPHY1 with the ultrawide camera through a board mux.
The vendor's power up sequences pick between the two with the pin this
driver calls select: this sensor asks for 0, the ultrawide for 1.
---
 drivers/media/i2c/Kconfig  |   10 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/s5k3t2.c | 1484 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1495 insertions(+)
 create mode 100644 drivers/media/i2c/s5k3t2.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 06ec2ac4d..58b390e02 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -797,6 +797,16 @@ config VIDEO_S5K5BAF
 	  This is a V4L2 sensor driver for Samsung S5K5BAF 2M
 	  camera sensor with an embedded SoC image signal processor.
 
+config VIDEO_S5K3T2
+	tristate "Samsung S5K3T2 sensor support"
+	depends on OF_GPIO
+	help
+	  This is a Video4Linux2 sensor driver for the Samsung
+	  S5K3T2 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k3t2.
+
 config VIDEO_S5K3L6XX
 	tristate "Samsung S5K3L6XX sensor support"
 	depends on I2C && VIDEO_DEV
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 3e72d3bf1..cc5d870df 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -130,6 +130,7 @@ obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3L6XX) += s5k3l6xx.o
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
+obj-$(CONFIG_VIDEO_S5K3T2) += s5k3t2.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
diff --git a/drivers/media/i2c/s5k3t2.c b/drivers/media/i2c/s5k3t2.c
new file mode 100644
index 000000000..4eeadc645
--- /dev/null
+++ b/drivers/media/i2c/s5k3t2.c
@@ -0,0 +1,1484 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S5K3T2 Camera Sensor Driver
+ *
+ * The register tables and the timing below were taken from the sensor module
+ * data the vendor firmware ships for the Xiaomi POCO X3 NFC (surya), and are
+ * cross-checked against the frame rates that same data declares.
+ */
+#include <linux/unaligned.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Streaming Mode */
+#define S5K3T2_REG_MODE_SELECT	0x0100
+#define S5K3T2_MODE_STANDBY	0x00
+#define S5K3T2_MODE_STREAMING	0x01
+
+/* Lines per frame */
+#define S5K3T2_REG_LPFR		0x0340
+
+/* Chip ID */
+#define S5K3T2_REG_ID		0x0000
+#define S5K3T2_ID		0x3142
+
+/* Exposure control */
+#define S5K3T2_REG_EXPOSURE_CIT	0x0202
+#define S5K3T2_EXPOSURE_MIN	6
+#define S5K3T2_EXPOSURE_OFFSET	5
+#define S5K3T2_EXPOSURE_STEP	1
+#define S5K3T2_EXPOSURE_DEFAULT	0x0800
+
+/*
+ * Analog gain control. Samsung codes the gain as 32 times the real value, so
+ * 0x20 is 1x. The vendor data does not carry a maximum for this part; 16x is
+ * the usual ceiling for a sensor of this generation and is used here.
+ */
+#define S5K3T2_REG_AGAIN	0x0204
+#define S5K3T2_AGAIN_MIN	0x20
+#define S5K3T2_AGAIN_MAX	0x200
+#define S5K3T2_AGAIN_STEP	1
+#define S5K3T2_AGAIN_DEFAULT	0x20
+
+/* Group hold register */
+#define S5K3T2_REG_HOLD		0x0104
+
+/* Input clock rate */
+#define S5K3T2_INCLK_RATE	19200000
+
+/*
+ * The vendor data asks for a delay after the soft reset in the init table. It
+ * spells the field in microseconds and puts 3 in it, which cannot be right for
+ * a reset; Samsung's own setfiles for this family wait 3ms, so wait that.
+ */
+#define S5K3T2_RESET_DELAY_US	3000
+
+/*
+ * CSI2 HW configuration. The sensor is wired with four data lanes: both the
+ * vendor's lane assignment (0x3210) and CSI_LANE_MODE (0x0114 = 0x0300, the
+ * high byte being the useful one as Samsung writes it as a word) say so.
+ *
+ * The link frequency is the second PLL of the mode table:
+ * 19.2MHz / 3 (0x030e) * 140 (0x0310) = 896MHz, i.e. 1792Mbps per lane. That
+ * clears the 1612Mbps per lane this mode needs to push a line out within its
+ * line time, with the ~11% margin a real design has.
+ */
+#define S5K3T2_LINK_FREQ	896000000
+#define S5K3T2_NUM_DATA_LANES	4
+
+#define S5K3T2_REG_MIN		0x00
+#define S5K3T2_REG_MAX		0xffff
+
+/**
+ * struct s5k3t2_reg - s5k3t2 sensor register
+ * @address: Register address
+ * @val: Register value
+ */
+struct s5k3t2_reg {
+	u16 address;
+	u16 val;
+};
+
+/**
+ * struct s5k3t2_reg_list - s5k3t2 sensor register list
+ * @num_of_regs: Number of registers in the list
+ * @regs: Pointer to register list
+ */
+struct s5k3t2_reg_list {
+	u32 num_of_regs;
+	const struct s5k3t2_reg *regs;
+};
+
+/**
+ * struct s5k3t2_mode - s5k3t2 sensor mode structure
+ * @width: Frame width
+ * @height: Frame height
+ * @code: Format code
+ * @hblank: Horizontal blanking in lines
+ * @vblank: Vertical blanking in lines
+ * @vblank_min: Minimum vertical blanking in lines
+ * @vblank_max: Maximum vertical blanking in lines
+ * @pclk: Sensor pixel clock
+ * @link_freq_idx: Link frequency index
+ * @reg_list: Register list for sensor mode
+ */
+struct s5k3t2_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_min;
+	u32 vblank_max;
+	u64 pclk;
+	u32 link_freq_idx;
+	struct s5k3t2_reg_list reg_list;
+};
+
+/*
+ * The downstream kernel labels the 2.8V rail behind the "camera_vdig" GPIO
+ * regulator as vdig, but 2.8V is not a digital core voltage; it is described
+ * here as what its regulator name says it is. The other analogue rail comes
+ * from AVDD1 of the board's WL2866D camera PMIC, which downstream drives out
+ * of band instead of through the regulator framework.
+ */
+static const char * const s5k3t2_supply_names[] = {
+	"dovdd",	/* Digital I/O power */
+	"avdd",		/* Analog power */
+	"avdd2",	/* Second analogue power */
+};
+
+/**
+ * struct s5k3t2 - s5k3t2 sensor device structure
+ * @dev: Pointer to generic device
+ * @client: Pointer to i2c client
+ * @sd: V4L2 sub-device
+ * @pad: Media pad. Only one pad supported
+ * @reset_gpio: Sensor reset gpio
+ * @select_gpio: CSIPHY mux select gpio
+ * @inclk: Sensor input clock
+ * @supplies: Regulator supplies
+ * @ctrl_handler: V4L2 control handler
+ * @link_freq_ctrl: Pointer to link frequency control
+ * @pclk_ctrl: Pointer to pixel clock control
+ * @hblank_ctrl: Pointer to horizontal blanking control
+ * @vblank_ctrl: Pointer to vertical blanking control
+ * @exp_ctrl: Pointer to exposure control
+ * @again_ctrl: Pointer to analog gain control
+ * @vblank: Vertical blanking in lines
+ * @cur_mode: Pointer to current selected sensor mode
+ * @mutex: Mutex for serializing sensor controls
+ */
+struct s5k3t2 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *select_gpio;
+	struct clk *inclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5k3t2_supply_names)];
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq_ctrl;
+	struct v4l2_ctrl *pclk_ctrl;
+	struct v4l2_ctrl *hblank_ctrl;
+	struct v4l2_ctrl *vblank_ctrl;
+	struct {
+		struct v4l2_ctrl *exp_ctrl;
+		struct v4l2_ctrl *again_ctrl;
+	};
+	u32 vblank;
+	const struct s5k3t2_mode *cur_mode;
+	struct mutex mutex;
+};
+
+static const s64 link_freq[] = {
+	S5K3T2_LINK_FREQ,
+};
+
