From b788ae4ccda772e7171198d78449f19767bad22a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Eduardo=20Garc=C3=ADa-M=C3=A1dico=20Portabella?=
 <woodyst@gmail.com>
Date: Sat, 1 Aug 2026 22:55:22 +0200
Subject: [PATCH 075/106] ASoC: qdsp6: pseudo ports need real AFE config +
 standard start

The in-call tap ports (0x8003/4/5) were being started with the bare
AFE_PSEUDOPORT_CMD_START and no configuration. The vendor stack never
uses that command (zero callers): it configures the pseudo port like a
normal one (AFE_PARAM_ID_PSEUDO_PORT_CONFIG: rate, channels, 16 bit,
timer timing) and then sends the usual DEVICE_START. On top of that our
tap DAIs had no ops at all, so the backend prepare never ran and the
port was never started in any form - which is why the CVS record START
was acked but produced silence: the DSP had no configured destination.

Give the pseudo DAIs real ops (hw_params + standard prepare/shutdown),
send the exact-size config, and start/stop through the normal path.

Verified on hardware: 8 s of real downlink voice captured from hw:0,0
during a live VoLTE call (route trigger -> taps dl=1) with the call
surviving. Same flow as the factory stack on the reference device.
---
 sound/soc/qcom/qdsp6/q6afe-dai.c         |  27 ++++++
 sound/soc/qcom/qdsp6/q6afe.c             | 103 +++++++++++------------
 sound/soc/qcom/qdsp6/q6afe.h             |   8 ++
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c |   2 +-
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h |   1 +
 5 files changed, 84 insertions(+), 57 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6afe-dai.c b/sound/soc/qcom/qdsp6/q6afe-dai.c
index 52703be8c..cf0b5b2fa 100644
--- a/sound/soc/qcom/qdsp6/q6afe-dai.c
+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c
@@ -367,6 +367,19 @@ static int q6dma_hw_params(struct snd_pcm_substream *substream,
 
 	return 0;
 }
+static int q6pseudo_hw_params(struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params,
+			      struct snd_soc_dai *dai)
+{
+	struct q6afe_dai_data *dai_data = dev_get_drvdata(dai->dev);
+	struct q6afe_pseudo_cfg *cfg = &dai_data->port_config[dai->id].pseudo;
+
+	cfg->sample_rate = params_rate(params);
+	cfg->num_channels = params_channels(params);
+
+	return 0;
+}
+
 static void q6afe_dai_shutdown(struct snd_pcm_substream *substream,
 				struct snd_soc_dai *dai)
 {
@@ -435,6 +448,11 @@ static int q6afe_dai_prepare(struct snd_pcm_substream *substream,
 		q6afe_usb_port_prepare(dai_data->port[dai->id],
 				       &dai_data->port_config[dai->id].usb_audio);
 		break;
+	case VOICE_RECORD_RX ... VOICE_PLAYBACK_TX:
+		q6afe_pseudo_port_prepare(dai_data->port[dai->id],
+			dai_data->port_config[dai->id].pseudo.num_channels,
+			dai_data->port_config[dai->id].pseudo.sample_rate);
+		break;
 	default:
 		return -EINVAL;
 	}
@@ -773,6 +791,14 @@ static const struct snd_soc_dai_ops q6tdm_ops = {
 	.hw_params		= q6tdm_hw_params,
 };
 
+static const struct snd_soc_dai_ops q6pseudo_ops = {
+	.probe		= msm_dai_q6_dai_probe,
+	.remove		= msm_dai_q6_dai_remove,
+	.prepare	= q6afe_dai_prepare,
+	.hw_params	= q6pseudo_hw_params,
+	.shutdown	= q6afe_dai_shutdown,
+};
+
 static const struct snd_soc_dai_ops q6dma_ops = {
 	.probe			= msm_dai_q6_dai_probe,
 	.remove			= msm_dai_q6_dai_remove,
@@ -1159,6 +1185,7 @@ static int q6afe_dai_dev_probe(struct platform_device *pdev)
 	cfg.q6tdm_ops = &q6tdm_ops;
 	cfg.q6dma_ops = &q6dma_ops;
 	cfg.q6usb_ops = &q6afe_usb_ops;
+	cfg.q6pseudo_ops = &q6pseudo_ops;
 	dais = q6dsp_audio_ports_set_config(dev, &cfg, &num_dais);
 
 	return devm_snd_soc_register_component(dev, &q6afe_dai_component, dais, num_dais);
diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index 1bf6ab9cc..acdc65117 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -125,8 +125,10 @@
 /*
  * Pseudo ports. They have no hardware behind them: the DSP copies the voice
  * stream into 0x8003/0x8004 so the CPU can read the call, and mixes whatever
- * arrives on 0x8005 into the uplink. They take no port configuration and are
- * started with their own command instead of the usual device start.
+ * arrives on 0x8005 into the uplink. Despite that, they are configured and
+ * started like any other port (AFE_PARAM_ID_PSEUDO_PORT_CONFIG plus the usual
+ * device start); the dedicated AFE_PSEUDOPORT_CMD_START has no callers in the
+ * vendor stack.
  */
 #define AFE_PORT_ID_VOICE_RECORD_RX              0x8003
 #define AFE_PORT_ID_VOICE_RECORD_TX              0x8004
@@ -617,6 +619,19 @@ struct afe_param_id_usb_audio_svc_interval {
 	u32	svc_interval;
 } __packed;
 
+#define AFE_PARAM_ID_PSEUDO_PORT_CONFIG	0x00010219
+#define AFE_API_VERSION_PSEUDO_PORT_CONFIG	0x1
+#define AFE_PSEUDOPORT_TIMING_MODE_TIMER	0x1
+
+struct afe_param_id_pseudo_port_cfg {
+	u32	cfg_minor_version;
+	u16	bit_width;
+	u16	num_channels;
+	u16	data_format;	/* 0 = linear PCM */
+	u16	timing_mode;
+	u32	sample_rate;
+} __packed;
+
 union afe_port_config {
 	struct afe_param_id_hdmi_multi_chan_audio_cfg hdmi_multi_ch;
 	struct afe_param_id_slimbus_cfg           slim_cfg;
@@ -624,6 +639,7 @@ union afe_port_config {
 	struct afe_param_id_tdm_cfg	tdm_cfg;
 	struct afe_param_id_cdc_dma_cfg	dma_cfg;
 	struct afe_param_id_usb_cfg usb_cfg;
+	struct afe_param_id_pseudo_port_cfg pseudo_cfg;
 } __packed;
 
 
@@ -1341,8 +1357,9 @@ EXPORT_SYMBOL_GPL(q6afe_port_set_sysclk);
  * Return: Will be an negative on packet size on success.
  */
 /*
- * Pseudo ports carry no hardware configuration and use their own start/stop
- * command; sending them a device config would be rejected by the DSP.
+ * Pseudo ports use the standard config + device start/stop flow, but their
+ * config payload must be sized exactly (the vendor stack never sends the
+ * whole union for them).
  */
 static bool q6afe_port_is_pseudo(int port_id)
 {
@@ -1351,49 +1368,6 @@ static bool q6afe_port_is_pseudo(int port_id)
 	       port_id == AFE_PORT_ID_VOICE_PLAYBACK_TX;
 }
 
-#define AFE_PSEUDOPORT_CMD_START	0x000100cf
-#define AFE_PSEUDOPORT_CMD_STOP		0x000100d0
-
-struct afe_pseudoport_cmd {
-	u16 port_id;
-	u16 timing;	/* 0 = as fast as the data comes, 1 = AV timer */
-} __packed;
-
-static int q6afe_pseudoport_cmd(struct q6afe_port *port, u32 opcode)
-{
-	struct afe_pseudoport_cmd *cmd;
-	struct q6afe *afe = port->afe;
-	struct apr_pkt *pkt;
-	int pkt_size, ret;
-
-	pkt_size = APR_HDR_SIZE + sizeof(*cmd);
-	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
-	if (!p)
-		return -ENOMEM;
-
-	pkt = p;
-	cmd = p + APR_HDR_SIZE;
-
-	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
-					   APR_HDR_LEN(APR_HDR_SIZE),
-					   APR_PKT_VER);
-	pkt->hdr.pkt_size = pkt_size;
-	pkt->hdr.src_port = 0;
-	pkt->hdr.dest_port = 0;
-	pkt->hdr.token = port->token;
-	pkt->hdr.opcode = opcode;
-
-	cmd->port_id = port->id;
-	cmd->timing = 1;
-
-	ret = afe_apr_send_pkt(afe, pkt, port, opcode);
-	if (ret)
-		dev_err(afe->dev, "AFE pseudo port 0x%x cmd 0x%x failed %d\n",
-			port->id, opcode, ret);
-
-	return ret;
-}
-
 int q6afe_port_stop(struct q6afe_port *port)
 {
 	struct afe_port_cmd_device_stop *stop;
@@ -1409,9 +1383,6 @@ int q6afe_port_stop(struct q6afe_port *port)
 		return -EINVAL;
 	}
 
-	if (q6afe_port_is_pseudo(port_id))
-		return q6afe_pseudoport_cmd(port, AFE_PSEUDOPORT_CMD_STOP);
-
 	pkt_size = APR_HDR_SIZE + sizeof(*stop);
 	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
 	if (!p)
@@ -1782,6 +1753,28 @@ void q6afe_cdc_dma_port_prepare(struct q6afe_port *port,
 		dma_cfg->active_channels_mask = (1 << cfg->num_channels) - 1;
 }
 EXPORT_SYMBOL_GPL(q6afe_cdc_dma_port_prepare);
+
+/**
+ * q6afe_pseudo_port_prepare() - Prepare a voice record/playback pseudo port
+ *
+ * @port: Instance of afe port
+ * @num_channels: number of channels
+ * @sample_rate: sample rate
+ */
+void q6afe_pseudo_port_prepare(struct q6afe_port *port, int num_channels,
+			       int sample_rate)
+{
+	struct afe_param_id_pseudo_port_cfg *cfg = &port->port_cfg.pseudo_cfg;
+
+	cfg->cfg_minor_version = AFE_API_VERSION_PSEUDO_PORT_CONFIG;
+	cfg->bit_width = 16;	/* the only width the DSP supports here */
+	cfg->num_channels = num_channels;
+	cfg->data_format = 0;
+	cfg->timing_mode = AFE_PSEUDOPORT_TIMING_MODE_TIMER;
+	cfg->sample_rate = sample_rate;
+}
+EXPORT_SYMBOL_GPL(q6afe_pseudo_port_prepare);
+
 /**
  * q6afe_port_start() - Start a afe port
  *
@@ -1798,12 +1791,11 @@ int q6afe_port_start(struct q6afe_port *port)
 	struct apr_pkt *pkt;
 	int pkt_size;
 
-	if (q6afe_port_is_pseudo(port_id))
-		return q6afe_pseudoport_cmd(port, AFE_PSEUDOPORT_CMD_START);
-
 	ret  = q6afe_port_set_param_v2(port, &port->port_cfg, param_id,
 				       AFE_MODULE_AUDIO_DEV_INTERFACE,
-				       sizeof(port->port_cfg));
+				       q6afe_port_is_pseudo(port_id) ?
+					       sizeof(port->port_cfg.pseudo_cfg) :
+					       sizeof(port->port_cfg));
 	if (ret) {
 		dev_err(afe->dev, "AFE enable for port 0x%x failed %d\n",
 			port_id, ret);
@@ -1887,8 +1879,7 @@ struct q6afe_port *q6afe_port_get_from_id(struct device *dev, int id)
 	case AFE_PORT_ID_VOICE_RECORD_RX:
 	case AFE_PORT_ID_VOICE_RECORD_TX:
 	case AFE_PORT_ID_VOICE_PLAYBACK_TX:
-		/* no configuration: the DSP owns both ends of a pseudo port */
-		cfg_type = 0;
+		cfg_type = AFE_PARAM_ID_PSEUDO_PORT_CONFIG;
 		break;
 	case AFE_PORT_ID_SLIMBUS_MULTI_CHAN_0_TX:
 	case AFE_PORT_ID_SLIMBUS_MULTI_CHAN_1_TX:
diff --git a/sound/soc/qcom/qdsp6/q6afe.h b/sound/soc/qcom/qdsp6/q6afe.h
index 81b8f5292..50d000451 100644
--- a/sound/soc/qcom/qdsp6/q6afe.h
+++ b/sound/soc/qcom/qdsp6/q6afe.h
@@ -236,6 +236,11 @@ struct q6afe_usb_cfg {
 	u16	num_channels;
 };
 
+struct q6afe_pseudo_cfg {
+	u16	num_channels;
+	u32	sample_rate;
+};
+
 struct q6afe_port_config {
 	struct q6afe_hdmi_cfg hdmi;
 	struct q6afe_slim_cfg slim;
@@ -243,6 +248,7 @@ struct q6afe_port_config {
 	struct q6afe_tdm_cfg tdm;
 	struct q6afe_cdc_dma_cfg dma_cfg;
 	struct q6afe_usb_cfg usb_audio;
+	struct q6afe_pseudo_cfg pseudo;
 };
 
 struct q6afe_port;
@@ -262,6 +268,8 @@ int q6afe_i2s_port_prepare(struct q6afe_port *port, struct q6afe_i2s_cfg *cfg);
 void q6afe_tdm_port_prepare(struct q6afe_port *port, struct q6afe_tdm_cfg *cfg);
 void q6afe_cdc_dma_port_prepare(struct q6afe_port *port,
 				struct q6afe_cdc_dma_cfg *cfg);
+void q6afe_pseudo_port_prepare(struct q6afe_port *port, int num_channels,
+			       int sample_rate);
 
 int afe_port_send_usb_dev_param(struct q6afe_port *port, int cardidx, int pcmidx);
 int q6afe_port_set_sysclk(struct q6afe_port *port, int clk_id,
diff --git a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
index d5508245a..1d37fdc9f 100644
--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
@@ -784,7 +784,7 @@ struct snd_soc_dai_driver *q6dsp_audio_ports_set_config(struct device *dev,
 			q6dsp_audio_fe_dais[i].ops = cfg->q6slim_ops;
 			break;
 		case VOICE_RECORD_RX ... VOICE_PLAYBACK_TX:
-			/* nothing to configure: the DSP owns both ends */
+			q6dsp_audio_fe_dais[i].ops = cfg->q6pseudo_ops;
 			break;
 		case SENARY_MI2S_RX ... SENARY_MI2S_TX:
 		case QUINARY_MI2S_RX ... QUINARY_MI2S_TX:
diff --git a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h
index d8dde6dd0..8366f58c3 100644
--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h
@@ -12,6 +12,7 @@ struct q6dsp_audio_port_dai_driver_config {
 	const struct snd_soc_dai_ops *q6tdm_ops;
 	const struct snd_soc_dai_ops *q6dma_ops;
 	const struct snd_soc_dai_ops *q6usb_ops;
+	const struct snd_soc_dai_ops *q6pseudo_ops;
 };
 
 struct snd_soc_dai_driver *q6dsp_audio_ports_set_config(struct device *dev,
