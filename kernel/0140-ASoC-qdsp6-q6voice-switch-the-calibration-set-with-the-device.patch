From: =?UTF-8?q?Eduardo=20Garc=C3=ADa-M=C3=A1dico=20Portabella?=
 <woodyst@gmail.com>
Date: Sat, 12 Sep 2026 13:00:33 +0200
Subject: [PATCH] ASoC: qdsp6: q6voice: switch the calibration set with the
 device

Each voice device has its own ACDB calibration, including the Rx volume
tables. On a POCO X3 NFC the earpiece and the loudspeaker share the same
AFE ports, so moving a call to the speakerphone did not rebuild the
vocproc, and the call kept the earpiece's set: the speakerphone played
at the earpiece's level.

Add a "Voice Calibration" enum control (Handset, Speaker, Handset AEC,
Speaker AEC) for a UCM profile to set from each device's EnableSequence.
Changing it during a call rebuilds the vocproc as a device move does:
the old calibration is deregistered and unmapped, and the new set is
loaded and registered with the new vocproc. Such a rebuild on unchanged
ports skips the second, unprompted attempt meant for Bluetooth moves.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KTiSoMiKqxPrmSArLxTpFP
---
 sound/soc/qcom/qdsp6/q6voice-dai.c | 42 ++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.c     | 77 +++++++++++++++++++++++++++---
 sound/soc/qcom/qdsp6/q6voice.h     |  2 +
 3 files changed, 115 insertions(+), 6 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index e3a56c507..be1a9a12f 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -304,9 +304,51 @@ static int q6voice_tx_switch_put(struct snd_kcontrol *kcontrol,
 	return 1;
 }
 
+/*
+ * "Voice Calibration": which ACDB set the call's vocproc uses (q6voice cal_set).
+ * A UCM profile sets it from each device's EnableSequence, so that moving a
+ * call to the loudspeaker also moves it to the loudspeaker's calibration.
+ */
+static const char * const q6voice_cal_texts[] = {
+	"Handset", "Speaker", "Handset AEC", "Speaker AEC",
+};
+static const char * const q6voice_cal_sets[] = {
+	"handset", "speaker", "handset-aec", "speaker-aec",
+};
+static SOC_ENUM_SINGLE_EXT_DECL(q6voice_cal_enum, q6voice_cal_texts);
+
+static int q6voice_cal_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	const char *set = q6voice_get_cal_set();
+	size_t len = strcspn(set, "\n");
+	unsigned int i;
+
+	ucontrol->value.enumerated.item[0] = 0;
+	for (i = 0; i < ARRAY_SIZE(q6voice_cal_sets); i++)
+		if (strlen(q6voice_cal_sets[i]) == len &&
+		    !strncmp(set, q6voice_cal_sets[i], len))
+			ucontrol->value.enumerated.item[0] = i;
+
+	return 0;
+}
+
+static int q6voice_cal_put(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	unsigned int i = ucontrol->value.enumerated.item[0];
+
+	if (i >= ARRAY_SIZE(q6voice_cal_sets))
+		return -EINVAL;
+
+	return q6voice_set_cal_set(q6voice_cal_sets[i]);
+}
+
 static const struct snd_kcontrol_new q6voice_controls[] = {
 	SOC_SINGLE_BOOL_EXT("Voice Tx Capture Switch", 0,
 			    q6voice_tx_switch_get, q6voice_tx_switch_put),
+	SOC_ENUM_EXT("Voice Calibration", q6voice_cal_enum,
+		     q6voice_cal_get, q6voice_cal_put),
 };
 
 static const struct snd_soc_component_driver q6voice_dai_component = {
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index d547ba477..5743acdeb 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -59,6 +59,8 @@ struct q6voice_path_runtime {
 	/* Vendor calibration mapped into the DSP for this call, and what is registered */
 	struct q6voice_cal *cal;
 	bool cvs_cal, cvp_cal;
+	/* The calibration set changed during the call: rebuild with the new one. */
+	bool cal_change;
 };
 
 struct q6voice_path {
@@ -1084,7 +1086,7 @@ static void q6voice_switch_device(struct work_struct *work)
 					      struct q6voice_path, switch_work);
 	struct device *dev = p->v->dev;
 	struct q6voice_session *mvm, *cvp;
-	bool force, full;
+	bool force, full, cal_only;
 	int ret;
 
 	mutex_lock(&p->lock);
@@ -1109,18 +1111,21 @@ static void q6voice_switch_device(struct work_struct *work)
 	/* Both ends have to be somewhere real, and somewhere else. */
 	if (!p->tx_port || !p->rx_port)
 		goto out;
-	if (cvp && p->tx_port == p->runtime->cvp_tx_port &&
-	    p->rx_port == p->runtime->cvp_rx_port && !force)
+	cal_only = cvp && p->tx_port == p->runtime->cvp_tx_port &&
+		   p->rx_port == p->runtime->cvp_rx_port && !force;
+	if (cal_only && !p->runtime->cal_change)
 		goto out;
 
-	dev_info(dev, "moving call: tx_port %d -> %d, rx_port %d -> %d (%s)\n",
+	dev_info(dev, "moving call: tx_port %d -> %d, rx_port %d -> %d (%s%s)\n",
 		 p->runtime->cvp_tx_port, p->tx_port,
 		 p->runtime->cvp_rx_port, p->rx_port,
-		 full ? "new voice session" : "vocproc only");
+		 full ? "new voice session" : "vocproc only",
+		 p->runtime->cal_change ? ", new calibration" : "");
 
 	if (full) {
 		q6voice_path_stop(p);
 		q6voice_cal_unload(p);
+		p->runtime->cal_change = false;
 		q6voice_drop_session(p, Q6VOICE_SERVICE_CVP);
 		q6voice_drop_session(p, Q6VOICE_SERVICE_CVS);
 		q6voice_drop_session(p, Q6VOICE_SERVICE_MVM);
@@ -1143,9 +1148,17 @@ static void q6voice_switch_device(struct work_struct *work)
 	if (ret)
 		dev_err(dev, "failed to disable the old cvp: %d\n", ret);
 
-	q6voice_cal_deregister_cvp(p, cvp);
+	if (p->runtime->cal_change)
+		q6voice_cal_deregister(p);
+	else
+		q6voice_cal_deregister_cvp(p, cvp);
 	q6voice_session_release(cvp);
 	p->runtime->sessions[Q6VOICE_SERVICE_CVP] = NULL;
+	if (p->runtime->cal_change) {
+		/* vendor_setup below loads and registers the new set */
+		q6voice_cal_unload(p);
+		p->runtime->cal_change = false;
+	}
 
 	cvp = q6cvp_session_create(p->type, q6afe_get_port_id(p->tx_port),
 				   q6afe_get_port_id(p->rx_port));
@@ -1180,6 +1193,9 @@ static void q6voice_switch_device(struct work_struct *work)
 		dev_err(dev, "failed to resume voice after the switch: %d\n", ret);
 
 rekick:
+	/* A new calibration on the same ports needs no second attempt. */
+	if (cal_only)
+		goto out;
 	/*
 	 * Rekick: repeat this rebuild once, unprompted.
 	 *
@@ -1224,6 +1240,55 @@ void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
 }
 EXPORT_SYMBOL_GPL(q6voice_set_port);
 
+static bool q6voice_cal_set_is(const char *set)
+{
+	size_t len = strcspn(cal_set, "\n");
+
+	return strlen(set) == len && !strncmp(cal_set, set, len);
+}
+
+const char *q6voice_get_cal_set(void)
+{
+	return cal_set;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_cal_set);
+
+/*
+ * Choose the calibration set, as downstream does when a call moves between
+ * the earpiece and the loudspeaker: each has its own ACDB tables, including
+ * the Rx volume ones, so the speakerphone keeps the earpiece's level with the
+ * earpiece's set. Both share the same AFE ports here, so moving the call does
+ * not rebuild the vocproc; a change during a call rebuilds it with the new set.
+ * Returns 1 if the set changed.
+ */
+int q6voice_set_cal_set(const char *set)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	int i;
+
+	if (q6voice_cal_set_is(set))
+		return 0;
+
+	strscpy(cal_set, set, sizeof(cal_set));
+	if (!v)
+		return 1;
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (p->runtime && p->runtime->started == 3 && p->runtime->cal) {
+			p->runtime->cal_change = true;
+			mod_delayed_work(system_wq, &p->switch_work,
+					 msecs_to_jiffies(200));
+		}
+		mutex_unlock(&p->lock);
+	}
+
+	return 1;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_cal_set);
+
 MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
 MODULE_DESCRIPTION("Q6Voice driver");
 MODULE_LICENSE("GPL v2");
diff --git a/sound/soc/qcom/qdsp6/q6voice.h b/sound/soc/qcom/qdsp6/q6voice.h
index b58c4c2a7..bb624c945 100644
--- a/sound/soc/qcom/qdsp6/q6voice.h
+++ b/sound/soc/qcom/qdsp6/q6voice.h
@@ -23,6 +23,8 @@ int q6voice_stop(struct q6voice *v, enum q6voice_path_type path, bool capture);
 int q6voice_incall_record_route(bool tx_port, bool set);
 int q6voice_incall_playback_route(bool set);
 int q6voice_set_tx_mute(bool mute);
+int q6voice_set_cal_set(const char *set);
+const char *q6voice_get_cal_set(void);
 bool q6voice_get_tx_mute(void);
 int q6voice_get_port(struct q6voice *v, enum q6voice_path_type path,
 		     bool capture);
