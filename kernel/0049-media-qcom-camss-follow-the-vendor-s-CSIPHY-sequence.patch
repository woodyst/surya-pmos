+/*
+ * csiphy_sm7150_config_lanes - Configure the lanes as the downstream driver does
+ * @csiphy: CSIPHY device
+ * @c: CSI2 lane configuration
+ * @settle_cnt: Settle count
+ *
+ * The flat table the other gen2 SoCs share here is written out unconditionally,
+ * every lane bank of it. The downstream driver for this SoC instead walks a lane
+ * mask and only touches the banks of the lanes that are wired up, and it writes
+ * the common registers before any of them. Follow that.
+ */
+static void csiphy_sm7150_config_lanes(struct csiphy_device *csiphy,
+				       struct csiphy_lanes_cfg *c,
+				       u8 settle_cnt)
+{
+	struct csiphy_device_regs *regs = csiphy->regs;
+	u8 lane_mask = CSIPHY_7150_LANE_CLK;
+	u8 lane_enable = 0;
+	unsigned int lane_pos;
+	int i;
+
+	for (i = 0; i < c->num_data; i++)
+		lane_mask |= CSIPHY_7150_LANE_DATA(c->data[i].pos);
+
+	/*
+	 * Lane mask bit 1 is the clock lane and enables bit 7 of CTRL5; the data
+	 * lanes enable every second bit from bit 0.
+	 */
+	for (i = 0; i < CSIPHY_7150_LANES; i++) {
+		if (!(lane_mask & BIT(i)))
+			continue;
+		if (i == 1)
+			lane_enable |= CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
+		else
+			lane_enable |= BIT((i < 1 ? i : i - 1) * 2);
+	}
+
+	writel_relaxed(lane_enable, csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
+	writel_relaxed(CSIPHY_3PH_CMN_CSI_COMMON_CTRL6_COMMON_PWRDN_B,
+		       csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 6));
+	writel_relaxed(0x02, csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 7));
+	writel_relaxed(0x02, csiphy->base +
