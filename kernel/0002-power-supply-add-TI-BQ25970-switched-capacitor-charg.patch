+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
@@ -189,7 +189,22 @@ tas2564: codec@4d { /* EAR */
 		sound-name-prefix = "Left";
 	};
 
-	/* ti,bq25968 (charger) @ 65 */
+	/*
+	 * TI BQ25970 switched-cap charge pump ("fast charge" path). Only
+	 * kicks in for the proprietary Xiaomi HVDCP 3.0/3.5 handshake done
+	 * elsewhere (not by this driver) - the pump itself just converts
+	 * whatever high-voltage VBUS shows up into battery charge current.
+	 * Values below match the real board config (sdmmagpie-idp.dtsi in
+	 * the Halium/downstream kernel for this device).
+	 */
+	charge-pump@65 {
+		compatible = "ti,bq25970";
+		reg = <0x65>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <43 IRQ_TYPE_EDGE_FALLING>;
+		ti,sc-ovp-limit-microvolt = <12000000>;
+		ti,sc-ocp-limit-microamp = <3500000>;
+	};
 };
 
