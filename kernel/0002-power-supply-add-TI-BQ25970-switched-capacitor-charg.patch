new file mode 100644
index 000000000..72ca68fc6
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/ti,bq25970.yaml
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,bq25970.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TI BQ25970 Switched-Capacitor Charge Pump
+
+maintainers:
+  - Edi <edi@example.org>
+
+description: |
+  The BQ25970 is a switched-capacitor ("charge pump") converter used
+  alongside a separate primary charger IC to enable higher-power fast
+  charging. Its register layout is not compatible with the BQ25980/
+  BQ25975/BQ25960 family beyond the OVP/OCP threshold block, so it is
+  handled by a dedicated driver.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: ti,bq25970
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  ti,sc-ovp-limit-microvolt:
+    description: Input overvoltage protection threshold, 50000 microvolt step.
+    default: 12000000
+    minimum: 5950000
+    maximum: 12300000
+
+  ti,sc-ocp-limit-microamp:
+    description: Input overcurrent protection threshold, 250000 microamp step.
+    default: 3500000
+    minimum: 1000000
+    maximum: 4750000
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        charge-pump@65 {
+            compatible = "ti,bq25970";
+            reg = <0x65>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <43 IRQ_TYPE_EDGE_FALLING>;
+            ti,sc-ovp-limit-microvolt = <12000000>;
+            ti,sc-ocp-limit-microamp = <3500000>;
+        };
+    };
diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
