diff --git a/drivers/power/supply/bq25970_charger.c b/drivers/power/supply/bq25970_charger.c
new file mode 100644
index 000000000..950c3617c
--- /dev/null
+++ b/drivers/power/supply/bq25970_charger.c
@@ -0,0 +1,456 @@
+// SPDX-License-Identifier: GPL-2.0
+// TI BQ25970 switched-capacitor charge pump driver
+//
+// Deliberately does NOT register a "battery"-type power_supply: this
+// chip's own VBAT/IBAT readings duplicate what the platform's real fuel
+// gauge already reports, and having two competing POWER_SUPPLY_TYPE_BATTERY
+// devices confuses userspace battery-percentage aggregation (UPower's
+// DisplayDevice merge logic in particular). Only "charger" (Mains) is
+// exposed, describing the charge pump's own input (VBUS/IBUS) side.
+
+#include <linux/bitops.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+
+#include "bq25970_charger.h"
+
+struct bq25970_device {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *charger;
+	int busovp_uv;
+	int busocp_ua;
+};
+
+struct bq25970_state {
+	bool online;
+	bool ovp;
+	bool ocp;
+	bool ce;
+};
+
+static bool bq25970_is_volatile_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case BQ25970_FAULT_STAT0:
+	case BQ25970_ALARM_STAT:
+	case BQ25970_ALARM_FLAG:
+	case BQ25970_FAULT_STAT1:
+	case BQ25970_FAULT_FLAG1:
+	case BQ25970_DEV_ID:
+	case BQ25970_IBUS_ADC_MSB:
+	case BQ25970_IBUS_ADC_MSB + 1:
+	case BQ25970_VBUS_ADC_MSB:
+	case BQ25970_VBUS_ADC_MSB + 1:
+	case BQ25970_VBAT_ADC_MSB:
+	case BQ25970_VBAT_ADC_MSB + 1:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static const struct regmap_config bq25970_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = BQ25970_TDIE_ADC_MSB + 1,
+	.cache_type = REGCACHE_MAPLE,
+	.volatile_reg = bq25970_is_volatile_reg,
+};
+
+static int bq25970_read_adc_word(struct bq25970_device *bq, u8 reg, int *val)
+{
+	unsigned int msb, lsb;
+	int ret;
+
+	ret = regmap_read(bq->regmap, reg, &msb);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(bq->regmap, reg + 1, &lsb);
+	if (ret)
+		return ret;
+
+	/* Signed 16-bit, already in native engineering units (mV/mA) -
+	 * confirmed against the vendor driver, which applies no further
+	 * per-channel scaling beyond this byte-order assembly. */
+	*val = (s16)((msb << 8) | lsb);
+	return 0;
+}
+
+static int bq25970_set_busovp(struct bq25970_device *bq, int uv)
+{
+	unsigned int code;
+
+	uv = clamp(uv, BQ25970_BUSOVP_MIN_uV, BQ25970_BUSOVP_MAX_uV);
+	code = (uv - BQ25970_BUSOVP_BASE_uV) / BQ25970_BUSOVP_STEP_uV;
+
+	return regmap_update_bits(bq->regmap, BQ25970_BUSOVP,
+				  BQ25970_BUSOVP_MASK, code);
+}
+
+static int bq25970_get_busovp(struct bq25970_device *bq, int *uv)
+{
+	unsigned int code;
+	int ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_BUSOVP, &code);
+	if (ret)
+		return ret;
+
+	*uv = (code & BQ25970_BUSOVP_MASK) * BQ25970_BUSOVP_STEP_uV +
+	      BQ25970_BUSOVP_BASE_uV;
+	return 0;
+}
+
+static int bq25970_set_busocp(struct bq25970_device *bq, int ua)
+{
+	unsigned int code;
+
+	ua = clamp(ua, BQ25970_BUSOCP_MIN_uA, BQ25970_BUSOCP_MAX_uA);
+	code = (ua - BQ25970_BUSOCP_BASE_uA) / BQ25970_BUSOCP_STEP_uA;
+
+	return regmap_update_bits(bq->regmap, BQ25970_BUSOCP,
+				  BQ25970_BUSOCP_MASK, code);
+}
+
+static int bq25970_get_busocp(struct bq25970_device *bq, int *ua)
+{
+	unsigned int code;
+	int ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_BUSOCP, &code);
+	if (ret)
+		return ret;
+
+	*ua = (code & BQ25970_BUSOCP_MASK) * BQ25970_BUSOCP_STEP_uA +
+	      BQ25970_BUSOCP_BASE_uA;
+	return 0;
+}
+
+static int bq25970_get_state(struct bq25970_device *bq,
+			      struct bq25970_state *state)
+{
+	unsigned int alarm_stat, fault_stat, ctrl1;
+	int ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_ALARM_STAT, &alarm_stat);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_FAULT_STAT1, &fault_stat);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_CTRL1, &ctrl1);
+	if (ret)
+		return ret;
+
+	state->online = !!(alarm_stat & BQ25970_ADAPTER_INSERT_STAT);
+	state->ovp = !!(fault_stat & (BQ25970_BAT_OVP_FLT_STAT |
+				       BQ25970_BUS_OVP_FLT_STAT));
+	state->ocp = !!(fault_stat & (BQ25970_BAT_OCP_FLT_STAT |
+				       BQ25970_BUS_OCP_FLT_STAT));
+	state->ce = !!(ctrl1 & BQ25970_CHG_EN);
+
+	return 0;
+}
+
+static int bq25970_hw_init(struct bq25970_device *bq)
+{
+	int ret;
+
+	/* Disable the watchdog - nothing pets it from this driver yet. */
+	ret = regmap_update_bits(bq->regmap, BQ25970_CTRL0,
+				  BQ25970_WATCHDOG_DIS, BQ25970_WATCHDOG_DIS);
+	if (ret)
+		return ret;
+
+	/*
+	 * Standalone mode, TS_BUS/TS_BAT/TDIE protection disabled: this
+	 * board has no TS thermistor pins wired to this chip (confirmed
+	 * against the vendor driver's own board config for this exact
+	 * hardware, which disables the same three checks) - leaving them
+	 * enabled against floating pins is what previously produced a
+	 * spurious HEALTH_OVERHEAT.
+	 */
+	ret = regmap_update_bits(bq->regmap, BQ25970_CTRL1,
+				  BQ25970_MS_MASK | BQ25970_TSBUS_DIS |
+				  BQ25970_TSBAT_DIS | BQ25970_TDIE_DIS,
+				  BQ25970_MS_STANDALONE | BQ25970_TSBUS_DIS |
+				  BQ25970_TSBAT_DIS | BQ25970_TDIE_DIS);
+	if (ret)
+		return ret;
+
+	ret = bq25970_set_busovp(bq, bq->busovp_uv);
+	if (ret)
+		return ret;
+
+	ret = bq25970_set_busocp(bq, bq->busocp_ua);
+	if (ret)
+		return ret;
+
+	/*
+	 * ADC: continuous scan, averaging on, 13-bit resolution, IBUS/VBUS
+	 * enabled - matches the vendor driver's own proven-working init
+	 * sequence for this exact chip.
+	 */
+	ret = regmap_update_bits(bq->regmap, BQ25970_ADC_CTRL,
+				  BQ25970_ADC_EN | BQ25970_ADC_RATE_ONESHOT |
+				  BQ25970_ADC_AVG_EN |
+				  BQ25970_ADC_SAMPLE_MASK |
+				  BQ25970_IBUS_ADC_DIS,
+				  BQ25970_ADC_EN | BQ25970_ADC_AVG_EN |
+				  (BQ25970_ADC_SAMPLE_13BITS << 2));
+	if (ret)
+		return ret;
+
+	/*
+	 * VBUS enabled (charger-side voltage_now); VOUT/IBAT/TSBUS/TSBAT/
+	 * TDIE disabled - IBAT and thermal channels aren't exposed by this
+	 * driver at all (see the file comment for why there's no "battery"
+	 * psy here), so there's no point powering those ADC channels.
+	 */
+	return regmap_update_bits(bq->regmap, BQ25970_ADC_CH_CTRL,
+				  BQ25970_VBUS_ADC_DIS | BQ25970_VAC_ADC_DIS |
+				  BQ25970_VOUT_ADC_DIS |
+				  BQ25970_VBAT_ADC_DIS |
+				  BQ25970_IBAT_ADC_DIS |
+				  BQ25970_TSBUS_ADC_DIS |
+				  BQ25970_TSBAT_ADC_DIS |
+				  BQ25970_TDIE_ADC_DIS,
+				  BQ25970_VOUT_ADC_DIS | BQ25970_IBAT_ADC_DIS |
+				  BQ25970_TSBUS_ADC_DIS |
+				  BQ25970_TSBAT_ADC_DIS |
+				  BQ25970_TDIE_ADC_DIS);
+}
+
+static int bq25970_get_property(struct power_supply *psy,
+				 enum power_supply_property psp,
+				 union power_supply_propval *val)
+{
+	struct bq25970_device *bq = power_supply_get_drvdata(psy);
+	struct bq25970_state state;
+	int ret, ival;
+
+	ret = bq25970_get_state(bq, &state);
+	if (ret)
+		return ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = BQ25970_MANUFACTURER;
+		return 0;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "bq25970";
+		return 0;
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = state.online;
+		return 0;
+	case POWER_SUPPLY_PROP_STATUS:
+		if (!state.online)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else if (state.ce)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (state.ovp)
+			val->intval = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+		else if (state.ocp)
+			val->intval = POWER_SUPPLY_HEALTH_OVERCURRENT;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = bq25970_read_adc_word(bq, BQ25970_VBUS_ADC_MSB, &ival);
+		if (ret)
+			return ret;
+		val->intval = ival * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = bq25970_read_adc_word(bq, BQ25970_IBUS_ADC_MSB, &ival);
+		if (ret)
+			return ret;
+		val->intval = ival * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+		return bq25970_get_busovp(bq, &val->intval);
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return bq25970_get_busocp(bq, &val->intval);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int bq25970_set_property(struct power_supply *psy,
+				 enum power_supply_property psp,
+				 const union power_supply_propval *val)
+{
+	struct bq25970_device *bq = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+		return bq25970_set_busovp(bq, val->intval);
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return bq25970_set_busocp(bq, val->intval);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int bq25970_property_is_writable(struct power_supply *psy,
+					 enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static enum power_supply_property bq25970_props[] = {
+	POWER_SUPPLY_PROP_MANUFACTURER,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static const struct power_supply_desc bq25970_charger_desc = {
+	.name = "bq25970-charger",
+	.type = POWER_SUPPLY_TYPE_MAINS,
+	.properties = bq25970_props,
+	.num_properties = ARRAY_SIZE(bq25970_props),
+	.get_property = bq25970_get_property,
+	.set_property = bq25970_set_property,
+	.property_is_writeable = bq25970_property_is_writable,
+};
+
+static irqreturn_t bq25970_irq_handler(int irq, void *data)
+{
+	struct bq25970_device *bq = data;
+
+	power_supply_changed(bq->charger);
+
+	return IRQ_HANDLED;
+}
+
+static int bq25970_parse_dt(struct bq25970_device *bq)
+{
+	struct device *dev = bq->dev;
+
+	if (device_property_read_u32(dev, "ti,sc-ovp-limit-microvolt",
+				      &bq->busovp_uv))
+		bq->busovp_uv = BQ25970_BUSOVP_DFLT_uV;
+
+	if (device_property_read_u32(dev, "ti,sc-ocp-limit-microamp",
+				      &bq->busocp_ua))
+		bq->busocp_ua = BQ25970_BUSOCP_DFLT_uA;
+
+	if (bq->busovp_uv < BQ25970_BUSOVP_MIN_uV ||
+	    bq->busovp_uv > BQ25970_BUSOVP_MAX_uV) {
+		dev_err(dev, "ti,sc-ovp-limit-microvolt out of range\n");
+		return -EINVAL;
+	}
+
+	if (bq->busocp_ua < BQ25970_BUSOCP_MIN_uA ||
+	    bq->busocp_ua > BQ25970_BUSOCP_MAX_uA) {
+		dev_err(dev, "ti,sc-ocp-limit-microamp out of range\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int bq25970_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct power_supply_config psy_cfg = {};
+	struct bq25970_device *bq;
+	unsigned int dev_id;
+	int ret;
+
+	bq = devm_kzalloc(dev, sizeof(*bq), GFP_KERNEL);
+	if (!bq)
+		return -ENOMEM;
+
+	bq->dev = dev;
+	i2c_set_clientdata(client, bq);
+
+	bq->regmap = devm_regmap_init_i2c(client, &bq25970_regmap_config);
+	if (IS_ERR(bq->regmap))
+		return dev_err_probe(dev, PTR_ERR(bq->regmap),
+				      "Failed to allocate register map\n");
+
+	ret = regmap_read(bq->regmap, BQ25970_DEV_ID, &dev_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to read device ID\n");
+	dev_dbg(dev, "device ID: 0x%x\n", (unsigned int)(dev_id & BQ25970_DEV_ID_MASK));
+
+	ret = bq25970_parse_dt(bq);
+	if (ret)
+		return ret;
+
+	ret = bq25970_hw_init(bq);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to initialize chip\n");
+
+	psy_cfg.drv_data = bq;
+	psy_cfg.fwnode = dev_fwnode(dev);
+
+	bq->charger = devm_power_supply_register(dev, &bq25970_charger_desc,
+						  &psy_cfg);
+	if (IS_ERR(bq->charger))
+		return dev_err_probe(dev, PTR_ERR(bq->charger),
+				      "Failed to register power supply\n");
+
+	if (client->irq) {
+		ret = devm_request_threaded_irq(dev, client->irq, NULL,
+						 bq25970_irq_handler,
+						 IRQF_TRIGGER_FALLING |
+						 IRQF_ONESHOT,
+						 dev_name(dev), bq);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					      "Failed to request IRQ\n");
+	}
+
+	return 0;
+}
+
+static const struct i2c_device_id bq25970_i2c_ids[] = {
+	{ "bq25970", 0 },
+	{},
+};
+MODULE_DEVICE_TABLE(i2c, bq25970_i2c_ids);
+
+static const struct of_device_id bq25970_of_match[] = {
+	{ .compatible = "ti,bq25970" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, bq25970_of_match);
+
+static struct i2c_driver bq25970_driver = {
+	.driver = {
+		.name = "bq25970-charger",
+		.of_match_table = bq25970_of_match,
+	},
+	.probe = bq25970_probe,
+	.id_table = bq25970_i2c_ids,
+};
+module_i2c_driver(bq25970_driver);
+
+MODULE_DESCRIPTION("TI BQ25970 switched-capacitor charge pump driver");
+MODULE_LICENSE("GPL");
