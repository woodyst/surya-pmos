index 000000000..2b9811e31
--- /dev/null
+++ b/drivers/power/supply/bq25970_charger.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* TI BQ25970 switched-capacitor charge pump register map.
+ *
+ * Unlike the BQ25980/BQ25975/BQ25960 family (see bq25980_charger.c), the
+ * BQ25970's register layout only matches that family for the OVP/OCP
+ * threshold block (0x00-0x09). Everything past that (control, status,
+ * ADC) is arranged differently. This header is derived from the vendor
+ * bq2597x_charger driver used by Xiaomi's sdmmagpie/surya downstream
+ * kernel (drivers/power/supply/ti/bq25970_reg.h there), which is the
+ * only available register-level documentation for this exact part.
+ */
+
+#ifndef BQ25970_CHARGER_H
+#define BQ25970_CHARGER_H
+
+#define BQ25970_MANUFACTURER		"Texas Instruments"
+
+/* OVP/OCP threshold block - same layout as bq25980/975/960 */
+#define BQ25970_BATOVP			0x00
+#define BQ25970_BATOVP_ALM		0x01
+#define BQ25970_BATOCP			0x02
+#define BQ25970_BATOCP_ALM		0x03
+#define BQ25970_BATUCP_ALM		0x04
+#define BQ25970_ACOVP			0x05
+#define BQ25970_BUSOVP			0x06
+#define BQ25970_BUSOVP_ALM		0x07
+#define BQ25970_BUSOCP			0x08
+#define BQ25970_BUSOCP_ALM		0x09
+
+#define BQ25970_BATOVP_MASK		GENMASK(5, 0)
+#define BQ25970_BATOVP_BASE_uV		3475000
+#define BQ25970_BATOVP_STEP_uV		25000
+#define BQ25970_BATOVP_MAX_uV		5050000
+#define BQ25970_BATOVP_DFLT_uV		4550000
+
+#define BQ25970_BUSOVP_MASK		GENMASK(6, 0)
+#define BQ25970_BUSOVP_BASE_uV		5950000
+#define BQ25970_BUSOVP_STEP_uV		50000
+#define BQ25970_BUSOVP_MIN_uV		5950000
+#define BQ25970_BUSOVP_MAX_uV		12300000
+#define BQ25970_BUSOVP_DFLT_uV		12000000
+
+#define BQ25970_BUSOCP_MASK		GENMASK(3, 0)
+#define BQ25970_BUSOCP_BASE_uA		1000000
+#define BQ25970_BUSOCP_STEP_uA		250000
+#define BQ25970_BUSOCP_MIN_uA		1000000
+#define BQ25970_BUSOCP_MAX_uA		4750000
+#define BQ25970_BUSOCP_DFLT_uA		3500000
+
+/* Control/status/ADC block - BQ25970-specific offsets, do not reuse
+ * bq25980_charger.h's offsets here, they refer to a different chip. */
+#define BQ25970_FAULT_STAT0		0x0A
+#define BQ25970_TSHUT_FLAG		BIT(7)
+#define BQ25970_TSHUT_STAT		BIT(6)
+#define BQ25970_VBUS_ERRORLO_STAT	BIT(5)
+#define BQ25970_VBUS_ERRORHI_STAT	BIT(4)
+#define BQ25970_SS_TIMEOUT_FLAG		BIT(3)
+#define BQ25970_CONV_SWITCHING_STAT	BIT(2)
+#define BQ25970_CONV_OCP_FLAG		BIT(1)
+
+#define BQ25970_CTRL0			0x0B
+#define BQ25970_REG_RST			BIT(7)
+#define BQ25970_WATCHDOG_DIS		BIT(2)
+#define BQ25970_WATCHDOG_MASK		GENMASK(1, 0)
+
+#define BQ25970_CTRL1			0x0C
+#define BQ25970_CHG_EN			BIT(7)
+#define BQ25970_MS_MASK			GENMASK(6, 5)
+#define BQ25970_MS_STANDALONE		0
+#define BQ25970_TSBUS_DIS		BIT(2)
+#define BQ25970_TSBAT_DIS		BIT(1)
+#define BQ25970_TDIE_DIS		BIT(0)
+
+#define BQ25970_ALARM_STAT		0x0D
+#define BQ25970_BAT_OVP_ALM_STAT	BIT(7)
+#define BQ25970_BAT_OCP_ALM_STAT	BIT(6)
+#define BQ25970_BUS_OVP_ALM_STAT	BIT(5)
+#define BQ25970_BUS_OCP_ALM_STAT	BIT(4)
+#define BQ25970_BAT_UCP_ALM_STAT	BIT(3)
+#define BQ25970_ADAPTER_INSERT_STAT	BIT(2)
+#define BQ25970_VBAT_INSERT_STAT	BIT(1)
+#define BQ25970_ADC_DONE_STAT		BIT(0)
+
+#define BQ25970_ALARM_FLAG		0x0E
+#define BQ25970_ALARM_MASK		0x0F
+
+#define BQ25970_FAULT_STAT1		0x10
+#define BQ25970_BAT_OVP_FLT_STAT	BIT(7)
+#define BQ25970_BAT_OCP_FLT_STAT	BIT(6)
+#define BQ25970_BUS_OVP_FLT_STAT	BIT(5)
+#define BQ25970_BUS_OCP_FLT_STAT	BIT(4)
+#define BQ25970_TSBUS_TSBAT_ALM_STAT	BIT(3)
+#define BQ25970_TSBAT_FLT_STAT		BIT(2)
+#define BQ25970_TSBUS_FLT_STAT		BIT(1)
+#define BQ25970_TDIE_ALM_STAT		BIT(0)
+
+#define BQ25970_FAULT_FLAG1		0x11
+#define BQ25970_FAULT_MASK1		0x12
+
+#define BQ25970_DEV_ID			0x13
+#define BQ25970_DEV_ID_MASK		GENMASK(3, 0)
+
+#define BQ25970_ADC_CTRL		0x14
+#define BQ25970_ADC_EN			BIT(7)
+#define BQ25970_ADC_RATE_ONESHOT	BIT(6)
+#define BQ25970_ADC_AVG_EN		BIT(5)
+#define BQ25970_ADC_SAMPLE_MASK		GENMASK(3, 2)
+#define BQ25970_ADC_SAMPLE_13BITS	2
+#define BQ25970_IBUS_ADC_DIS		BIT(0)
+
+#define BQ25970_ADC_CH_CTRL		0x15
+#define BQ25970_VBUS_ADC_DIS		BIT(7)
+#define BQ25970_VAC_ADC_DIS		BIT(6)
+#define BQ25970_VOUT_ADC_DIS		BIT(5)
+#define BQ25970_VBAT_ADC_DIS		BIT(4)
+#define BQ25970_IBAT_ADC_DIS		BIT(3)
+#define BQ25970_TSBUS_ADC_DIS		BIT(2)
+#define BQ25970_TSBAT_ADC_DIS		BIT(1)
+#define BQ25970_TDIE_ADC_DIS		BIT(0)
+
+/*
+ * ADC data registers: each channel is one 16-bit word (MSB reg first,
+ * i.e. reg[N] << 8 | reg[N+1]), read as a plain signed value already in
+ * the channel's native engineering unit (mV for voltage channels, mA for
+ * current channels) - confirmed against the vendor driver, which applies
+ * no further scaling beyond the byte-order swap.
+ */
+#define BQ25970_IBUS_ADC_MSB		0x16
+#define BQ25970_VBUS_ADC_MSB		0x18
+#define BQ25970_VAC_ADC_MSB		0x1A
+#define BQ25970_VOUT_ADC_MSB		0x1C
+#define BQ25970_VBAT_ADC_MSB		0x1E
+#define BQ25970_IBAT_ADC_MSB		0x20
+#define BQ25970_TSBUS_ADC_MSB		0x22
+#define BQ25970_TSBAT_ADC_MSB		0x24
+#define BQ25970_TDIE_ADC_MSB		0x26
+
+#endif /* BQ25970_CHARGER_H */
