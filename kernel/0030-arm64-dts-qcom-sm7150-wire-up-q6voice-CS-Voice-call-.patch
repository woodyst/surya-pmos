From f671069aab0455bab8b2e0ee674898f3befa9a2e Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Thu, 16 Jul 2026 13:04:56 +0200
Subject: [PATCH 030/106] arm64: dts: qcom: sm7150: wire up q6voice CS-Voice
 call audio

Add the MVM/CVS/CVP APR service nodes under the ADSP and a hostless
CS-Voice front-end DAI link on surya (downlink to TERTIARY_MI2S_RX).
---
 .../boot/dts/qcom/sm7150-xiaomi-surya.dtsi    | 16 ++++++++++
 arch/arm64/boot/dts/qcom/sm7150.dtsi          | 30 +++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
index 6953113e4..0053c43ec 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
@@ -7,6 +7,7 @@
 /dts-v1/;
 
 #include "sm7150-xiaomi-common.dtsi"
+#include <dt-bindings/sound/qcom,q6voice.h>
 
 / {
 	qcom,board-id = <34 0>;
@@ -94,6 +95,21 @@ cpu {
 			};
 		};
 
+		/*
+		 * Hostless front-end for CS (circuit-switched) voice calls.
+		 * Opening this PCM (via q6voiced on call start) powers up the
+		 * q6voice DSP session (MVM/CVP) that bridges the modem vocoder
+		 * to the codec AFE ports. No samples cross the CPU; there is
+		 * deliberately no codec node. Downlink is routed to
+		 * TERTIARY_MI2S_RX (tas2564 earpiece / tas2562 speaker) via UCM.
+		 */
+		cs-voice-dai-link {
+			link-name = "CS-Voice";
+			cpu {
+				sound-dai = <&q6voicedai CS_VOICE>;
+			};
+		};
+
 		i2s-dai-link {
 			link-name = "I2S Playback";
 			cpu {
diff --git a/arch/arm64/boot/dts/qcom/sm7150.dtsi b/arch/arm64/boot/dts/qcom/sm7150.dtsi
index 055aa6b3e..f5b711103 100644
--- a/arch/arm64/boot/dts/qcom/sm7150.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7150.dtsi
@@ -2626,6 +2626,36 @@ q6routing: routing {
 							#sound-dai-cells = <0>;
 						};
 					};
+
+					q6mvm: service@9 {
+						compatible = "qcom,q6mvm";
+						reg = <APR_SVC_ADSP_MVM>;
+
+						qcom,protection-domain = "avs/audio",
+									 "msm/adsp/audio_pd";
+
+						q6voicedai: dais {
+							compatible = "qcom,q6voice-dais";
+
+							#sound-dai-cells = <0>;
+						};
+					};
+
+					q6cvs: service@a {
+						compatible = "qcom,q6cvs";
+						reg = <APR_SVC_ADSP_CVS>;
+
+						qcom,protection-domain = "avs/audio",
+									 "msm/adsp/audio_pd";
+					};
+
+					q6cvp: service@b {
+						compatible = "qcom,q6cvp";
+						reg = <APR_SVC_ADSP_CVP>;
+
+						qcom,protection-domain = "avs/audio",
+									 "msm/adsp/audio_pd";
+					};
 				};
 
 				fastrpc {
-- 
