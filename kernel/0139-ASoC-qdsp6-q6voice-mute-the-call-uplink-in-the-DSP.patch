From: =?UTF-8?q?Eduardo=20Garc=C3=ADa-M=C3=A1dico=20Portabella?=
 <woodyst@gmail.com>
Date: Sat, 12 Sep 2026 12:36:00 +0200
Subject: [PATCH] ASoC: qdsp6: q6voice: mute the call uplink in the DSP

Userspace had no way to mute a call but the microphone's analogue gain.
On a POCO X3 NFC its minimum still let the room into the uplink at about
-29 dB: with a tone played into the call next to the phone, the far end
still heard it with the microphone "muted".

Mute it the way the vendor stack does, with VSS_IVOLUME_CMD_MUTE_V2 on
the voice stream. A "Voice Tx Capture Switch" control sets it: it applies
to a call in progress at once and is kept for the next one, which is set
up muted or unmuted accordingly. Its name makes alsa-lib file it as a
capture switch, so a UCM profile can hand it to PipeWire as the capture
mute.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KTiSoMiKqxPrmSArLxTpFP
---
 sound/soc/qcom/qdsp6/q6voice-dai.c | 33 ++++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.c     | 45 ++++++++++++++++++++++++++++--
 sound/soc/qcom/qdsp6/q6voice.h     |  2 ++
 3 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index 903ec8f47..e3a56c507 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -278,9 +278,42 @@ static int q6voice_reg_write(struct snd_soc_component *component,
 	return 0;
 }
 
+/*
+ * "Voice Tx Capture Switch": off mutes the call's uplink in the DSP. A switch
+ * whose name ends in "Capture Switch", so that alsa-lib files it as a capture
+ * switch and a UCM profile can hand it to PipeWire as the capture mute
+ * (CaptureSwitch); any other name comes out as a playback switch and is
+ * ignored for capture.
+ */
+static int q6voice_tx_switch_get(struct snd_kcontrol *kcontrol,
+				 struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = !q6voice_get_tx_mute();
+	return 0;
+}
+
+static int q6voice_tx_switch_put(struct snd_kcontrol *kcontrol,
+				 struct snd_ctl_elem_value *ucontrol)
+{
+	bool on = !!ucontrol->value.integer.value[0];
+
+	if (on == !q6voice_get_tx_mute())
+		return 0;
+
+	q6voice_set_tx_mute(!on);
+	return 1;
+}
+
+static const struct snd_kcontrol_new q6voice_controls[] = {
+	SOC_SINGLE_BOOL_EXT("Voice Tx Capture Switch", 0,
+			    q6voice_tx_switch_get, q6voice_tx_switch_put),
+};
+
 static const struct snd_soc_component_driver q6voice_dai_component = {
 	.name = DRV_NAME,
 	.open = q6voice_dai_open,
+	.controls = q6voice_controls,
+	.num_controls = ARRAY_SIZE(q6voice_controls),
 
 	.dapm_widgets = q6voice_dapm_widgets,
 	.num_dapm_widgets = ARRAY_SIZE(q6voice_dapm_widgets),
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index 28ac4a25d..d547ba477 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -219,6 +219,45 @@ int q6voice_incall_playback_route(bool set)
 }
 EXPORT_SYMBOL_GPL(q6voice_incall_playback_route);
 
+/*
+ * Uplink mute, the way the vendor stack does it: VSS_IVOLUME_CMD_MUTE_V2 on
+ * the voice stream. The microphone's analogue gain at its minimum, which is
+ * what the call profile used for mute, still let the room through at about
+ * -29 dB (measured on a POCO X3 NFC with a tone played into a call). Kept
+ * across calls and applied when a call is set up.
+ */
+static bool q6voice_tx_muted;
+
+int q6voice_set_tx_mute(bool mute)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	int ret = 0, i;
+
+	q6voice_tx_muted = mute;
+	if (!v)
+		return 0;
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (p->runtime && p->runtime->started == 3 &&
+		    p->runtime->sessions[Q6VOICE_SERVICE_CVS])
+			ret = q6cvs_mute(p->runtime->sessions[Q6VOICE_SERVICE_CVS],
+					 0 /* TX */, mute);
+		mutex_unlock(&p->lock);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_tx_mute);
+
+bool q6voice_get_tx_mute(void)
+{
+	return q6voice_tx_muted;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_tx_mute);
+
 static int q6voice_record_now_set(const char *val, const struct kernel_param *kp)
 {
 	struct q6voice *v = q6voice_live;
@@ -756,9 +795,11 @@ static int q6voice_path_start(struct q6voice_path *p)
 	if (ret)
 		dev_dbg(dev, "rx volume step %d not applied: %d\n", rx_volume_step, ret);
 
-	ret = q6cvs_mute(p->runtime->sessions[Q6VOICE_SERVICE_CVS], 0 /* TX */, false);
+	ret = q6cvs_mute(p->runtime->sessions[Q6VOICE_SERVICE_CVS], 0 /* TX */,
+			 q6voice_tx_muted);
 	if (ret)
-		dev_dbg(dev, "tx unmute not applied: %d\n", ret);
+		dev_dbg(dev, "tx %smute not applied: %d\n",
+			q6voice_tx_muted ? "" : "un", ret);
 
 	ret = q6mvm_start(mvm, true);
 	if (ret) {
diff --git a/sound/soc/qcom/qdsp6/q6voice.h b/sound/soc/qcom/qdsp6/q6voice.h
index 3dd78ec28..b58c4c2a7 100644
--- a/sound/soc/qcom/qdsp6/q6voice.h
+++ b/sound/soc/qcom/qdsp6/q6voice.h
@@ -22,6 +22,8 @@ int q6voice_stop(struct q6voice *v, enum q6voice_path_type path, bool capture);
 
 int q6voice_incall_record_route(bool tx_port, bool set);
 int q6voice_incall_playback_route(bool set);
+int q6voice_set_tx_mute(bool mute);
+bool q6voice_get_tx_mute(void);
 int q6voice_get_port(struct q6voice *v, enum q6voice_path_type path,
 		     bool capture);
 void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
