index fb17a951a..3ed05526e 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-surya.dtsi
@@ -8,6 +8,7 @@
 
 #include "sm7150-xiaomi-common.dtsi"
 #include <dt-bindings/clock/qcom,sm7150-camcc.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/sound/qcom,q6voice.h>
 
 / {
@@ -420,6 +421,14 @@ camera@1a {
 		port {
 			imx682_ep: endpoint {
 				remote-endpoint = <&csiphy0_ep>;
+				/*
+				 * The sensor is a C-PHY transmitter: its
+				 * CSI_SIGNALING_MODE (0x0111) reads 0x03,
+				 * which the MIPI CCS spec defines as CSI-2
+				 * C-PHY. These are three trios, not three
+				 * data lanes plus a clock.
+				 */
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
 				data-lanes = <0 1 2>;
 				link-frequencies = /bits/ 64 <953600000>;
 			};
@@ -895,7 +904,8 @@ ports {
 		/* CSIPHY0: main IMX682 */
 		port@0 {
 			csiphy0_ep: endpoint {
-				clock-lanes = <7>;
+				/* C-PHY: no clock lane, the clock is in the trios */
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
 				data-lanes = <0 1 2>;
 				remote-endpoint = <&imx682_ep>;
 			};
diff --git a/drivers/media/i2c/imx682.c b/drivers/media/i2c/imx682.c
index d8e2e4c85..6639c8088 100644
--- a/drivers/media/i2c/imx682.c
+++ b/drivers/media/i2c/imx682.c
@@ -1476,8 +1476,14 @@ static int imx682_detect(struct imx682 *imx682)
 static int imx682_parse_hw_config(struct imx682 *imx682)
 {
 	struct fwnode_handle *fwnode = dev_fwnode(imx682->dev);
+	/*
+	 * This sensor is a C-PHY transmitter: its CSI_SIGNALING_MODE register
+	 * (0x0111) is programmed to 0x03, which the MIPI CCS specification
+	 * defines as CSI-2 C-PHY, and reads back as such from the hardware.
+	 * The three "lanes" are three trios; there is no separate clock lane.
+	 */
 	struct v4l2_fwnode_endpoint bus_cfg = {
-		.bus_type = V4L2_MBUS_CSI2_DPHY
+		.bus_type = V4L2_MBUS_CSI2_CPHY
 	};
 	struct fwnode_handle *ep;
 	unsigned long rate;
diff --git a/drivers/media/platform/qcom/camss/camss-csid-gen2.c b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
index 2cf657fda..b0e4c03c9 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-gen2.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
@@ -183,6 +183,13 @@ static void __csid_configure_rx(struct csid_device *csid,
 	val = (lane_cnt - 1) << CSI2_RX_CFG0_NUM_ACTIVE_LANES;
 	val |= phy->lane_assign << CSI2_RX_CFG0_DL0_INPUT_SEL;
 	val |= phy->csiphy_id << CSI2_RX_CFG0_PHY_NUM_SEL;
+	/*
+	 * The receiver has to be told which physical layer it is decoding.
+	 * The vendor driver writes this as (lane_type & 1) << 24; mainline
+	 * never did, so it always decoded as D-PHY.
+	 */
+	if (csid->phy.bus_type == V4L2_MBUS_CSI2_CPHY)
+		val |= 1 << CSI2_RX_CFG0_PHY_TYPE_SEL;
 	writel_relaxed(val, csid->base + CSID_CSI2_RX_CFG0);
 
 	val = 1 << CSI2_RX_CFG1_PACKET_ECC_CORRECTION_EN;
