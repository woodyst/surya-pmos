+/*
+ * C-PHY has no clock lane: the clock is embedded in each three-wire trio, so
+ * there is no clock enable bit and the trios enable the ODD bits of CTRL5
+ * (1, 3, 5), where D-PHY uses the even ones plus bit 7 for its clock.
+ *
+ * The tuning registers are a different set entirely (lane_regs_sm7150_cphy),
+ * and the settle count is programmed as two bytes instead of one.
+ */
+static void csiphy_sm7150_config_trios(struct csiphy_device *csiphy,
+				       struct csiphy_lanes_cfg *c,
+				       u16 settle_cnt)
+{
+	struct csiphy_device_regs *regs = csiphy->regs;
+	u8 lane_enable = 0;
+	unsigned int pos;
+	int i;
+
+	for (i = 0; i < c->num_data; i++)
+		lane_enable |= BIT(c->data[i].pos * 2 + 1);
+
+	writel_relaxed(lane_enable, csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
+	writel_relaxed(CSIPHY_3PH_CMN_CSI_COMMON_CTRL6_COMMON_PWRDN_B,
+		       csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 6));
+	writel_relaxed(0x02, csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 7));
+	writel_relaxed(0x02, csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 0));
+
+	for (pos = 0; pos < CSIPHY_7150_CPHY_LANES; pos++) {
+		bool usado = false;
+
+		for (i = 0; i < c->num_data; i++)
+			if (c->data[i].pos == pos)
+				usado = true;
+		if (!usado)
+			continue;
+
+		for (i = 0; i < CSIPHY_7150_CPHY_SETTINGS; i++) {
+			const struct csiphy_lane_regs *r =
+				&lane_regs_sm7150_cphy[pos][i];
+			u32 val;
+
+			switch (r->csiphy_param_type) {
+			case CSIPHY_SETTLE_CNT_LOWER_BYTE:
+				val = settle_cnt & 0xff;
+				break;
+			case CSIPHY_SETTLE_CNT_HIGHER_BYTE:
+				val = (settle_cnt >> 8) & 0xff;
+				break;
+			case CSIPHY_DNP_PARAMS:
+				continue;
+			default:
+				val = r->reg_data;
+				break;
+			}
+
+			writel_relaxed(val, csiphy->base + r->reg_addr);
+			if (r->delay_us)
+				udelay(r->delay_us);
+		}
+	}
+}
