 #endif /*_Q6_MVM_H */
diff --git a/sound/soc/qcom/qdsp6/q6voice-common.c b/sound/soc/qcom/qdsp6/q6voice-common.c
index e0a5e4eea..0dd138f82 100644
--- a/sound/soc/qcom/qdsp6/q6voice-common.c
+++ b/sound/soc/qcom/qdsp6/q6voice-common.c
@@ -167,6 +167,19 @@ static void q6voice_session_callback(struct q6voice_session *s,
 	struct aprv2_ibasic_rsp_result_t *result = data->payload;
 	unsigned long flags;
 
+	spin_lock_irqsave(&s->lock, flags);
+	if (s->resp_opcode && data->hdr.opcode == s->resp_opcode) {
+		size_t n = min_t(size_t, data->payload_size, sizeof(s->resp_data));
+
+		memcpy(s->resp_data, data->payload, n);
+		s->resp_opcode = 0;
+		s->expected_opcode = 0;
+		spin_unlock_irqrestore(&s->lock, flags);
+		wake_up(&s->wait);
+		return;
+	}
+	spin_unlock_irqrestore(&s->lock, flags);
+
 	if (data->hdr.opcode != APR_BASIC_RSP_RESULT)
 		return; /* Not handled here */
 
@@ -267,6 +280,53 @@ int q6voice_common_send(struct q6voice_session *s, struct apr_hdr *hdr)
 }
 EXPORT_SYMBOL_GPL(q6voice_common_send);
 
+int q6voice_common_send_resp(struct q6voice_session *s, struct apr_hdr *hdr,
+			      u32 resp_opcode, u32 *resp_data, size_t resp_words)
+{
+	unsigned long flags;
+	int ret;
+
+	hdr->hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+				       APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	hdr->src_port = s->port;
+	hdr->dest_port = s->handle;
+	hdr->token = 0;
+
+	spin_lock_irqsave(&s->lock, flags);
+	s->expected_opcode = hdr->opcode;
+	s->resp_opcode = resp_opcode;
+	s->result = 0;
+	spin_unlock_irqrestore(&s->lock, flags);
+
+	ret = apr_send_pkt(s->svc->adev, (struct apr_pkt *)hdr);
+	if (ret < 0) {
+		s->resp_opcode = 0;
+		return ret;
+	}
+
+	ret = wait_event_timeout(s->wait, (s->expected_opcode == 0),
+				 msecs_to_jiffies(TIMEOUT_MS));
+	if (!ret) {
+		s->expected_opcode = 0;
+		s->resp_opcode = 0;
+		return -ETIMEDOUT;
+	}
+
+	if (s->result > 0) {
+		dev_err(s->dev, "command %#x failed with error %d\n",
+			hdr->opcode, s->result);
+		return -EIO;
+	}
+
+	spin_lock_irqsave(&s->lock, flags);
+	memcpy(resp_data, s->resp_data,
+	       min_t(size_t, resp_words * sizeof(*resp_data), sizeof(s->resp_data)));
+	spin_unlock_irqrestore(&s->lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_common_send_resp);
+
 MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
 MODULE_DESCRIPTION("Q6Voice common session management");
 MODULE_LICENSE("GPL v2");
