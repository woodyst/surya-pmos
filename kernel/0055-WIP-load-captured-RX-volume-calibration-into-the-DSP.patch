diff --git a/sound/soc/qcom/qdsp6/q6cvp.c b/sound/soc/qcom/qdsp6/q6cvp.c
index fd0b5256e..63f77b56d 100644
--- a/sound/soc/qcom/qdsp6/q6cvp.c
+++ b/sound/soc/qcom/qdsp6/q6cvp.c
@@ -5,6 +5,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/soc/qcom/apr.h>
+#include <linux/string.h>
 #include "q6cvp.h"
 #include "q6voice-common.h"
 
@@ -167,6 +168,47 @@ int q6cvp_set_rx_volume(struct q6voice_session *cvp, u32 step)
 }
 EXPORT_SYMBOL_GPL(q6cvp_set_rx_volume);
 
+#define VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA	0x00011374
+#define MAX_COL_INFO_SIZE				324
+
+struct vss_ivocproc_cmd_register_volume_cal_data_t {
+	u32 cal_mem_handle;
+	u32 cal_mem_address_lsw;
+	u32 cal_mem_address_msw;
+	u32 cal_mem_size;
+	/*
+	 * Per-column overrides for the calibration table (regional/carrier
+	 * variants). We only have the plain captured table, no distinct
+	 * column data for it, so this is sent zeroed (num_columns = 0) -
+	 * confirmed against the downstream struct layout, not yet confirmed
+	 * that the DSP accepts an empty column list here.
+	 */
+	u8 column_info[MAX_COL_INFO_SIZE];
+} __packed;
+
+struct cvp_register_vol_cal_data_cmd {
+	struct apr_hdr hdr;
+	struct vss_ivocproc_cmd_register_volume_cal_data_t cvp_vol_cal_data;
+} __packed;
+
+int q6cvp_register_vol_cal(struct q6voice_session *cvp, u32 mem_handle,
+			   dma_addr_t phys, size_t size)
+{
+	struct cvp_register_vol_cal_data_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA;
+
+	cmd.cvp_vol_cal_data.cal_mem_handle = mem_handle;
+	cmd.cvp_vol_cal_data.cal_mem_address_lsw = lower_32_bits(phys);
+	cmd.cvp_vol_cal_data.cal_mem_address_msw = upper_32_bits(phys);
+	cmd.cvp_vol_cal_data.cal_mem_size = size;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_register_vol_cal);
+
 static int q6cvp_probe(struct apr_device *adev)
 {
 	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVP);
