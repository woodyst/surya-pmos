+#define WCN_BT_SCO_FORMATS	SNDRV_PCM_FMTBIT_S16_LE
+
+static struct snd_soc_dai_driver wcn_bt_slim_dais[] = {
+	{
+		.name = "wcn-bt-sco-rx",
+		.id = 0,
+		.playback = {
+			.stream_name = "BT SCO Playback",
+			.rates = WCN_BT_SCO_RATES,
+			.formats = WCN_BT_SCO_FORMATS,
+			.channels_min = 1,
+			.channels_max = 1,
