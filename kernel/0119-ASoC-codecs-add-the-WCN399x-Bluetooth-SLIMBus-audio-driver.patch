From: Eduardo Garcia-Madico Portabella <woodyst@gmail.com>
Date: Wed, 12 Aug 2026 17:30:00 +0200
Subject: [PATCH] ASoC: codecs: add the WCN399x Bluetooth SLIMBus audio driver

Bring wcn-bt-slim into the tree instead of building it out of tree.

The reason is not tidiness. CONFIG_MODVERSIONS is off here, so the only
thing checked at load time is the version string: an out-of-tree module
built against a different kernel is either rejected outright or, worse,
loaded with a mismatched ABI. It happened, and the symptom pointed
nowhere near the module -- Bluetooth call audio went silent while the
routing stayed structurally perfect (call profile active, eSCO up, sinks
RUNNING), and hours went into suspecting PipeWire suspension instead.

Built as a module and NOT autoloaded: on this platform the driver must
bind after the Bluetooth stack has taken the chip, so it stays
blacklisted and is loaded by hand once userspace is up. Building it in
does not change that.

The driver itself is unchanged, including .laddr_optional = true, which
keeps the ASoC component registered from the moment the module loads so
the sound card never waits on a codec that is repeatedly torn down.

--- a/sound/soc/codecs/Kconfig	2026-08-12 17:26:50.034927078 +0200
+++ b/sound/soc/codecs/Kconfig	2026-08-12 17:26:50.078259994 +0200
@@ -303,6 +303,7 @@
 	imply SND_SOC_WCD937X_SDW
 	imply SND_SOC_WCD938X_SDW
 	imply SND_SOC_WCD939X_SDW
+	imply SND_SOC_WCN_BT_SLIM
 	imply SND_SOC_LPASS_MACRO_COMMON
 	imply SND_SOC_LPASS_RX_MACRO
 	imply SND_SOC_LPASS_TX_MACRO
@@ -2478,6 +2479,22 @@
 	  The WCD9390/9395 is a audio codec IC Integrated in
 	  Qualcomm SoCs like SM8650.
 
+config SND_SOC_WCN_BT_SLIM
+	tristate "Qualcomm WCN399x Bluetooth audio over SLIMBus"
+	depends on SLIMBUS
+	help
+	  Say Y or M if you want to route Bluetooth call audio on a Qualcomm
+	  platform whose WCN399x combo chip is reached over SLIMBus.
+
+	  On these SoCs a circuit-switched call never crosses the CPU: the
+	  modem's vocoder and the audio DSP talk to each other directly, and
+	  the DSP reaches a Bluetooth headset over SLIMBus. This driver owns
+	  the far end of that link - it enumerates the chip and configures its
+	  SCO ports so the DSP's stream has somewhere to land.
+
+	  Without it a Bluetooth call is silent in both directions even though
+	  the routing looks perfectly healthy.
+
 config SND_SOC_WM0010
 	tristate
 	depends on SPI_MASTER
--- a/sound/soc/codecs/Makefile	2026-08-12 17:26:50.034927078 +0200
+++ b/sound/soc/codecs/Makefile	2026-08-12 17:27:04.061458573 +0200
@@ -361,6 +361,7 @@
 snd-soc-wcd938x-sdw-y := wcd938x-sdw.o
 snd-soc-wcd939x-y := wcd939x.o
 snd-soc-wcd939x-sdw-y := wcd939x-sdw.o
+snd-soc-wcn-bt-slim-y := wcn-bt-slim.o
 snd-soc-wm-adsp-y := wm_adsp.o
 snd-soc-wm-adsp-test-y := wm_adsp_fw_find_test.o
 snd-soc-wm0010-y := wm0010.o
@@ -808,6 +809,7 @@
 # avoid link failure by forcing sdw code built-in when needed
 obj-$(CONFIG_SND_SOC_WCD939X) += snd-soc-wcd939x-sdw.o
 endif
+obj-$(CONFIG_SND_SOC_WCN_BT_SLIM) += snd-soc-wcn-bt-slim.o
 obj-$(CONFIG_SND_SOC_WM0010)	+= snd-soc-wm0010.o
 obj-$(CONFIG_SND_SOC_WM1250_EV1) += snd-soc-wm1250-ev1.o
 obj-$(CONFIG_SND_SOC_WM2000)	+= snd-soc-wm2000.o
--- /dev/null	2026-07-30 22:00:07.076666674 +0200
+++ b/sound/soc/codecs/wcn-bt-slim.c	2026-08-12 17:26:50.044926982 +0200
@@ -0,0 +1,1507 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SLIMBus driver for the WCN399x's Bluetooth audio interface.
+ *
+ * On this SoC a circuit-switched call never crosses the CPU: the modem's
+ * vocoder and the audio DSP talk to each other directly, and the DSP reaches
+ * a Bluetooth headset over SLIMBus - port SLIMBUS_7 on the DSP side, and the
+ * WCN399x's own SCO ports on the other. This driver owns that far end: it
+ * enumerates the chip, and configures its ports so the DSP's stream has
+ * somewhere to land.
+ *
+ * The chip presents two SLIMBus devices, and both are needed:
+ *   - the interface device (IFD, device index 0), through which its registers
+ *     are read and written;
+ *   - the ported generic device (PGD, device index 1), which owns the audio
+ *     ports themselves.
+ *
+ * Modelled on the downstream btfm_slim driver, which is the only description
+ * of this hardware that exists.
+ */
+#include <linux/module.h>
+#include <linux/slimbus.h>
+#include <linux/workqueue.h>
+#include <linux/delay.h>
+#include <sound/pcm.h>
+#include <sound/soc.h>
+#include <sound/soc-dai.h>
+#include <linux/io.h>
+#include <linux/pm_runtime.h>
+#include <linux/debugfs.h>
+
+/*
+ * Registers, addressed through the interface device.
+ *
+ * The addresses below are the chip's own, and they all sit at an offset:
+ * downstream adds SLIM_SLAVE_REG_OFFSET to every access, and the WCN3990
+ * redefines that offset to 0x800. Reading the bare addresses instead lands
+ * 0x800 below the real map, where every byte reads back as zero - which looks
+ * exactly like a successful read of a chip that has nothing to say.
+ */
+#define WCN_SB_REG_OFFSET		0x0800
+
+#define WCN_SB_SLAVE_HW_REV_MSB		0x0001
+#define WCN_SB_SLAVE_HW_REV_LSB		0x0002
+#define WCN_SB_PGD_PORT_TX_CFGN(n)	(0x0050 + (n))
+#define WCN_SB_PGD_PORT_RX_CFGN(n)	(0x0040 + (n))
+#define WCN_SB_PGD_TX_PORTn_MULTI_CHNL_0(n)	(0x0100 + 4 * (n))
+#define WCN_SB_PGD_RX_PORTn_MULTI_CHNL_0(n)	(0x0180 + 4 * (n))
+#define WCN_SB_PGD_PORT_INT_EN_RX_0	0x0030
+#define WCN_SB_PGD_PORT_INT_EN_TX_0	0x0032
+#define WCN_SB_PGD_PORT_TX_OR_UR_CFGN(n)	(0x01F0 + (n))
+
+#define WCN_SB_PGD_PORT_ENABLE		BIT(0)
+/*
+ * Watermark: how full the port's FIFO gets before it asks the bus for
+ * service. The field is three bits wide starting at bit 1, so the value goes
+ * in shifted - a plain 0x18 lands on bits 3 and 4 instead, which is what was
+ * being written here and left the port configured with a watermark it never
+ * reaches. The vendor driver uses a deep watermark on the receiving port and a
+ * shallow one on the transmitting one.
+ */
+#define WCN_SB_PGD_PORT_WM(v)		((v) << 1)
+#define WCN_SB_PGD_PORT_WM_L1		WCN_SB_PGD_PORT_WM(0x1)
+#define WCN_SB_PGD_PORT_WM_LB		WCN_SB_PGD_PORT_WM(0xB)
+
+/* The transmitting port recovers from over/underrun on its own. */
+#define WCN_SB_ENABLE_OVERRUN_AUTO_RECOVERY	BIT(1)
+#define WCN_SB_ENABLE_UNDERRUN_AUTO_RECOVERY	BIT(0)
+
+/*
+ * The chip's own port numbering. SCO is what a phone call uses; the A2DP and
+ * FM ports exist too but nothing here needs them yet.
+ */
+#define WCN_PGD_PORT_TX_SCO		0
+#define WCN_PGD_PORT_RX_SCO		16
+
+/*
+ * Bus channel numbers for the chip, taken from downstream's machine driver
+ * (sm6150.c): the WCN gets 157/158 towards it and 159/160/161 back. A mono
+ * SCO call uses the first of each.
+ */
+#define WCN_SLIM_CH_RX_SCO		157
+#define WCN_SLIM_CH_TX_SCO		159
+
+/* The device index distinguishes the two devices sharing one product ID. */
+#define WCN_DEV_INDEX_IFD		0
+#define WCN_DEV_INDEX_PGD		1
+
+/*
+ * The bus manager only learns about the chip a moment after something first
+ * asks for its logical address - the first query is what sets enumeration
+ * going. Asking once and giving up finds nothing; downstream retries too.
+ */
+/*
+ * Attempts, not milliseconds: there is deliberately no delay between them
+ * (see the read path), so each costs about a millisecond and the whole loop
+ * is worth well under a second.
+ *
+ * The number comes from measurement: after a long idle the chip has taken up
+ * to 205 attempts to answer. Sixty - which was enough back when each attempt
+ * slept 20ms and the loop therefore spanned more than a second - leaves far
+ * too little room once the sleep is gone, and shows up as
+ * "write 0x0050 still failing after 60 tries".
+ */
+#define WCN_READ_TRIES			600
+
+#define WCN_LADDR_TRIES			20
+#define WCN_LADDR_POLL_MS		250
+
+struct wcn_bt_slim {
+	struct slim_device *ifd;
+	struct slim_device *pgd;
+	struct delayed_work laddr_work;
+	int tries;
+	bool ready;
+	/* Bus channels reserved while each direction is streaming. */
+	struct slim_stream_runtime *rx_stream;
+	struct slim_stream_runtime *tx_stream;
+};
+
+static struct wcn_bt_slim *wcn_bt;
+static DEFINE_MUTEX(wcn_bt_lock);
+
+/*
+ * Register access can come back short right after enumeration; downstream
+ * retries three times, 5ms apart, and so do we.
+ */
+/*
+ * Writes need the same treatment as reads: they land in the chip's quiet
+ * windows just as often, and there they are rejected outright.
+ */
+static int wcn_bt_slim_writeb_retry(struct slim_device *sdev, u32 addr, u8 val)
+{
+	int ret, tries;
+
+	for (tries = 0; tries < WCN_READ_TRIES; tries++) {
+		ret = slim_writeb(sdev, WCN_SB_REG_OFFSET + addr, val);
+		if (!ret)
+			return 0;
+		cond_resched();		/* see the note in the read path */
+	}
+
+	dev_err(&sdev->dev, "write 0x%04x still failing after %d tries\n",
+		addr, WCN_READ_TRIES);
+
+	return ret;
+}
+
+static int wcn_bt_slim_readb_via(struct slim_device *sdev, u32 addr)
+{
+	int ret, tries;
+
+	/*
+	 * The chip is only reachable in windows: measured over many cycles it
+	 * answers for a very regular ~1040 ms and then goes quiet for a few
+	 * hundred, so any single attempt has about a one in five chance of
+	 * landing in a gap. Retrying across one is all that is needed.
+	 *
+	 * This only became practical once rejected messages started failing
+	 * fast: while every miss cost a one second timeout, a loop long enough
+	 * to cross a gap would have taken half a minute.
+	 */
+	for (tries = 0; tries < WCN_READ_TRIES; tries++) {
+		ret = slim_readb(sdev, WCN_SB_REG_OFFSET + addr);
+		if (ret >= 0) {
+			if (tries)
+				dev_dbg(&sdev->dev, "read 0x%04x ok on try %d\n",
+					addr, tries);
+			return ret;
+		}
+		/*
+		 * Deliberately no delay between attempts. The chip only
+		 * answers while the bus is being driven continuously:
+		 * measured over 150 attempts it answers 41% of the time
+		 * back-to-back, 2% with a 5ms pause, and not at all with 50ms.
+		 * Sleeping "to be polite" here is what made this look, for
+		 * days, like a chip that never responds.
+		 */
+		cond_resched();
+	}
+
+	dev_err(&sdev->dev, "read 0x%04x still failing after %d tries\n",
+		addr, WCN_READ_TRIES);
+
+	return ret;
+}
+
+/*
+ * Downstream reads these through the interface device, but that times out
+ * here, so try the ported device too and report both - whichever answers is
+ * the one this chip actually wants.
+ */
+static int wcn_bt_slim_readb(struct wcn_bt_slim *wb, u32 addr)
+{
+	int via_ifd, via_pgd;
+
+	via_ifd = wcn_bt_slim_readb_via(wb->ifd, addr);
+	via_pgd = wcn_bt_slim_readb_via(wb->pgd, addr);
+
+	dev_info(&wb->pgd->dev, "reg 0x%04x: via IFD -> %d, via PGD -> %d\n",
+		 addr, via_ifd, via_pgd);
+
+	if (via_ifd >= 0)
+		return via_ifd;
+
+	return via_pgd;
+}
+
+static int wcn_bt_slim_read_hw_rev(struct wcn_bt_slim *wb)
+{
+	int msb, lsb;
+
+	msb = wcn_bt_slim_readb(wb, WCN_SB_SLAVE_HW_REV_MSB);
+	if (msb < 0)
+		return msb;
+
+	lsb = wcn_bt_slim_readb(wb, WCN_SB_SLAVE_HW_REV_LSB);
+	if (lsb < 0)
+		return lsb;
+
+	dev_info(&wb->ifd->dev, "WCN399x SLIMBus slave rev %u.%u step %u\n",
+		 (msb & 0xf0) >> 4, msb & 0x0f, lsb);
+
+	return 0;
+}
+
+/*
+ * Point one of the chip's ports at a bus channel and switch it on. The port
+ * configuration lives in the PGD but is written through the interface device,
+ * which is the only one that answers register access.
+ */
+static int wcn_bt_slim_port_enable(struct wcn_bt_slim *wb, u8 port, bool rx,
+				   u8 chan)
+{
+	u16 cfg_reg = rx ? WCN_SB_PGD_PORT_RX_CFGN(port - WCN_PGD_PORT_RX_SCO)
+			 : WCN_SB_PGD_PORT_TX_CFGN(port);
+	u16 chan_reg = rx ? WCN_SB_PGD_RX_PORTn_MULTI_CHNL_0(port - WCN_PGD_PORT_RX_SCO)
+			  : WCN_SB_PGD_TX_PORTn_MULTI_CHNL_0(port);
+	int ret;
+
+	ret = wcn_bt_slim_writeb_retry(wb->ifd, chan_reg, BIT(chan));
+	if (ret) {
+		dev_err(&wb->ifd->dev, "port %u: channel select failed: %d\n",
+			port, ret);
+		return ret;
+	}
+
+	if (!rx) {
+		ret = wcn_bt_slim_writeb_retry(wb->ifd,
+				WCN_SB_PGD_PORT_TX_OR_UR_CFGN(port),
+				WCN_SB_ENABLE_OVERRUN_AUTO_RECOVERY |
+				WCN_SB_ENABLE_UNDERRUN_AUTO_RECOVERY);
+		if (ret) {
+			dev_err(&wb->ifd->dev,
+				"port %u: auto-recovery setup failed: %d\n",
+				port, ret);
+			return ret;
+		}
+	}
+
+	ret = wcn_bt_slim_writeb_retry(wb->ifd, cfg_reg,
+			  WCN_SB_PGD_PORT_ENABLE |
+			  (rx ? WCN_SB_PGD_PORT_WM_LB : WCN_SB_PGD_PORT_WM_L1));
+	if (ret)
+		dev_err(&wb->ifd->dev, "port %u: enable failed: %d\n", port, ret);
+
+	return ret;
+}
+
+static int wcn_bt_slim_port_disable(struct wcn_bt_slim *wb, u8 port, bool rx)
+{
+	u16 cfg_reg = rx ? WCN_SB_PGD_PORT_RX_CFGN(port - WCN_PGD_PORT_RX_SCO)
+			 : WCN_SB_PGD_PORT_TX_CFGN(port);
+
+	return wcn_bt_slim_writeb_retry(wb->ifd, cfg_reg, 0);
+}
+
+/*
+ * Both devices have to be enumerated before anything can be said to the chip:
+ * the PGD owns the ports, the IFD carries the register traffic.
+ */
+static void wcn_bt_slim_laddr_work(struct work_struct *work)
+{
+	struct wcn_bt_slim *wb = container_of(to_delayed_work(work),
+					      struct wcn_bt_slim, laddr_work);
+	int ret;
+
+	mutex_lock(&wcn_bt_lock);
+
+	if (!wb->ifd || !wb->pgd)
+		goto retry;
+
+	ret = slim_get_logical_addr(wb->ifd);
+	if (ret)
+		goto retry;
+
+	ret = slim_get_logical_addr(wb->pgd);
+	if (ret)
+		goto retry;
+
+	dev_info(&wb->pgd->dev, "enumerated: pgd laddr 0x%02x, ifd laddr 0x%02x\n",
+		 wb->pgd->laddr, wb->ifd->laddr);
+
+	if (!wcn_bt_slim_read_hw_rev(wb))
+		wb->ready = true;
+
+	mutex_unlock(&wcn_bt_lock);
+	return;
+
+retry:
+	if (++wb->tries < WCN_LADDR_TRIES) {
+		schedule_delayed_work(&wb->laddr_work,
+				      msecs_to_jiffies(WCN_LADDR_POLL_MS));
+	} else {
+		dev_warn(wb->pgd ? &wb->pgd->dev : &wb->ifd->dev,
+			 "chip never showed up on the bus\n");
+	}
+
+	mutex_unlock(&wcn_bt_lock);
+}
+
+/*
+ * ASoC side: a DAI for the chip's SCO ports.
+ *
+ * This exists for the sake of *when* things happen, not just what. Downstream
+ * reaches the chip's registers from btfm_slim_dai_startup() - that is, while
+ * an audio stream is being brought up - and never from a quiet bus. Every
+ * register access tried here so far has been the other way round: bus idle,
+ * nothing playing, and universally NACKed.
+ *
+ * Registering a DAI lets the machine driver put this on the far end of the
+ * DSP's SLIMBUS_7 port, so starting a stream brings the DSP's side up first
+ * and then calls startup() here, reproducing the factory order for the first
+ * time.
+ */
+/*
+ * Reserve a channel on the bus for this stream.
+ *
+ * Enabling the chip's port and telling the DSP which channel to use is not
+ * enough: nobody had asked the bus manager to actually carry that channel, so
+ * the DSP's port had nowhere to put its samples and writing to the PCM came
+ * back as an I/O error. The stream API is what reserves it.
+ */
+/*
+ * Whether to reserve the channel from this side at all.
+ *
+ * The ADSP owns the bus master, so it may well be allocating the channel for
+ * its own port already; asking for the same channel from here would then be
+ * at best redundant. Kept switchable to find out which it is.
+ */
+static bool reservar = true;
+module_param(reservar, bool, 0644);
+MODULE_PARM_DESC(reservar, "reserve the bus channel from this side");
+
+static uint ch_rx = WCN_SLIM_CH_RX_SCO;
+module_param(ch_rx, uint, 0644);
+MODULE_PARM_DESC(ch_rx, "bus channel the chip listens on for SCO");
+
+static uint ch_tx = WCN_SLIM_CH_TX_SCO;
+module_param(ch_tx, uint, 0644);
+MODULE_PARM_DESC(ch_tx, "bus channel the chip sends its SCO microphone on");
+
+static int wcn_bt_slim_stream_start(struct snd_pcm_substream *substream,
+				    struct snd_soc_dai *dai, unsigned int rate)
+{
+	bool play = substream->stream == SNDRV_PCM_STREAM_PLAYBACK;
+	unsigned int ch = play ? ch_rx : ch_tx;
+	struct slim_stream_config cfg = {
+		.rate = rate,
+		.bps = 16,
+		.ch_count = 1,
+		.chs = &ch,
+		.port_mask = BIT(play ? WCN_PGD_PORT_RX_SCO : WCN_PGD_PORT_TX_SCO),
+		.direction = substream->stream,
+	};
+	struct slim_stream_runtime **slot = play ? &wcn_bt->rx_stream
+						 : &wcn_bt->tx_stream;
+	int ret;
+
+	if (*slot || !reservar)
+		return 0;
+
+	*slot = slim_stream_allocate(wcn_bt->pgd, play ? "SCO-rx" : "SCO-tx");
+	if (IS_ERR(*slot)) {
+		ret = PTR_ERR(*slot);
+		*slot = NULL;
+		dev_err(dai->dev, "stream allocate failed: %d\n", ret);
+		return ret;
+	}
+
+	ret = slim_stream_prepare(*slot, &cfg);
+	if (ret) {
+		dev_err(dai->dev, "stream prepare failed: %d\n", ret);
+		goto err;
+	}
+
+	ret = slim_stream_enable(*slot);
+	if (ret) {
+		dev_err(dai->dev, "stream enable failed: %d\n", ret);
+		slim_stream_unprepare(*slot);
+		goto err;
+	}
+
+	dev_info(dai->dev, "bus channel %u reserved for %s\n",
+		 ch, play ? "playback" : "capture");
+	return 0;
+
+err:
+	slim_stream_free(*slot);
+	*slot = NULL;
+	return ret;
+}
+
+static void wcn_bt_slim_stream_stop(struct snd_pcm_substream *substream)
+{
+	bool play = substream->stream == SNDRV_PCM_STREAM_PLAYBACK;
+	struct slim_stream_runtime **slot;
+
+	if (!wcn_bt)
+		return;
+
+	slot = play ? &wcn_bt->rx_stream : &wcn_bt->tx_stream;
+	if (!*slot)
+		return;
+
+	slim_stream_disable(*slot);
+	slim_stream_unprepare(*slot);
+	slim_stream_free(*slot);
+	*slot = NULL;
+}
+
+static int wcn_bt_slim_dai_startup(struct snd_pcm_substream *substream,
+				   struct snd_soc_dai *dai)
+{
+	int ret, val;
+
+	if (!wcn_bt || !wcn_bt->ifd || !wcn_bt->ifd->is_laddr_valid) {
+		dev_err(dai->dev, "chip not enumerated\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * Read a register from inside stream startup, which is the one context
+	 * that has never been tried. If the chip answers here and nowhere
+	 * else, then its interface is tied to the audio path being up.
+	 */
+	val = slim_readb(wcn_bt->ifd, WCN_SB_SLAVE_HW_REV_MSB);
+	dev_info(dai->dev, "startup: hw rev read -> %d\n", val);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		/*
+		 * Bit 0, not bit 1: the vendor driver selects the channel with
+		 * `1 << port`, and the SCO transmit port is port 0. Writing
+		 * bit 1 left the port pointing at a channel nothing was
+		 * carrying, and the capture came back as exact digital
+		 * silence while the receive direction worked fine.
+		 */
+		ret = wcn_bt_slim_port_enable(wcn_bt, WCN_PGD_PORT_TX_SCO,
+					      false, 0);
+	else
+		ret = wcn_bt_slim_port_enable(wcn_bt, WCN_PGD_PORT_RX_SCO,
+					      true, 0);
+	if (ret)
+		dev_err(dai->dev, "port setup failed: %d\n", ret);
+
+	/*
+	 * Do not fail the stream on that: the point here is to find out
+	 * whether the chip answers at all in this context.
+	 */
+	return 0;
+}
+
+static void wcn_bt_slim_dai_shutdown(struct snd_pcm_substream *substream,
+				     struct snd_soc_dai *dai)
+{
+	wcn_bt_slim_stream_stop(substream);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		wcn_bt_slim_port_disable(wcn_bt, WCN_PGD_PORT_TX_SCO, false);
+	else
+		wcn_bt_slim_port_disable(wcn_bt, WCN_PGD_PORT_RX_SCO, true);
+}
+
+/*
+ * Which bus channels this chip's SCO ports live on. The machine driver asks
+ * for these and hands them to the DSP: without them the ADSP refuses to
+ * enable its side of the port at all.
+ */
+static int wcn_bt_slim_get_channel_map(const struct snd_soc_dai *dai,
+				       unsigned int *tx_num, unsigned int *tx_slot,
+				       unsigned int *rx_num, unsigned int *rx_slot)
+{
+	if (dai->id == 0) {		/* playback: towards the headset */
+		if (!rx_slot || !rx_num)
+			return -EINVAL;
+		rx_slot[0] = ch_rx;
+		*rx_num = 1;
+	} else {			/* capture: the headset's microphone */
+		if (!tx_slot || !tx_num)
+			return -EINVAL;
+		tx_slot[0] = ch_tx;
+		*tx_num = 1;
+	}
+
+	return 0;
+}
+
+/*
+ * The same read again, but from prepare rather than startup.
+ *
+ * startup runs before the DSP has actually started its side of the port -
+ * that happens in prepare - so a read there still finds the bus idle, which
+ * is the very condition being tested. By the time this runs the ADSP's
+ * SLIMBUS_7 port is up, which is as close to the factory's ordering as this
+ * can get.
+ */
+static int wcn_bt_slim_dai_prepare(struct snd_pcm_substream *substream,
+				   struct snd_soc_dai *dai)
+{
+	int val;
+
+	if (!wcn_bt || !wcn_bt->ifd || !wcn_bt->ifd->is_laddr_valid)
+		return 0;
+
+	val = slim_readb(wcn_bt->ifd, WCN_SB_SLAVE_HW_REV_MSB);
+	dev_info(dai->dev, "prepare (DSP port up): hw rev read -> %d\n", val);
+
+	return 0;
+}
+
+/*
+ * Reserve the bus channel here, not in prepare.
+ *
+ * ALSA runs hw_params on every DAI before it runs prepare on any of them, and
+ * the DSP's own port is started from its prepare. Reserving from prepare left
+ * the channel arriving after the DSP had already started its side, and the
+ * port then never moved a single frame - the ADSP acknowledged everything and
+ * quietly sat there. Doing it from hw_params puts the channel on the bus
+ * first, which is the order the factory driver uses.
+ */
+static int wcn_bt_slim_dai_hw_params(struct snd_pcm_substream *substream,
+				     struct snd_pcm_hw_params *params,
+				     struct snd_soc_dai *dai)
+{
+	if (!wcn_bt || !wcn_bt->pgd || !wcn_bt->pgd->is_laddr_valid)
+		return 0;
+
+	return wcn_bt_slim_stream_start(substream, dai, params_rate(params));
+}
+
+static const struct snd_soc_dai_ops wcn_bt_slim_dai_ops = {
+	.startup = wcn_bt_slim_dai_startup,
+	.hw_params = wcn_bt_slim_dai_hw_params,
+	.prepare = wcn_bt_slim_dai_prepare,
+	.shutdown = wcn_bt_slim_dai_shutdown,
+	.get_channel_map = wcn_bt_slim_get_channel_map,
+};
