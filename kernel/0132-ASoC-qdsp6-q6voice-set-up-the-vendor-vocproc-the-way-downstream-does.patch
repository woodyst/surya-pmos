+/*
+ * Vendor vocproc setup, step by step (/sys/module/q6voice/parameters/vendor_steps,
+ * read when a vocproc is built). All off by default, which is what mainline did.
+ *
+ * The vendor's voice topologies (custom, registered with q6core custom_topologies;
+ * select them with q6cvp tx_topology/rx_topology and create_v3) need what the
+ * downstream voice_setup_vocproc() does between creating the vocproc and enabling
+ * it: channel info, a topology commit and the ACDB calibration. Media format goes
+ * after the attach. Each step logs what the DSP answered, and none of them stops
+ * the call. The Bluetooth headset path is left alone: its calibration was not
+ * captured and it uses the standard topologies.
+ */
+#define Q6VOICE_VENDOR_CHANNEL_INFO	BIT(0)
+#define Q6VOICE_VENDOR_TOPOLOGY_COMMIT	BIT(1)
+#define Q6VOICE_VENDOR_CALIBRATION	BIT(2)
+#define Q6VOICE_VENDOR_MEDIA_FORMAT	BIT(3)
+
+static uint vendor_steps;
+module_param(vendor_steps, uint, 0644);
+MODULE_PARM_DESC(vendor_steps,
+		 "vendor vocproc setup: 1 channel info, 2 topology commit, 4 calibration, 8 media format");
+
+/* Which calibration set: firmware qcom/sm7150/xiaomi/surya/voice-<cal_set>-*.bin */
+static char cal_set[32] = "handset";
+module_param_string(cal_set, cal_set, sizeof(cal_set), 0644);
+MODULE_PARM_DESC(cal_set, "voice calibration set (handset, speaker, handset-aec, speaker-aec)");
+
+/*
+ * The ACDB marks its tables per-vocoder (cal_hdr.version & 0x10000), and then
+ * downstream registers them with the STATIC/DYNAMIC opcodes instead of V2.
+ */
+static bool per_vocoder_cal = true;
+module_param(per_vocoder_cal, bool, 0644);
+MODULE_PARM_DESC(per_vocoder_cal, "register calibration with the per-vocoder STATIC/DYNAMIC opcodes");
+
+/* The vocproc sample rate the ACDB static tables were made for (48 kHz here) */
+static uint vendor_sample_rate = 48000;
+module_param(vendor_sample_rate, uint, 0644);
+MODULE_PARM_DESC(vendor_sample_rate, "sample rate sent with the endpoint media format");
+
+#define Q6VOICE_CAL_DIR				"qcom/sm7150/xiaomi/surya/"
+#define Q6VOICE_MAX_COL_INFO_SIZE		324
+#define Q6VOICE_PCM_CHANNEL_FC			3
+
+#define VSS_PARAM_VOCPROC_TX_CHANNEL_INFO	0x0001328E
+#define VSS_PARAM_VOCPROC_RX_CHANNEL_INFO	0x0001328F
+#define VSS_PARAM_VOCPROC_EC_REF_CHANNEL_INFO	0x00013290
+#define VSS_PARAM_TX_PORT_ENDPOINT_MEDIA_INFO	0x00013253
+#define VSS_PARAM_RX_PORT_ENDPOINT_MEDIA_INFO	0x00013254
+
+#define VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2		0x00011369
+#define VSS_ISTREAM_CMD_DEREGISTER_CALIBRATION_DATA		0x0001127A
+#define VSS_ISTREAM_CMD_REGISTER_STATIC_CALIBRATION_DATA	0x0001307D
+#define VSS_ISTREAM_CMD_DEREGISTER_STATIC_CALIBRATION_DATA	0x0001307E
+#define VSS_IVOCPROC_CMD_DEREGISTER_DEVICE_CONFIG		0x00011372
+#define VSS_IVOCPROC_CMD_REGISTER_CALIBRATION_DATA_V2		0x00011373
+#define VSS_IVOCPROC_CMD_DEREGISTER_CALIBRATION_DATA		0x00011276
+#define VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA		0x00011374
+#define VSS_IVOCPROC_CMD_DEREGISTER_VOL_CALIBRATION_DATA	0x00011375
+#define VSS_IVOCPROC_CMD_REGISTER_STATIC_CALIBRATION_DATA	0x00013079
+#define VSS_IVOCPROC_CMD_DEREGISTER_STATIC_CALIBRATION_DATA	0x0001307A
+#define VSS_IVOCPROC_CMD_REGISTER_DYNAMIC_CALIBRATION_DATA	0x0001307B
+#define VSS_IVOCPROC_CMD_DEREGISTER_DYNAMIC_CALIBRATION_DATA	0x0001307C
+
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX	0x400e
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX	0x400f
+
+enum { Q6VOICE_CAL_DEVCFG, Q6VOICE_CAL_STATIC, Q6VOICE_CAL_VOL,
+       Q6VOICE_CAL_STREAM, Q6VOICE_CAL_COUNT };
+static const char * const q6voice_cal_part[Q6VOICE_CAL_COUNT] = {
+	"devcfg", "static", "vol", "stream",
+};
+
+struct q6voice_cal_blob {
+	void *buf;
+	dma_addr_t dma;
+	size_t alloc, len;
+	u64 dsp;
+	u32 handle;
+	u8 col[Q6VOICE_MAX_COL_INFO_SIZE];
+	size_t col_len;
+};
+
+struct q6voice_cal {
+	struct device *dev;	/* the only audio node with an SMMU the DSP can reach */
+	int sid;
+	void *table;		/* vss_imemory_table_t, reused for every mapping */
+	dma_addr_t table_dma;
+	struct q6voice_cal_blob blob[Q6VOICE_CAL_COUNT];
+};
+
+static bool q6voice_path_is_bt(struct q6voice_path *p)
+{
+	return q6afe_get_port_id(p->tx_port) == AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX ||
+	       q6afe_get_port_id(p->rx_port) == AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX;
+}
+
+/* Same as q6asm-dai builds prtd->phys: the stream ID goes in the upper 32 bits */
+static u64 q6voice_dsp_addr(struct q6voice_cal *cal, dma_addr_t dma)
+{
+	return cal->sid < 0 ? dma : dma | ((u64)cal->sid << 32);
+}
+
+static struct device *q6voice_find_dsp_dev(int *sid)
+{
+	struct of_phandle_args args;
+	struct platform_device *pdev;
+	struct device_node *np;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,q6asm-dais");
+	if (!np)
+		return NULL;
+
+	if (of_parse_phandle_with_fixed_args(np, "iommus", 1, 0, &args)) {
+		*sid = -1;
+	} else {
+		*sid = args.args[0] & 0xF;
+		of_node_put(args.np);
+	}
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+
+	return pdev ? &pdev->dev : NULL;
+}
+
+/* Needs the MVM session still alive: the handles belong to it. */
+static void q6voice_cal_unload(struct q6voice_path *p)
+{
+	struct q6voice_session *mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	struct q6voice_cal *cal = p->runtime->cal;
+	int i, ret;
+
+	if (!cal)
+		return;
+
+	for (i = 0; i < Q6VOICE_CAL_COUNT; i++) {
+		struct q6voice_cal_blob *b = &cal->blob[i];
+
+		if (b->handle && mvm) {
+			ret = q6mvm_unmap_memory(mvm, b->handle);
+			if (ret)
+				dev_warn(p->v->dev, "unmap voice cal %s: %d\n",
+					 q6voice_cal_part[i], ret);
+		}
+		if (b->buf)
+			dma_free_coherent(cal->dev, b->alloc, b->buf, b->dma);
+	}
+	if (cal->table)
+		dma_free_coherent(cal->dev, PAGE_SIZE, cal->table, cal->table_dma);
+	if (cal->dev)
+		put_device(cal->dev);
+
+	kfree(cal);
+	p->runtime->cal = NULL;
+	p->runtime->cvs_cal = false;
+	p->runtime->cvp_cal = false;
+}
+
+static int q6voice_cal_load(struct q6voice_path *p)
+{
+	struct q6voice_session *mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	struct device *dev = p->v->dev;
+	const struct firmware *fw;
+	struct q6voice_cal *cal;
+	char name[96];
+	int i, ret;
+
+	if (p->runtime->cal)
+		return 0;
+	if (!mvm)
+		return -ENODEV;
+
+	cal = kzalloc(sizeof(*cal), GFP_KERNEL);
+	if (!cal)
+		return -ENOMEM;
+	p->runtime->cal = cal;
+
+	cal->dev = q6voice_find_dsp_dev(&cal->sid);
+	if (!cal->dev) {
+		ret = -ENODEV;
+		goto err;
+	}
+
+	/* page-sized: MAP_PHYSICAL refuses a table that is not page aligned */
+	cal->table = dma_alloc_coherent(cal->dev, PAGE_SIZE, &cal->table_dma,
+					GFP_KERNEL);
+	if (!cal->table) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	for (i = 0; i < Q6VOICE_CAL_COUNT; i++) {
+		struct q6voice_cal_blob *b = &cal->blob[i];
+		u32 *t = cal->table;
+
+		snprintf(name, sizeof(name), Q6VOICE_CAL_DIR "voice-%s-%s.bin",
+			 cal_set, q6voice_cal_part[i]);
+		ret = request_firmware(&fw, name, dev);
+		if (ret)
+			goto err;
+
+		b->len = fw->size;
+		b->alloc = PAGE_ALIGN(fw->size);
+		b->buf = dma_alloc_coherent(cal->dev, b->alloc, &b->dma, GFP_KERNEL);
+		if (!b->buf) {
+			release_firmware(fw);
+			ret = -ENOMEM;
+			goto err;
+		}
+		memcpy(b->buf, fw->data, fw->size);
+		release_firmware(fw);
+		b->dsp = q6voice_dsp_addr(cal, b->dma);
+
+		if (i != Q6VOICE_CAL_DEVCFG) {
+			snprintf(name, sizeof(name),
+				 Q6VOICE_CAL_DIR "voice-%s-%s-col.bin",
+				 cal_set, q6voice_cal_part[i]);
+			ret = request_firmware(&fw, name, dev);
+			if (ret)
+				goto err;
+			b->col_len = min_t(size_t, fw->size, sizeof(b->col));
+			memcpy(b->col, fw->data, b->col_len);
+			release_firmware(fw);
+		}
+
+		/* vss_imemory_table_t: no next table, one block */
+		memset(cal->table, 0, 6 * sizeof(u32));
+		t[3] = lower_32_bits(b->dsp);
+		t[4] = upper_32_bits(b->dsp);
+		t[5] = b->alloc;
+
+		ret = q6mvm_map_memory(mvm, q6voice_dsp_addr(cal, cal->table_dma),
+				       6 * sizeof(u32), &b->handle);
+		dev_info(dev, "voice cal %s-%s: %zu bytes at %#llx, handle %#x: %d\n",
+			 cal_set, q6voice_cal_part[i], b->len, b->dsp, b->handle, ret);
+		if (ret)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	dev_err(dev, "voice calibration %s not loaded: %d\n", cal_set, ret);
+	q6voice_cal_unload(p);
+	return ret;
+}
+
+static void q6voice_cal_register(struct q6voice_path *p)
+{
+	struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+	struct q6voice_session *cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	struct q6voice_cal *cal = p->runtime->cal;
+	struct device *dev = p->v->dev;
+	struct q6voice_cal_blob *b;
+	int ret;
+
+	if (!cal || !cvp)
+		return;
+
+	if (cvs && !p->runtime->cvs_cal) {
+		b = &cal->blob[Q6VOICE_CAL_STREAM];
+		ret = q6cvs_register_cal(cvs, per_vocoder_cal ?
+					 VSS_ISTREAM_CMD_REGISTER_STATIC_CALIBRATION_DATA :
+					 VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2,
+					 b->handle, b->dsp, b->len, b->col, b->col_len);
+		dev_info(dev, "register stream calibration: %d\n", ret);
+		p->runtime->cvs_cal = !ret;
+	}
+
+	b = &cal->blob[Q6VOICE_CAL_DEVCFG];
+	ret = q6cvp_register_dev_cfg(cvp, b->handle, b->dsp, b->len);
+	dev_info(dev, "register vocproc device config: %d\n", ret);
+
+	b = &cal->blob[Q6VOICE_CAL_STATIC];
+	ret = q6cvp_register_cal(cvp, per_vocoder_cal ?
+				 VSS_IVOCPROC_CMD_REGISTER_STATIC_CALIBRATION_DATA :
+				 VSS_IVOCPROC_CMD_REGISTER_CALIBRATION_DATA_V2,
+				 b->handle, b->dsp, b->len, b->col, b->col_len);
+	dev_info(dev, "register vocproc static calibration: %d\n", ret);
+
+	b = &cal->blob[Q6VOICE_CAL_VOL];
+	ret = q6cvp_register_cal(cvp, per_vocoder_cal ?
+				 VSS_IVOCPROC_CMD_REGISTER_DYNAMIC_CALIBRATION_DATA :
+				 VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA,
+				 b->handle, b->dsp, b->len, b->col, b->col_len);
+	dev_info(dev, "register vocproc volume calibration: %d\n", ret);
+
+	p->runtime->cvp_cal = true;
+}
+
+/* In the downstream order: volume, static, device config (and the stream last) */
+static void q6voice_cal_deregister_cvp(struct q6voice_path *p,
+				       struct q6voice_session *cvp)
+{
+	if (!p->runtime->cvp_cal || !cvp)
+		return;
+
+	q6cvp_deregister(cvp, per_vocoder_cal ?
+			 VSS_IVOCPROC_CMD_DEREGISTER_DYNAMIC_CALIBRATION_DATA :
+			 VSS_IVOCPROC_CMD_DEREGISTER_VOL_CALIBRATION_DATA);
+	q6cvp_deregister(cvp, per_vocoder_cal ?
+			 VSS_IVOCPROC_CMD_DEREGISTER_STATIC_CALIBRATION_DATA :
+			 VSS_IVOCPROC_CMD_DEREGISTER_CALIBRATION_DATA);
+	q6cvp_deregister(cvp, VSS_IVOCPROC_CMD_DEREGISTER_DEVICE_CONFIG);
+	p->runtime->cvp_cal = false;
+}
+
+static void q6voice_cal_deregister(struct q6voice_path *p)
+{
+	struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+	q6voice_cal_deregister_cvp(p, p->runtime->sessions[Q6VOICE_SERVICE_CVP]);
+
+	if (p->runtime->cvs_cal && cvs)
+		q6cvs_deregister_cal(cvs, per_vocoder_cal ?
+				     VSS_ISTREAM_CMD_DEREGISTER_STATIC_CALIBRATION_DATA :
+				     VSS_ISTREAM_CMD_DEREGISTER_CALIBRATION_DATA);
+	p->runtime->cvs_cal = false;
+}
+
+/* Between creating a vocproc and enabling it, as voice_setup_vocproc() */
+static void q6voice_vendor_setup(struct q6voice_path *p, struct q6voice_session *cvp)
+{
+	struct device *dev = p->v->dev;
+	int ret;
+
+	if (!vendor_steps || q6voice_path_is_bt(p))
+		return;
+
+	if (vendor_steps & Q6VOICE_VENDOR_CHANNEL_INFO) {
+		ret = q6cvp_set_channel_info(cvp, VSS_PARAM_VOCPROC_RX_CHANNEL_INFO,
+					     1, 16, Q6VOICE_PCM_CHANNEL_FC);
+		dev_info(dev, "vocproc rx channel info: %d\n", ret);
+		ret = q6cvp_set_channel_info(cvp, VSS_PARAM_VOCPROC_TX_CHANNEL_INFO,
+					     1, 16, Q6VOICE_PCM_CHANNEL_FC);
+		dev_info(dev, "vocproc tx channel info: %d\n", ret);
+		ret = q6cvp_set_channel_info(cvp, VSS_PARAM_VOCPROC_EC_REF_CHANNEL_INFO,
+					     1, 16, Q6VOICE_PCM_CHANNEL_FC);
+		dev_info(dev, "vocproc ec ref channel info: %d\n", ret);
+	}
+
+	if (vendor_steps & Q6VOICE_VENDOR_TOPOLOGY_COMMIT) {
+		ret = q6cvp_topology_commit(cvp);
+		dev_info(dev, "vocproc topology commit: %d\n", ret);
+	}
+
+	if (vendor_steps & Q6VOICE_VENDOR_CALIBRATION) {
+		if (!q6voice_cal_load(p))
+			q6voice_cal_register(p);
+	}
+}
+
+/* After the attach, as voice_setup_vocproc() does for CVD 2.3 */
+static void q6voice_vendor_media_format(struct q6voice_path *p,
+					struct q6voice_session *cvp)
+{
+	struct device *dev = p->v->dev;
+	int ret;
+
+	if (!(vendor_steps & Q6VOICE_VENDOR_MEDIA_FORMAT) || q6voice_path_is_bt(p))
+		return;
+
+	ret = q6cvp_set_endpoint_media_format(cvp, VSS_PARAM_RX_PORT_ENDPOINT_MEDIA_INFO,
+					      q6afe_get_port_id(p->rx_port), 1, 16,
+					      vendor_sample_rate,
+					      Q6VOICE_PCM_CHANNEL_FC);
+	dev_info(dev, "vocproc rx endpoint media format: %d\n", ret);
+	ret = q6cvp_set_endpoint_media_format(cvp, VSS_PARAM_TX_PORT_ENDPOINT_MEDIA_INFO,
+					      q6afe_get_port_id(p->tx_port), 1, 16,
+					      vendor_sample_rate,
+					      Q6VOICE_PCM_CHANNEL_FC);
+	dev_info(dev, "vocproc tx endpoint media format: %d\n", ret);
+}
+
