diff --git a/sound/soc/qcom/qdsp6/q6mvm.c b/sound/soc/qcom/qdsp6/q6mvm.c
index 57d6810dc..4e5dd4666 100644
--- a/sound/soc/qcom/qdsp6/q6mvm.c
+++ b/sound/soc/qcom/qdsp6/q6mvm.c
@@ -124,6 +124,83 @@ int q6mvm_start(struct q6voice_session *mvm, bool state)
 }
 EXPORT_SYMBOL_GPL(q6mvm_start);
 
+#define VSS_IMEMORY_CMD_MAP_PHYSICAL	0x00011334
+#define VSS_IMEMORY_RSP_MAP		0x00011336
+#define VSS_IMEMORY_CMD_UNMAP		0x00011337
+
+struct vss_imemory_cmd_map_physical_cmd {
+	struct apr_hdr hdr;
+	/* where the vss_imemory_table_t describing the memory lives */
+	u32 table_addr_lsw;
+	u32 table_addr_msw;
+	u32 table_size;
+	u8 is_cached;
+	u16 cache_line_size;
+	u32 access_mask;
+	u32 page_align;
+	u8 min_data_width;
+	u8 max_data_width;
+} __packed;
+
+struct vss_imemory_cmd_unmap_cmd {
+	struct apr_hdr hdr;
+	u32 mem_handle;
+} __packed;
+
+/*
+ * Map memory the voice services will read calibration from. The caller has
+ * already written the vss_imemory_table_t (next table descriptor, then one
+ * block) into DSP-visible memory at @table_addr.
+ *
+ * is_cached stays 0 although downstream sends 1: its buffers are ion
+ * allocations with explicit cache maintenance, ours come from
+ * dma_alloc_coherent(), and 1 crashed the ADSP when it was tried on this
+ * phone. Every other field is the downstream value.
+ */
+int q6mvm_map_memory(struct q6voice_session *mvm, u64 table_addr, u32 table_size,
+		     u32 *mem_handle)
+{
+	struct vss_imemory_cmd_map_physical_cmd cmd;
+	u32 resp[1] = {};
+	int ret;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IMEMORY_CMD_MAP_PHYSICAL;
+	cmd.table_addr_lsw = lower_32_bits(table_addr);
+	cmd.table_addr_msw = upper_32_bits(table_addr);
+	cmd.table_size = table_size;
+	cmd.is_cached = 0;
+	cmd.cache_line_size = 128;
+	cmd.access_mask = 3;
+	cmd.page_align = 4096;
+	cmd.min_data_width = 8;
+	cmd.max_data_width = 64;
+
+	ret = q6voice_common_send_resp(mvm, &cmd.hdr, VSS_IMEMORY_RSP_MAP,
+				       resp, ARRAY_SIZE(resp));
+	if (ret)
+		return ret;
+	if (!resp[0])
+		return -EIO;
+
+	*mem_handle = resp[0];
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6mvm_map_memory);
+
+int q6mvm_unmap_memory(struct q6voice_session *mvm, u32 mem_handle)
+{
+	struct vss_imemory_cmd_unmap_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IMEMORY_CMD_UNMAP;
+	cmd.mem_handle = mem_handle;
+
+	return q6voice_common_send(mvm, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6mvm_unmap_memory);
+
 static int q6mvm_probe(struct apr_device *adev)
 {
 	int ret;
diff --git a/sound/soc/qcom/qdsp6/q6mvm.h b/sound/soc/qcom/qdsp6/q6mvm.h
index 51279eddb..2512beaca 100644
--- a/sound/soc/qcom/qdsp6/q6mvm.h
+++ b/sound/soc/qcom/qdsp6/q6mvm.h
@@ -11,5 +11,8 @@ struct q6voice_session *q6mvm_session_create(enum q6voice_path_type path);
 int q6mvm_attach(struct q6voice_session *mvm, struct q6voice_session *cvp,
 		 bool state);
 int q6mvm_start(struct q6voice_session *mvm, bool state);
+int q6mvm_map_memory(struct q6voice_session *mvm, u64 table_addr, u32 table_size,
+		     u32 *mem_handle);
+int q6mvm_unmap_memory(struct q6voice_session *mvm, u32 mem_handle);
 
 #endif /*_Q6_MVM_H */
diff --git a/sound/soc/qcom/qdsp6/q6voice-common.c b/sound/soc/qcom/qdsp6/q6voice-common.c
index 63d136736..1b84990c7 100644
--- a/sound/soc/qcom/qdsp6/q6voice-common.c
+++ b/sound/soc/qcom/qdsp6/q6voice-common.c
@@ -191,6 +191,19 @@ static void q6voice_session_callback(struct q6voice_session *s,
 	struct aprv2_ibasic_rsp_result_t *result = data->payload;
 	unsigned long flags;
 
+	spin_lock_irqsave(&s->lock, flags);
+	if (s->resp_opcode && data->hdr.opcode == s->resp_opcode) {
+		size_t n = min_t(size_t, data->payload_size, sizeof(s->resp_data));
+
+		memcpy(s->resp_data, data->payload, n);
+		s->resp_opcode = 0;
+		s->expected_opcode = 0;
+		spin_unlock_irqrestore(&s->lock, flags);
+		wake_up(&s->wait);
+		return;
+	}
+	spin_unlock_irqrestore(&s->lock, flags);
+
 	if (data->hdr.opcode != APR_BASIC_RSP_RESULT)
 		return; /* Not handled here */
 
@@ -291,6 +304,54 @@ int q6voice_common_send(struct q6voice_session *s, struct apr_hdr *hdr)
 }
 EXPORT_SYMBOL_GPL(q6voice_common_send);
 
+int q6voice_common_send_resp(struct q6voice_session *s, struct apr_hdr *hdr,
+			     u32 resp_opcode, u32 *resp_data, size_t resp_words)
+{
+	unsigned long flags;
+	int ret;
+
+	hdr->hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+				       APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	hdr->src_port = s->port;
+	hdr->dest_port = s->handle;
+	hdr->token = 0;
+
+	spin_lock_irqsave(&s->lock, flags);
+	s->expected_opcode = hdr->opcode;
+	s->resp_opcode = resp_opcode;
+	s->result = 0;
+	memset(s->resp_data, 0, sizeof(s->resp_data));
+	spin_unlock_irqrestore(&s->lock, flags);
+
+	ret = apr_send_pkt(s->svc->adev, (struct apr_pkt *)hdr);
+	if (ret < 0) {
+		s->resp_opcode = 0;
+		return ret;
+	}
+
+	ret = wait_event_timeout(s->wait, (s->expected_opcode == 0),
+				 msecs_to_jiffies(TIMEOUT_MS));
+	if (!ret) {
+		s->expected_opcode = 0;
+		s->resp_opcode = 0;
+		return -ETIMEDOUT;
+	}
+
+	if (s->result > 0) {
+		dev_err(s->dev, "command %#x failed with error %d\n",
+			hdr->opcode, s->result);
+		return -EIO;
+	}
+
+	spin_lock_irqsave(&s->lock, flags);
+	memcpy(resp_data, s->resp_data,
+	       min_t(size_t, resp_words * sizeof(*resp_data), sizeof(s->resp_data)));
+	spin_unlock_irqrestore(&s->lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_common_send_resp);
+
