# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/gnome <achill@achill.org>"
pkgname=gnome-contacts
pkgver=50.0
# 2026-10-15: r100 (antes r2) al sumar 0003 (botón Llamar + estrella en la ficha), como en calls:
# que un `apk upgrade` de Alpine (r3..r99) no pise los parches. El 0003 es el mismo parche de
# spacewar (allí sobre 51.0), verificado aplicable sin conflictos sobre 50.0 + 0001 + 0002.
pkgrel=100
pkgdesc="A contacts manager for GNOME"
url="https://apps.gnome.org/Contacts"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	blueprint-compiler
	desktop-file-utils
	evolution-data-server-dev
	folks-dev
	glib-dev
	gnome-desktop-dev
	gnome-online-accounts-dev
	gstreamer-dev
	gtk4.0-dev
	libadwaita-dev
	libgee-dev
	libglycin-gtk4-dev
	libportal-dev
	libqrencode-dev
	meson
	telepathy-glib-dev
	vala
	"
checkdepends="appstream-glib"
subpackages="$pkgname-lang $pkgname-doc"
source="https://download.gnome.org/sources/gnome-contacts/${pkgver%%.*}/gnome-contacts-$pkgver.tar.xz
	0001-query-filter-decirle-a-gtk-si-el-filtro-es-mas-estricto.patch
	0002-store-filtrar-a-plazos-para-no-congelar-la-barra-de-busqueda.patch
	0003-contact-sheet-llamar-desde-ficha-y-estrella-favorito.patch
	"

build() {
	abuild-meson -Db_lto=true . output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

