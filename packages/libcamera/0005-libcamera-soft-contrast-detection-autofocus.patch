diff -urN virgen/libcamera-v0.7.1/src/ipa/simple/algorithms/af.cpp libcamera-v0.7.1/src/ipa/simple/algorithms/af.cpp
--- a/src/ipa/simple/algorithms/af.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/ipa/simple/algorithms/af.cpp	2026-08-07 12:05:58.446623887 +0200
@@ -0,0 +1,203 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus
+ *
+ * The software ISP has no focus algorithm, so a camera with a working focus
+ * actuator still takes blurred pictures unless the application drives the lens
+ * itself - and none of them do.
+ *
+ * Contrast detection can measure how good the current lens position is, but
+ * never which way the focus lies, so this climbs: it takes a step, compares the
+ * figure of merit with the previous position, keeps going while the picture
+ * improves, and on the first step that makes it worse turns around and halves
+ * the step. That visits far fewer positions than sweeping the range, and ends
+ * up finer, since the last steps are only a few codes wide.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &af = context.activeState.af;
+
+	af.available = false;
+	af.pending = false;
+	state_ = State::Idle;
+
+	const auto &controls = context.configuration.af.controls;
+	if (!controls.has_value()) {
+		LOG(IPASoftAf, Debug) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	min_ = controls->first;
+	max_ = controls->second;
+	if (max_ <= min_) {
+		LOG(IPASoftAf, Warning) << "Focus lens has an empty range";
+		return 0;
+	}
+
+	af.available = true;
+	af.min = min_;
+	af.max = max_;
+
+	/* Start from the middle: the climb can go either way from there. */
+	bestPosition_ = min_ + (max_ - min_) / 2;
+
+	LOG(IPASoftAf, Debug)
+		<< "Autofocus over " << min_ << "-" << max_;
+
+	startClimb(context);
+
+	return 0;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	auto &af = context.activeState.af;
+
+	position_ = std::clamp(position, min_, max_);
+	af.position = position_;
+	af.pending = true;
+	settle_ = 0;
+}
+
+void Af::startClimb(IPAContext &context)
+{
+	state_ = State::Climbing;
+	step_ = std::max<int32_t>((max_ - min_) / kInitialStepDivisor, kMinStep);
+	direction_ = 1;
+	havePrev_ = false;
+	prevFom_ = 0.0;
+	bestFom_ = 0.0;
+	measurements_ = 0;
+
+	moveTo(context, bestPosition_);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	auto &af = context.activeState.af;
+
+	if (!af.available || state_ == State::Idle)
+		return;
+
+	/*
+	 * Normalise by the frame's total luminance: the raw sum grows with
+	 * brightness, and the AGC keeps working while we focus, so an
+	 * unnormalised figure would rank a brighter frame above a sharper one.
+	 */
+	const uint64_t luminance = stats->sum_.r() + stats->sum_.g() + stats->sum_.b();
+	const double fom = luminance ? static_cast<double>(stats->sharpness) / luminance
+				     : 0.0;
+
+	if (state_ == State::Settled) {
+		if (cooldown_) {
+			cooldown_--;
+			return;
+		}
+
+		if (fom < settledFom_ * kRetriggerRatio)
+			lowCount_++;
+		else
+			lowCount_ = 0;
+
+		if (lowCount_ < kRetriggerFrames)
+			return;
+
+		LOG(IPASoftAf, Debug)
+			<< "Picture went soft (" << fom << " against "
+			<< settledFom_ << "), focusing again";
+
+		startClimb(context);
+		return;
+	}
+
+	/*
+	 * Give the lens time to travel and the pipeline time to deliver a frame
+	 * taken at the new position, or the comparison is against the wrong one.
+	 */
+	if (settle_ < kSettleFrames) {
+		settle_++;
+		return;
+	}
+
+	LOG(IPASoftAf, Debug)
+		<< "At " << position_ << ": fom " << fom
+		<< " (step " << step_ << ", dir " << direction_ << ")";
+
+	if (fom > bestFom_) {
+		bestFom_ = fom;
+		bestPosition_ = position_;
+	}
+
+	if (++measurements_ >= kMaxMeasurements) {
+		LOG(IPASoftAf, Warning)
+			<< "Autofocus gave up after " << measurements_
+			<< " measurements";
+		step_ = 0;
+	} else if (!havePrev_) {
+		/* First reading: nothing to compare against yet, just step. */
+		havePrev_ = true;
+	} else if (fom < prevFom_) {
+		/*
+		 * That step made things worse, so the peak is behind us: turn
+		 * around and look more closely.
+		 */
+		direction_ = -direction_;
+		step_ /= 2;
+	}
+
+	prevFom_ = fom;
+
+	if (step_ >= kMinStep) {
+		int32_t next = position_ + direction_ * step_;
+
+		/*
+		 * At the end of the lens' travel there is nowhere further to
+		 * go, so turn around and refine instead of pushing against it.
+		 */
+		if (next < min_ || next > max_) {
+			direction_ = -direction_;
+			step_ /= 2;
+			next = position_ + direction_ * step_;
+		}
+
+		if (step_ >= kMinStep) {
+			moveTo(context, next);
+			return;
+		}
+	}
+
+	moveTo(context, bestPosition_);
+	settledFom_ = bestFom_;
+	state_ = State::Settled;
+	cooldown_ = kCooldownFrames;
+	lowCount_ = 0;
+
+	LOG(IPASoftAf, Info)
+		<< "Autofocus settled at " << bestPosition_
+		<< " (fom " << bestFom_ << ") after " << measurements_
+		<< " measurements";
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff -urN virgen/libcamera-v0.7.1/src/ipa/simple/algorithms/af.h libcamera-v0.7.1/src/ipa/simple/algorithms/af.h
--- a/src/ipa/simple/algorithms/af.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/ipa/simple/algorithms/af.h	2026-08-07 12:05:30.713562491 +0200
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus
+ */
+
+#pragma once
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	/*
+	 * The climb starts with a step of this fraction of the lens range and
+	 * halves it on every reversal, so the search both covers ground quickly
+	 * and ends up finer than any fixed-size sweep could afford.
+	 */
+	static constexpr unsigned int kInitialStepDivisor = 8;
+	/* Stop once the step is this small: below it the lens does not move */
+	static constexpr int32_t kMinStep = 4;
+	/*
+	 * Frames to let pass after moving the lens before its statistics are
+	 * trusted: the move takes time, and the figure of merit that arrives
+	 * right after belongs to a frame that was already in flight.
+	 */
+	static constexpr unsigned int kSettleFrames = 3;
+	/*
+	 * Focus is only chased again once the picture has been clearly and
+	 * persistently worse than what the last climb achieved. Reacting to
+	 * small or brief drops would make the lens hunt on every wobble.
+	 */
+	static constexpr double kRetriggerRatio = 0.7;
+	static constexpr unsigned int kRetriggerFrames = 5;
+	/* Statistics to ignore after settling, so a climb cannot chain */
+	static constexpr unsigned int kCooldownFrames = 20;
+	/* Give up rather than climb forever on a noisy or featureless scene */
+	static constexpr unsigned int kMaxMeasurements = 40;
+
+	void startClimb(IPAContext &context);
+	void moveTo(IPAContext &context, int32_t position);
+
+	enum class State {
+		Idle,
+		Climbing,
+		Settled,
+	};
+
+	State state_ = State::Idle;
+	unsigned int settle_ = 0;
+	unsigned int measurements_ = 0;
+	unsigned int lowCount_ = 0;
+	unsigned int cooldown_ = 0;
+	int32_t min_ = 0;
+	int32_t max_ = 0;
+	int32_t step_ = 0;
+	int32_t direction_ = 1;
+	int32_t position_ = 0;
+	double prevFom_ = 0.0;
+	bool havePrev_ = false;
+	double bestFom_ = 0.0;
+	double settledFom_ = 0.0;
+	int32_t bestPosition_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
