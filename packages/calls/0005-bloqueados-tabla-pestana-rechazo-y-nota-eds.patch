+/* calls-blocked-box.c
+ *
+ * Copyright 2026 spacewar
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * spacewar (spec S3, odd/tasks/llamadas-contactos.md): la pestaña «Bloqueados»
+ * y el dialogo de bloqueo.
+ *
+ * Decisiones del usuario que viven aqui (Log L5):
+ *  - Desbloquear no borra: el interruptor deja la fila con su razon.
+ *  - Bloquear un numero que es de un contacto anade a sus observaciones (EDS)
+ *    la linea «Bloqueado en Llamadas (fecha): razon»; al desbloquear esa linea
+ *    se reescribe como «Desbloqueado (fecha): razon» (se conserva la info).
+ *  - El bloqueo es del numero exacto, no del contacto entero.
+ *
+ * Los textos nuevos van en espanol literal (Log L7): es un fork personal con
+ * la interfaz en espanol y sin .po propios.
+ */
+
+#define G_LOG_DOMAIN "CallsBlockedBox"
+
+#include "calls-config.h"
+
+#include "calls-blocked-box.h"
+#include "calls-blocked-store.h"
+#include "calls-contacts-provider.h"
+#include "calls-manager.h"
+
+#include <folks/folks.h>
+#include <gee-0.8/gee.h>
+
+#include <time.h>
+
+
+/* ------------------------- notas del contacto (EDS) ------------------- */
+
+/* Texto completo de las notas de un individuo (sus valores unidos por \n) y,
+ * de paso, el persona editable que las admite escritura, o NULL. */
+static char *
+collect_notes (FolksIndividual *individual,
+               FolksPersona   **editable_out)
+{
+  GString *text = g_string_new (NULL);
+  g_autoptr (GeeSet) personas = NULL;
+  GeeIterator *iter;
+
+  if (editable_out)
+    *editable_out = NULL;
+
+  /* En folks 0.16 «personas» es un GeeSet (era GeeList): se itera igual que
+   * los telefonos de find_individual_by_number. */
+  g_object_get (G_OBJECT (individual), "personas", &personas, NULL);
+  if (!personas)
+    return g_string_free (text, FALSE);
+
+  iter = gee_iterable_iterator (GEE_ITERABLE (personas));
+  while (gee_iterator_next (iter)) {
+    /* FolksAbstractPersona no tiene autoptr en este folks; FolksPersona si. */
+    g_autoptr (FolksPersona) persona = gee_iterator_get (iter);
+    gboolean read_only = TRUE;
+    GeeSet *notes;
+    GeeIterator *notes_iter;
+
+    if (!FOLKS_IS_PERSONA (persona))
+      continue;
+
+    g_object_get (G_OBJECT (persona), "read-only", &read_only, NULL);
+    if (read_only || !FOLKS_IS_NOTE_DETAILS (persona))
+      continue;
+
+    if (editable_out && !*editable_out)
+      *editable_out = FOLKS_PERSONA (g_object_ref (persona));
+
+    /* get_notes devuelve GeeSet (antes GList) prestado: solo se recorre. */
+    notes = folks_note_details_get_notes (FOLKS_NOTE_DETAILS (persona));
+    if (!notes)
+      continue;
+
+    notes_iter = gee_iterable_iterator (GEE_ITERABLE (notes));
+    while (gee_iterator_next (notes_iter)) {
+      g_autoptr (FolksNoteFieldDetails) note = gee_iterator_get (notes_iter);
+      g_autofree char *value = NULL;
+
+      if (!G_IS_OBJECT (note) ||
+          !g_object_class_find_property (G_OBJECT_GET_CLASS (note), "value"))
+        continue;
+
+      g_object_get (G_OBJECT (note), "value", &value, NULL);
+      if (value && *value) {
+        if (text->len)
+          g_string_append_c (text, '\n');
+        g_string_append (text, value);
+      }
+    }
+    g_clear_object (&notes_iter);
+  }
+  g_clear_object (&iter);
+
+  return g_string_free (text, FALSE);
+}
+
+
+/* folks 0.16 quito Folks.Persona.commit(): lo que persiste los cambios del
+ * backend es el flush de la persona-store. Si falla, aviso y sigo: la tabla de
+ * bloqueos es lo canonico (spec S3). */
+static void
+flush_cb (GObject      *store,
+          GAsyncResult *res,
+          gpointer      unused)
+{
+  /* flush_finish es void en este folks: no propaga error; si huele mal ya lo
+   * avisara el backend por su cuenta. */
+  folks_persona_store_flush_finish (FOLKS_PERSONA_STORE (store), res);
+}
+
+
+static gboolean
+write_notes (FolksPersona *persona,
+             const char   *text)
+{
+  /* set_notes pide GeeSet<NoteFieldDetails> (en C era GList en folks viejos).
+   * gee_hash_set_new quiere las 9 funciones del constructor Vala: con todo
+   * NULL se queda con hash/igualdad de puntero, suficiente para un set de
+   * una sola entrada. */
+  g_autoptr (GeeSet) notes = (GeeSet *) gee_hash_set_new (FOLKS_TYPE_NOTE_FIELD_DETAILS,
+                                                          NULL, NULL, NULL, NULL,
+                                                          NULL, NULL, NULL, NULL);
+  g_autoptr (FolksNoteFieldDetails) field = NULL;
+  FolksPersonaStore *store;
+
+  /* FolksNoteFieldDetails comparte con los demas FieldDetails la propiedad
+   * «value»; construirla por g_object_new evita depender del constructor. */
+  field = g_object_new (FOLKS_TYPE_NOTE_FIELD_DETAILS, "value", text, NULL);
+  gee_abstract_collection_add (GEE_ABSTRACT_COLLECTION (notes),
+                               g_object_ref (field));
+
+  folks_note_details_set_notes (FOLKS_NOTE_DETAILS (persona), notes);
+
+  store = folks_persona_get_store (persona);
+  if (store)
+    folks_persona_store_flush (store, flush_cb, NULL);
+  else
+    g_warning ("El contacto no tiene almacen donde guardar la nota de bloqueo");
+
+  return TRUE;
+}
+
+
+/* Busca el individuo con un numero igual (normalizado o crudo). Prestado:
+ * coleccion vivo del agregador, usar sin guardar. */
+static FolksIndividual *
+find_individual_by_number (const char *number)
+{
+  CallsContactsProvider *provider;
+  g_autoptr (GeeCollection) individuals = NULL;
+  GeeIterator *iter;
+  g_autofree char *normalized = calls_blocked_normalize (number);
+
+  provider = calls_manager_get_contacts_provider (calls_manager_get_default ());
+  if (!provider)
+    return NULL;
+
+  individuals = calls_contacts_provider_get_individuals (provider);
+  if (!individuals)
+    return NULL;
+
+  iter = gee_iterable_iterator (GEE_ITERABLE (individuals));
+  while (gee_iterator_next (iter)) {
+    g_autoptr (FolksIndividual) individual = gee_iterator_get (iter);
+    g_autoptr (GeeSet) phones = NULL;
+    GeeIterator *phone_iter;
+
+    g_object_get (G_OBJECT (individual), "phone-numbers", &phones, NULL);
+    if (!phones)
+      continue;
+
+    phone_iter = gee_iterable_iterator (GEE_ITERABLE (phones));
+    while (gee_iterator_next (phone_iter)) {
+      g_autoptr (FolksAbstractFieldDetails) detail = gee_iterator_get (phone_iter);
+      g_autofree char *raw = NULL;
+      g_autofree char *norm = NULL;
+      gboolean match = FALSE;
+
+      if (!FOLKS_IS_PHONE_FIELD_DETAILS (detail))
+        continue;
+
+      g_object_get (G_OBJECT (detail), "value", &raw, NULL);
+      if (raw && g_strcmp0 (raw, number) == 0)
+        match = TRUE;
+
+      if (!match && normalized) {
+        norm = calls_blocked_normalize (raw);
+        if (norm && g_strcmp0 (norm, normalized) == 0)
+          match = TRUE;
+      }
+
+      if (match) {
+        g_clear_object (&phone_iter);
+        return g_object_ref (individual);
+      }
+    }
+    g_clear_object (&phone_iter);
+  }
+
+  return NULL;
+}
+
+
+static char *
+today (void)
+{
+  g_autoptr (GDate) date = g_date_new ();
+  g_autofree char *buffer = g_malloc (16);
+
+  g_date_set_time_t (date, time (NULL));
+  /* g_date_strftime devuelve numero de bytes, no la cadena. */
+  if (g_date_strftime (buffer, 16, "%x", date))
+    g_strchomp (buffer);
+  return g_steal_pointer (&buffer);
+}
+
+
+/* Anade la linea de bloqueo a las observaciones del contacto, si el numero es
+ * de alguno. */
+static void
+annotate_contact_blocked (const char *number,
+                          const char *reason)
+{
+  g_autoptr (FolksIndividual) individual = find_individual_by_number (number);
+  g_autoptr (FolksPersona) persona = NULL;
+  g_autofree char *existing = NULL;
+  g_autofree char *date = NULL;
+  g_autofree char *text = NULL;
+
+  if (!individual)
+    return;
+
+  existing = collect_notes (individual, &persona);
+  if (!persona) {
+    g_debug ("Contacto de %s sin backend de notas editable", number);
+    return;
+  }
+
+  date = today ();
+  if (existing && *existing)
+    text = g_strdup_printf ("%s\nBloqueado en Llamadas (%s): %s",
+                            existing, date,
+                            reason && *reason ? reason : "(sin razon)");
+  else
+    text = g_strdup_printf ("Bloqueado en Llamadas (%s): %s",
+                            date,
+                            reason && *reason ? reason : "(sin razon)");
+
+  write_notes (persona, text);
+}
+
+
+/* Al desbloquear: la ultima linea nuestra «Bloqueado en Llamadas (...)» pasa a
+ * «Desbloqueado (fecha de hoy): ...» conservando la razon (decision L5). */
+static void
+annotate_contact_unblocked (const char *number)
+{
+  g_autoptr (FolksIndividual) individual = find_individual_by_number (number);
+  g_autoptr (FolksPersona) persona = NULL;
+  g_autofree char *existing = NULL;
+  g_autofree char *date = NULL;
+  g_auto (GStrv) lines = NULL;
+  GString *text;
+  int target_line = -1;
+
+  if (!individual)
+    return;
+
+  existing = collect_notes (individual, &persona);
+  if (!persona || !existing)
+    return;
+
+  lines = g_strsplit (existing, "\n", -1);
+  for (int i = g_strv_length (lines) - 1; i >= 0; i--) {
+    if (g_str_has_prefix (lines[i], "Bloqueado en Llamadas (")) {
+      target_line = i;
+      break;
+    }
+  }
+
+  if (target_line < 0)
+    return;
+
+  date = today ();
+  text = g_string_new (NULL);
+  for (int i = 0; lines[i]; i++) {
+    if (i)
+      g_string_append_c (text, '\n');
+
+    if (i == target_line) {
+      const char *colon = strstr (lines[i], "): ");
+      g_string_append_printf (text, "Desbloqueado (%s): %s",
+                              date,
+                              colon ? colon + 3 : "");
+    } else {
+      g_string_append (text, lines[i]);
+    }
+  }
+
+  write_notes (persona, text->str);
+  g_string_free (text, TRUE);
+}
+
+
+/* ------------------------------ pestaña -------------------------------- */
+
+struct _CallsBlockedBox {
+  AdwBin    parent_instance;
+
+  GtkWidget *group;
+  GList    *rows;
+};
+
+G_DEFINE_TYPE (CallsBlockedBox, calls_blocked_box, ADW_TYPE_BIN)
+
+
+static void
+clear_rows (CallsBlockedBox *self)
+{
+  for (GList *l = self->rows; l; l = l->next)
+    adw_preferences_group_remove (ADW_PREFERENCES_GROUP (self->group),
+                                  GTK_WIDGET (l->data));
+
+  g_list_free (self->rows);
+  self->rows = NULL;
+}
+
+
+static gboolean
+blocked_switch_state_set_cb (GtkSwitch       *switch_,
+                             gboolean         state,
+                             CallsBlockedBox *self)
+{
+  CallsBlockedNumber *entry = g_object_get_data (G_OBJECT (switch_), "entry");
+
+  if (!entry)
+    return FALSE;
+
+  calls_blocked_store_set_blocked (calls_blocked_store_get_default (),
+                                   entry, state);
+
+  if (!state) {
+    g_autofree char *number = NULL;
+
+    g_object_get (G_OBJECT (entry), "number", &number, NULL);
+    if (number)
+      annotate_contact_unblocked (number);
+  }
+
+  /* El modelo se reconstruye con la senal "changed" del almacen. */
+  return TRUE;
+}
+
+
+static void
+remove_button_clicked_cb (GtkButton *button,
+                          gpointer   unused)
+{
+  CallsBlockedNumber *entry = g_object_get_data (G_OBJECT (button), "entry");
+
+  if (entry)
+    calls_blocked_store_remove (calls_blocked_store_get_default (), entry);
+}
+
+
+static GtkWidget *
+build_row (CallsBlockedNumber *entry)
+{
+  g_autofree char *number = NULL;
+  g_autofree char *label = NULL;
+  g_autofree char *description = NULL;
+  gboolean blocked = FALSE;
+  gint64 added = 0;
+  GtkWidget *row;
+  GtkWidget *switch_;
+  GtkWidget *trash;
+
+  g_object_get (G_OBJECT (entry),
+                "number", &number,
+                "label", &label,
+                "description", &description,
+                "blocked", &blocked,
+                "added", &added,
+                NULL);
+
+  row = adw_action_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row),
+                                 (label && *label) ? label : number);
+
+  {
+    g_autoptr (GDateTime) dt = g_date_time_new_from_unix_local (added);
+    g_autofree char *date = dt ? g_date_time_format (dt, "%x") : g_strdup ("?");
+    const char *why = (description && *description) ? description : "(sin razón)";
+    g_autofree char *subtitle = NULL;
+
+    if (label && *label)
+      subtitle = g_strdup_printf ("%s · Razón: %s · %s", number, why, date);
+    else
+      subtitle = g_strdup_printf ("Razón: %s · %s", why, date);
+
+    adw_action_row_set_subtitle (ADW_ACTION_ROW (row), subtitle);
+  }
+
+  /* AdwSwitch ya no existe en libadwaita 1.10 (se quedo con AdwSwitchRow, que
+   * es una fila entera y no encaja con el boton de borrado): GtkSwitch, que si
+   * esta y en GTK 4.24 luce igual. */
+  switch_ = gtk_switch_new ();
+  gtk_widget_set_valign (switch_, GTK_ALIGN_CENTER);
+  gtk_switch_set_active (GTK_SWITCH (switch_), blocked);
+  g_object_set_data_full (G_OBJECT (switch_), "entry",
+                          g_object_ref (entry), g_object_unref);
+  g_signal_connect (switch_, "state-set",
+                    G_CALLBACK (blocked_switch_state_set_cb), NULL);
+  adw_action_row_add_suffix (ADW_ACTION_ROW (row), switch_);
+
+  trash = gtk_button_new_from_icon_name ("user-trash-symbolic");
+  gtk_widget_set_valign (trash, GTK_ALIGN_CENTER);
+  gtk_widget_add_css_class (trash, "flat");
+  gtk_widget_add_css_class (trash, "destructive-action");
+  g_object_set_data_full (G_OBJECT (trash), "entry",
+                          g_object_ref (entry), g_object_unref);
+  /* El boton solo necesita su entrada; la pestana no interviene. */
+  g_signal_connect (trash, "clicked",
+                    G_CALLBACK (remove_button_clicked_cb), NULL);
+  adw_action_row_add_suffix (ADW_ACTION_ROW (row), trash);
+
+  return row;
+}
+
+
+static void
+rebuild_rows (CallsBlockedBox *self)
+{
+  GListModel *model;
+  guint n;
+
+  clear_rows (self);
+
+  model = G_LIST_MODEL (calls_blocked_store_get_model (calls_blocked_store_get_default ()));
+  n = g_list_model_get_n_items (model);
+
+  for (guint i = 0; i < n; i++) {
+    g_autoptr (CallsBlockedNumber) entry = g_list_model_get_item (model, i);
+    GtkWidget *row;
+
+    row = build_row (entry);
+    adw_preferences_group_add (ADW_PREFERENCES_GROUP (self->group), row);
+    self->rows = g_list_append (self->rows, row);
+  }
+}
+
+
+/* Conectada con G_CONNECT_SWAPPED: el primer parametro es la pestana. */
+static void
+add_button_clicked_cb (CallsBlockedBox *self)
+{
+  calls_blocked_dialog_present (GTK_WIDGET (self), NULL, NULL);
+}
+
+
+static void
+store_changed_cb (CallsBlockedBox *self)
+{
+  rebuild_rows (self);
+}
+
+
+static void
+calls_blocked_box_finalize (GObject *object)
+{
+  CallsBlockedBox *self = CALLS_BLOCKED_BOX (object);
+
+  g_list_free (self->rows);
+  self->rows = NULL;
+
+  G_OBJECT_CLASS (calls_blocked_box_parent_class)->finalize (object);
+}
+
+
+static void
+calls_blocked_box_class_init (CallsBlockedBoxClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = calls_blocked_box_finalize;
+}
+
+
+static void
+calls_blocked_box_init (CallsBlockedBox *self)
+{
+  GtkWidget *scrolled;
+  GtkWidget *clamp;
+  GtkWidget *outer;
+  GtkWidget *add_button;
+
+  scrolled = gtk_scrolled_window_new ();
+  gtk_widget_set_vexpand (scrolled, TRUE);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER,
+                                  GTK_POLICY_AUTOMATIC);
+
+  clamp = adw_clamp_new ();
+  adw_clamp_set_maximum_size (ADW_CLAMP (clamp), 600);
+  /* adw_clamp_set_margin ya no esta en libadwaita 1.10: margen por el widget. */
+  gtk_widget_set_margin_start (outer, 12);
+  gtk_widget_set_margin_end (outer, 12);
+  gtk_widget_set_margin_top (outer, 12);
+  gtk_widget_set_margin_bottom (outer, 12);
+  gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scrolled), clamp);
+
+  outer = gtk_box_new (GTK_ORIENTATION_VERTICAL, 12);
+
+  add_button = gtk_button_new_with_label ("Añadir número bloqueado");
+  gtk_widget_set_halign (add_button, GTK_ALIGN_START);
+  gtk_widget_add_css_class (add_button, "pill");
+  g_signal_connect_swapped (add_button, "clicked",
+                            G_CALLBACK (add_button_clicked_cb), self);
+  gtk_box_append (GTK_BOX (outer), add_button);
+
+  self->group = adw_preferences_group_new ();
+  gtk_box_append (GTK_BOX (outer), self->group);
+
+  adw_clamp_set_child (ADW_CLAMP (clamp), outer);
+  adw_bin_set_child (ADW_BIN (self), scrolled);
+
+  /* Las filas se rehacen con cada cambio del almacen (anadido, interruptor,
+   * borrado): son cuatro gatos, no merece la pena afinar mas. */
+  g_signal_connect_object (calls_blocked_store_get_default (),
+                           "changed",
+                           G_CALLBACK (store_changed_cb),
+                           self, G_CONNECT_SWAPPED);
+
+  /* El almacen puede terminar de cargar despues de abrir la pestaña; el
+   * "changed" de la carga reconstruye. Reconstruccion inicial por si acaso. */
+  rebuild_rows (self);
+}
+
+
+GtkWidget *
+calls_blocked_box_new (void)
+{
+  return g_object_new (CALLS_TYPE_BLOCKED_BOX, NULL);
+}
+
+
+/* ------------------------------ dialogo -------------------------------- */
+
+static void
+dialog_confirm_clicked_cb (GtkButton *button,
+                           gpointer   dialog)
+{
+  GtkWidget *number_entry = g_object_get_data (G_OBJECT (dialog), "number-row");
+  GtkWidget *reason_entry = g_object_get_data (G_OBJECT (dialog), "reason-row");
+  const char *number;
+  const char *reason;
+
+  /* AdwEntryRow se quedo sin API C del texto en libadwaita 1.10: GtkEntry a
+   * secas, cuya texto es gtk_editable_get_text(). */
+  number = gtk_editable_get_text (GTK_EDITABLE (number_entry));
+  reason = gtk_editable_get_text (GTK_EDITABLE (reason_entry));
+
+  if (!number || !*number)
+    return;
+
+  calls_blocked_store_add (calls_blocked_store_get_default (),
+                           number,
+                           g_object_get_data (G_OBJECT (dialog), "label"),
+                           reason);
+
+  annotate_contact_blocked (number, reason);
+
+  adw_dialog_close (ADW_DIALOG (dialog));
+}
+
+
+void
+calls_blocked_dialog_present (GtkWidget  *parent_widget,
+                              const char *number,
+                              const char *label)
+{
+  GtkWidget *window;
+  GtkWidget *dialog;
+  GtkWidget *toolbar;
+  GtkWidget *header;
+  GtkWidget *confirm;
+  GtkWidget *clamp;
+  GtkWidget *box;
+  GtkWidget *entry;
+  GtkWidget *old;
+
+  window = GTK_WIDGET (gtk_widget_get_root (parent_widget));
+  g_return_if_fail (GTK_IS_WINDOW (window));
+
+  /* gtk_widget_destroy ya no esta en GTK 4.20+: en vez de destruir al cerrar,
+   * la ventana es la duena del ultimo dialogo (data con ref); al abrir otro se
+   * cierra y se suelta el anterior. */
+  old = g_object_get_data (G_OBJECT (window), "blocked-dialog");
+  if (old)
+    adw_dialog_close (ADW_DIALOG (old));
+
+  /* adw_dialog_new devuelve AdwDialog *, no GtkWidget *. */
+  dialog = GTK_WIDGET (adw_dialog_new ());
+  adw_dialog_set_title (ADW_DIALOG (dialog), "Bloquear número");
+
+  toolbar = adw_toolbar_view_new ();
+
+  header = adw_header_bar_new ();
+  confirm = gtk_button_new_with_label ("Bloquear");
+  gtk_widget_add_css_class (confirm, "suggested-action");
+  g_signal_connect (confirm, "clicked",
+                    G_CALLBACK (dialog_confirm_clicked_cb), dialog);
+  adw_header_bar_pack_end (ADW_HEADER_BAR (header), confirm);
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (toolbar), header);
+
+  clamp = adw_clamp_new ();
+  adw_clamp_set_maximum_size (ADW_CLAMP (clamp), 400);
+
+  box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_widget_set_margin_start (box, 18);
+  gtk_widget_set_margin_end (box, 18);
+  gtk_widget_set_margin_top (box, 18);
+  gtk_widget_set_margin_bottom (box, 18);
+
+  entry = gtk_label_new ("Número");
+  gtk_widget_set_halign (entry, GTK_ALIGN_START);
+  gtk_box_append (GTK_BOX (box), entry);
+
+  entry = gtk_entry_new ();
+  gtk_entry_set_input_purpose (GTK_ENTRY (entry), GTK_INPUT_PURPOSE_PHONE);
+  if (number)
+    gtk_editable_set_text (GTK_EDITABLE (entry), number);
+  g_object_set_data_full (G_OBJECT (dialog), "number-row",
+                          g_object_ref (entry), g_object_unref);
+  gtk_box_append (GTK_BOX (box), entry);
+
+  entry = gtk_label_new ("Razón");
+  gtk_widget_set_halign (entry, GTK_ALIGN_START);
+  gtk_widget_set_margin_top (entry, 6);
+  gtk_box_append (GTK_BOX (box), entry);
+
+  entry = gtk_entry_new ();
+  g_object_set_data_full (G_OBJECT (dialog), "reason-row",
+                          g_object_ref (entry), g_object_unref);
+  gtk_box_append (GTK_BOX (box), entry);
+
+  if (label && *label)
+    g_object_set_data_full (G_OBJECT (dialog), "label",
+                            g_strdup (label), g_free);
+
+  adw_clamp_set_child (ADW_CLAMP (clamp), box);
+  adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (toolbar), clamp);
+  adw_dialog_set_child (ADW_DIALOG (dialog), toolbar);
+
+  g_object_set_data_full (G_OBJECT (window), "blocked-dialog",
+                          g_object_ref_sink (dialog), g_object_unref);
+  adw_dialog_present (ADW_DIALOG (dialog), GTK_WIDGET (window));
+}
