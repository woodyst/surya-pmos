+                                                            gboolean           blocked);
+
+void               calls_blocked_store_remove              (CallsBlockedStore *self,
+                                                            CallsBlockedNumber *entry);
+
+/* Modelo (GeeList no; GListStore de CallsBlockedNumber) en orden de añadido,
+ * para la lista de la UI. */
+GListStore        *calls_blocked_store_get_model           (CallsBlockedStore *self);
+
+/* Normaliza un número para comparar/bloquear (E.PhoneNumber, region local).
+ * El resultado es nuevo y puede ser NULL si no se pudo parsear. */
+char              *calls_blocked_normalize                 (const char        *number);
+
+G_END_DECLS
