+/* calls-blocked-store.c
+ *
+ * Copyright 2026 spacewar
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * spacewar (spec S3, odd/tasks/llamadas-contactos.md): numeros bloqueados.
+ *
+ * BD propia (`blocked.db`) para no tocar el esquema de records.db: una tabla
+ * con el numero crudo, su forma normalizada, la etiqueta del contacto, la
+ * razon del bloqueo y un boolean para desactivarlo sin perder la informacion
+ * (decision del usuario: desbloquear conserva la fila). La caché en memoria
+ * hace que `is_blocked` sea barato en la ruta de llamada entrante; se abre al
+ * primer uso, que casi siempre es antes de que haya interfaz.
+ */
+
+#define G_LOG_DOMAIN "CallsBlockedStore"
+
+#include "calls-config.h"
+#include "calls-blocked-store.h"
+
+#include <gom/gom.h>
+#include <glib/gstdio.h>
+
+#include <errno.h>
+
+#include <libebook-contacts/libebook-contacts.h>
+
+
+#define BLOCKED_STORE_FILENAME "blocked.db"
+#define BLOCKED_STORE_VERSION  1
+
+/* ------------------------------------------------------------------ */
+/* CallsBlockedNumber: una fila de la tabla `blocked`                  */
+/* ------------------------------------------------------------------ */
+
+enum {
+  R_PROP_0,
+  R_PROP_ID,
+  R_PROP_NUMBER,
+  R_PROP_NORMALIZED,
+  R_PROP_LABEL,
+  R_PROP_DESCRIPTION,
+  R_PROP_BLOCKED,
+  R_PROP_ADDED,
+  R_PROP_LAST_PROP,
+};
+static GParamSpec *r_props[R_PROP_LAST_PROP];
+
+struct _CallsBlockedNumber {
+  GomResource  parent_instance;
+
+  guint        id;
+  gchar       *number;
+  gchar       *normalized;
+  gchar       *label;
+  gchar       *description;
+  gboolean     blocked;
+  gint64       added;
+};
+
+G_DEFINE_TYPE (CallsBlockedNumber, calls_blocked_number, GOM_TYPE_RESOURCE)
+
+
+static void
+calls_blocked_number_get_property (GObject    *object,
+                                   guint       prop_id,
+                                   GValue     *value,
+                                   GParamSpec *pspec)
+{
+  CallsBlockedNumber *self = CALLS_BLOCKED_NUMBER (object);
+
+  switch (prop_id) {
+  case R_PROP_ID:
+    g_value_set_uint (value, self->id);
+    break;
+
+  case R_PROP_NUMBER:
+    g_value_set_string (value, self->number);
+    break;
+
+  case R_PROP_NORMALIZED:
+    g_value_set_string (value, self->normalized);
+    break;
+
+  case R_PROP_LABEL:
+    g_value_set_string (value, self->label);
+    break;
+
+  case R_PROP_DESCRIPTION:
+    g_value_set_string (value, self->description);
+    break;
+
+  case R_PROP_BLOCKED:
+    g_value_set_boolean (value, self->blocked);
+    break;
+
+  case R_PROP_ADDED:
+    g_value_set_int64 (value, self->added);
+    break;
+
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+  }
+}
+
+
+static void
+calls_blocked_number_set_property (GObject      *object,
+                                   guint         prop_id,
+                                   const GValue *value,
+                                   GParamSpec   *pspec)
+{
+  CallsBlockedNumber *self = CALLS_BLOCKED_NUMBER (object);
+
+  switch (prop_id) {
+  case R_PROP_ID:
+    self->id = g_value_get_uint (value);
+    break;
+
+  case R_PROP_NUMBER:
+    g_set_str (&self->number, g_value_get_string (value));
+    break;
+
+  case R_PROP_NORMALIZED:
+    g_set_str (&self->normalized, g_value_get_string (value));
+    break;
+
+  case R_PROP_LABEL:
+    g_set_str (&self->label, g_value_get_string (value));
+    break;
+
+  case R_PROP_DESCRIPTION:
+    g_set_str (&self->description, g_value_get_string (value));
+    break;
+
+  case R_PROP_BLOCKED:
+    self->blocked = g_value_get_boolean (value);
+    break;
+
+  case R_PROP_ADDED:
+    self->added = g_value_get_int64 (value);
+    break;
+
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+  }
+}
+
+
+static void
+calls_blocked_number_finalize (GObject *object)
+{
+  CallsBlockedNumber *self = CALLS_BLOCKED_NUMBER (object);
+
+  g_clear_pointer (&self->number, g_free);
+  g_clear_pointer (&self->normalized, g_free);
+  g_clear_pointer (&self->label, g_free);
+  g_clear_pointer (&self->description, g_free);
+
+  G_OBJECT_CLASS (calls_blocked_number_parent_class)->finalize (object);
+}
+
+
+static void
+calls_blocked_number_class_init (CallsBlockedNumberClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GomResourceClass *resource_class = GOM_RESOURCE_CLASS (klass);
+
+  object_class->finalize = calls_blocked_number_finalize;
+  object_class->get_property = calls_blocked_number_get_property;
+  object_class->set_property = calls_blocked_number_set_property;
+
+  gom_resource_class_set_table (resource_class, "blocked");
+
+  r_props[R_PROP_ID] =
+    g_param_spec_uint ("id",
+                       "ID",
+                       "The row ID",
+                       0, G_MAXUINT, 0,
+                       G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_ID, r_props[R_PROP_ID]);
+  gom_resource_class_set_primary_key (resource_class, "id");
+
+  r_props[R_PROP_NUMBER] =
+    g_param_spec_string ("number",
+                         "Number",
+                         "The blocked number as it was stored",
+                         NULL,
+                         G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_NUMBER, r_props[R_PROP_NUMBER]);
+
+  r_props[R_PROP_NORMALIZED] =
+    g_param_spec_string ("normalized",
+                         "Normalized",
+                         "E.164 form of the number for comparing",
+                         NULL,
+                         G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_NORMALIZED, r_props[R_PROP_NORMALIZED]);
+
+  r_props[R_PROP_LABEL] =
+    g_param_spec_string ("label",
+                         "Label",
+                         "Name of the contact when known",
+                         NULL,
+                         G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_LABEL, r_props[R_PROP_LABEL]);
+
+  r_props[R_PROP_DESCRIPTION] =
+    g_param_spec_string ("description",
+                         "Description",
+                         "Why the number is blocked",
+                         NULL,
+                         G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_DESCRIPTION, r_props[R_PROP_DESCRIPTION]);
+
+  r_props[R_PROP_BLOCKED] =
+    g_param_spec_boolean ("blocked",
+                          "Blocked",
+                          "Whether the block is active (false keeps the row for history)",
+                          TRUE,
+                          G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_BLOCKED, r_props[R_PROP_BLOCKED]);
+
+  r_props[R_PROP_ADDED] =
+    g_param_spec_int64 ("added",
+                        "Added",
+                        "Epoch seconds of when the entry was created",
+                        G_MININT64, G_MAXINT64, 0,
+                        G_PARAM_READWRITE | G_PARAM_CONSTRUCT);
+  g_object_class_install_property (object_class, R_PROP_ADDED, r_props[R_PROP_ADDED]);
+}
+
+
+static void
+calls_blocked_number_init (CallsBlockedNumber *self)
+{
+}
+
+
+/* ------------------------------------------------------------------ */
+/* CallsBlockedStore                                                   */
+/* ------------------------------------------------------------------ */
+
+enum {
+  SIGNAL_CHANGED,
+  N_SIGNALS
+};
+static guint signals[N_SIGNALS];
+
+struct _CallsBlockedStore {
+  GObject        parent_instance;
+
+  gchar         *filename;
+  GomAdapter    *adapter;
+  GomRepository *repository;
+
+  /* Clave -> entrada. Cada entrada vive referenciada una vez por clave
+   * (cruda y normalizada) y otra en `model`. */
+  GHashTable    *cache;
+  GListStore    *model;
+
+  /* Guardas pendientes de BD porque todavia no habia repositorio abierto */
+  GList         *pending_saves;
+};
+
+G_DEFINE_TYPE (CallsBlockedStore, calls_blocked_store, G_TYPE_OBJECT);
+
+
+char *
+calls_blocked_normalize (const char *number)
+{
+  EPhoneNumber *parsed;
+  g_autofree char *e164 = NULL;
+
+  if (!number || !*number)
+    return NULL;
+
+  /* EDS nuevo: from_string(cadena, region, error); region NULL = la del locale
+   * (lo que antes era COUNTRY_CODE_LOCALREGION) — mismos numeros locales, mis-
+   * mo E.164. Y el E.164 ahora es to_string(FORMAT_E164), de propiedad. */
+  parsed = e_phone_number_from_string (number, NULL, NULL);
+  if (!parsed)
+    return NULL;
+
+  e164 = e_phone_number_to_string (parsed, E_PHONE_NUMBER_FORMAT_E164);
+  e_phone_number_free (parsed);
+  return g_steal_pointer (&e164);
+}
+
+
+/* Cada clave de la caché toma su propia referencia a la entrada: asi la caché
+ * es autonomica del modelo. Al borrar, `cache_remove` libera la de cada clave. */
+static void
+cache_insert (CallsBlockedStore  *self,
+              CallsBlockedNumber *entry)
+{
+  g_autofree char *raw = NULL;
+  g_autofree char *normalized = NULL;
+
+  g_object_get (G_OBJECT (entry),
+                "number", &raw,
+                "normalized", &normalized,
+                NULL);
+
+  if (!raw)
+    return;
+
+  g_hash_table_replace (self->cache, g_strdup (raw), g_object_ref (entry));
+  if (normalized && g_strcmp0 (normalized, raw) != 0)
+    g_hash_table_replace (self->cache, g_strdup (normalized), g_object_ref (entry));
+}
+
+
+static void
+cache_remove (CallsBlockedStore  *self,
+              CallsBlockedNumber *entry)
+{
+  g_autofree char *raw = NULL;
+  g_autofree char *normalized = NULL;
+
+  g_object_get (G_OBJECT (entry),
+                "number", &raw,
+                "normalized", &normalized,
+                NULL);
+
+  /* La misma entrada puede estar bajo dos claves: quitar las dos. */
+  if (raw)
+    g_hash_table_remove (self->cache, raw);
+  if (normalized)
+    g_hash_table_remove (self->cache, normalized);
+
+  /* Si sigue en la caché por otra clave idéntica, ya se ira al destruirse. */
+  (void) entry;
+}
+
+
+gboolean
+calls_blocked_store_is_blocked (CallsBlockedStore *self,
+                                const char        *number)
+{
+  CallsBlockedNumber *entry;
+  g_autofree char *normalized = NULL;
+
+  g_return_val_if_fail (CALLS_IS_BLOCKED_STORE (self), FALSE);
+
+  if (!number || !*number)
+    return FALSE;
+
+  entry = g_hash_table_lookup (self->cache, number);
+  if (!entry) {
+    normalized = calls_blocked_normalize (number);
+    if (normalized)
+      entry = g_hash_table_lookup (self->cache, normalized);
+  }
+
+  if (!entry)
+    return FALSE;
+
+  {
+    gboolean blocked = FALSE;
+
+    g_object_get (G_OBJECT (entry), "blocked", &blocked, NULL);
+    return blocked;
+  }
+}
+
+
+static void
+emit_changed (CallsBlockedStore *self)
+{
+  g_signal_emit (self, signals[SIGNAL_CHANGED], 0);
+}
+
+
+static void
+save_cb (GomResource       *resource,
+         GAsyncResult      *res,
+         CallsBlockedStore *self)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!gom_resource_save_finish (resource, res, &error)) {
+    g_warning ("No se pudo guardar el numero bloqueado: %s",
+               error ? error->message : "desconocido");
+    goto exit;
+  }
+
+exit:
+  g_object_unref (self);
+}
+
+
+static void
+remove_cb (GomResource       *resource,
+           GAsyncResult      *res,
+           CallsBlockedStore *self)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!gom_resource_delete_finish (resource, res, &error))
+    g_warning ("No se pudo borrar el numero bloqueado: %s",
+               error ? error->message : "desconocido");
+
+  g_object_unref (self);
+}
+
+
+static void
+flush_pending_saves (CallsBlockedStore *self)
+{
+  GList *l;
+
+  for (l = self->pending_saves; l; l = l->next) {
+    CallsBlockedNumber *entry = l->data;
+
+    /* gom nuevo: save_async(resource, callback, data), sin cancellable */
+    gom_resource_save_async (GOM_RESOURCE (entry),
+                             (GAsyncReadyCallback) save_cb,
+                             g_object_ref (self));
+  }
+
+  g_list_free_full (self->pending_saves, g_object_unref);
+  self->pending_saves = NULL;
+}
+
+
+void
+calls_blocked_store_add (CallsBlockedStore *self,
+                         const char        *number,
+                         const char        *label,
+                         const char        *description)
+{
+  CallsBlockedNumber *entry;
+  g_autofree char *normalized = NULL;
+
+  g_return_if_fail (CALLS_IS_BLOCKED_STORE (self));
+  g_return_if_fail (number && *number);
+
+  /* Evita filas dobles: si ya estaba (aunque estuviera desactivado), se
+   * reactiva y se actualizan razon y etiqueta. */
+  normalized = calls_blocked_normalize (number);
+  entry = g_hash_table_lookup (self->cache, number);
+  if (!entry && normalized)
+    entry = g_hash_table_lookup (self->cache, normalized);
+
+  if (entry) {
+    g_object_set (G_OBJECT (entry),
+                  "blocked", TRUE,
+                  "label", label,
+                  "description", description,
+                  NULL);
+    if (self->repository)
+      gom_resource_save_async (GOM_RESOURCE (entry),
+                               (GAsyncReadyCallback) save_cb,
+                               g_object_ref (self));
+    emit_changed (self);
+    return;
+  }
+
+  entry = g_object_new (CALLS_TYPE_BLOCKED_NUMBER,
+                        "number", number,
+                        "normalized", normalized,
+                        "label", label,
+                        "description", description,
+                        "blocked", TRUE,
+                        "added", (gint64) g_get_real_time () / G_USEC_PER_SEC,
+                        NULL);
+
+  g_list_store_append (self->model, entry);
+  cache_insert (self, entry);
+
+  if (self->repository)
+    gom_resource_save_async (GOM_RESOURCE (entry),
+                             (GAsyncReadyCallback) save_cb,
+                             g_object_ref (self));
+  else
+    self->pending_saves = g_list_append (self->pending_saves,
+                                         g_object_ref (entry));
+
+  g_object_unref (entry);
+  emit_changed (self);
+}
+
+
+void
+calls_blocked_store_set_blocked (CallsBlockedStore  *self,
+                                 CallsBlockedNumber *entry,
+                                 gboolean            blocked)
+{
+  g_return_if_fail (CALLS_IS_BLOCKED_STORE (self));
+  g_return_if_fail (CALLS_IS_BLOCKED_NUMBER (entry));
+
+  g_object_set (G_OBJECT (entry), "blocked", blocked, NULL);
+
+  if (self->repository)
+    gom_resource_save_async (GOM_RESOURCE (entry),
+                             (GAsyncReadyCallback) save_cb,
+                             g_object_ref (self));
+
+  emit_changed (self);
+}
+
+
+void
+calls_blocked_store_remove (CallsBlockedStore  *self,
+                            CallsBlockedNumber *entry)
+{
+  guint position;
+
+  g_return_if_fail (CALLS_IS_BLOCKED_STORE (self));
+  g_return_if_fail (CALLS_IS_BLOCKED_NUMBER (entry));
+
+  if (self->repository)
+    gom_resource_delete_async (GOM_RESOURCE (entry),
+                               (GAsyncReadyCallback) remove_cb,
+                               g_object_ref (self));
+
+  cache_remove (self, entry);
+
+  if (g_list_store_find (self->model, entry, &position))
+    g_list_store_remove (self->model, position);
+
+  emit_changed (self);
+}
+
+
+GListStore *
+calls_blocked_store_get_model (CallsBlockedStore *self)
+{
+  g_return_val_if_fail (CALLS_IS_BLOCKED_STORE (self), NULL);
+
+  return self->model;
+}
+
+
+/* ---------------------------- carga ---------------------------------- */
+
+static void
+load_fetch_cb (GomResourceGroup  *group,
+               GAsyncResult      *res,
+               CallsBlockedStore *self)
+{
+  g_autoptr (GError) error = NULL;
+  guint count;
+  guint i;
+
+  if (!gom_resource_group_fetch_finish (group, res, &error)) {
+    g_warning ("Error leyendo numeros bloqueados: %s",
+               error ? error->message : "desconocido");
+    g_object_unref (group);
+    goto exit;
+  }
+
+  count = gom_resource_group_get_count (group);
+  for (i = 0; i < count; i++) {
+    GomResource *resource = gom_resource_group_get_index (group, i);
+
+    if (!CALLS_IS_BLOCKED_NUMBER (resource))
+      continue;
+
+    g_list_store_append (self->model, CALLS_BLOCKED_NUMBER (resource));
+    cache_insert (self, CALLS_BLOCKED_NUMBER (resource));
+  }
+
+  g_object_unref (group);
+
+  flush_pending_saves (self);
+  emit_changed (self);
+
+exit:
+  g_object_unref (self);
+}
+
+
+static void
+load_find_cb (GomRepository     *repository,
+              GAsyncResult      *res,
+              CallsBlockedStore *self)
+{
+  g_autoptr (GError) error = NULL;
+  GomResourceGroup *group;
+  guint count;
+
+  group = gom_repository_find_finish (repository, res, &error);
+  if (error) {
+    g_warning ("Error buscando numeros bloqueados: %s", error->message);
+    goto exit;
+  }
+
+  g_assert (group != NULL);
+
+  count = gom_resource_group_get_count (group);
+  if (count == 0) {
+    g_object_unref (group);
+    flush_pending_saves (self);
+    goto exit;
+  }
+
+  gom_resource_group_fetch_async (group,
+                                  0,
+                                  count,
+                                  (GAsyncReadyCallback) load_fetch_cb,
+                                  g_object_ref (self));
+
+exit:
+  g_object_unref (self);
+}
+
+
+static void
+load_blocked (CallsBlockedStore *self)
+{
+  GomSorting *sorting;
+
+  sorting = gom_sorting_new (CALLS_TYPE_BLOCKED_NUMBER,
+                             "added",
+                             GOM_SORTING_ASCENDING,
+                             NULL);
+
+  gom_repository_find_sorted_async (self->repository,
+                                    CALLS_TYPE_BLOCKED_NUMBER,
+                                    NULL,
+                                    sorting,
+                                    (GAsyncReadyCallback) load_find_cb,
+                                    g_object_ref (self));
+  g_object_unref (G_OBJECT (sorting));
+}
+
+
+static void
+set_up_repo_migrate_cb (GomRepository     *repo,
+                        GAsyncResult      *res,
+                        CallsBlockedStore *self)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!gom_repository_automatic_migrate_finish (repo, res, &error)) {
+    g_warning ("Error migrando la base de bloqueos `%s': %s",
+               self->filename, error ? error->message : "desconocido");
+    g_clear_object (&self->repository);
+    g_clear_object (&self->adapter);
+    return;
+  }
+
+  load_blocked (self);
+  g_object_unref (self);
+}
+
+
+static void
+set_up_repo (CallsBlockedStore *self)
+{
+  GomRepository *repo;
+  GList *types = NULL;
+
+  repo = gom_repository_new (self->adapter);
+
+  types = g_list_append (types, (gpointer) CALLS_TYPE_BLOCKED_NUMBER);
+  gom_repository_automatic_migrate_async (repo,
+                                          BLOCKED_STORE_VERSION,
+                                          types,
+                                          (GAsyncReadyCallback) set_up_repo_migrate_cb,
+                                          g_object_ref (self));
+
+  self->repository = repo;
+}
+
+
+static void
+open_adapter_cb (GomAdapter        *adapter,
+                 GAsyncResult      *res,
+                 CallsBlockedStore *self)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!gom_adapter_open_finish (adapter, res, &error)) {
+    g_warning ("No se pudo abrir la base de bloqueos `%s': %s",
+               self->filename, error ? error->message : "desconocido");
+    g_clear_object (&self->adapter);
+    goto exit;
+  }
+
+  set_up_repo (self);
+
+exit:
+  g_object_unref (self);
+}
+
+
+static void
+open_repo (CallsBlockedStore *self)
+{
+  g_autofree char *dir = NULL;
+  g_autofree char *uri = NULL;
+  int err;
+
+  if (self->adapter)
+    return;
+
+  dir = g_path_get_dirname (self->filename);
+  err = g_mkdir_with_parents (dir, 0755);
+  if (err)
+    g_warning ("No se pudo crear el directorio de datos de Calls: %s",
+               g_strerror (errno));
+
+  uri = g_strdup_printf ("file:%s", self->filename);
+  self->adapter = gom_adapter_new ();
+  gom_adapter_open_async (self->adapter,
+                          uri,
+                          (GAsyncReadyCallback) open_adapter_cb,
+                          g_object_ref (self));
+}
+
+
+/* ---------------------------- boilerplate ---------------------------- */
+
+static void
+calls_blocked_store_constructed (GObject *object)
+{
+  CallsBlockedStore *self = CALLS_BLOCKED_STORE (object);
+
+  G_OBJECT_CLASS (calls_blocked_store_parent_class)->constructed (object);
+
+  open_repo (self);
+}
+
+
+static void
+calls_blocked_store_finalize (GObject *object)
+{
+  CallsBlockedStore *self = CALLS_BLOCKED_STORE (object);
+
+  g_clear_object (&self->repository);
+  g_clear_object (&self->adapter);
+  g_clear_pointer (&self->cache, g_hash_table_destroy);
+  g_clear_object (&self->model);
+  g_list_free_full (self->pending_saves, g_object_unref);
+  g_clear_pointer (&self->filename, g_free);
+
+  G_OBJECT_CLASS (calls_blocked_store_parent_class)->finalize (object);
+}
+
+
+static void
+calls_blocked_store_class_init (CallsBlockedStoreClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->constructed = calls_blocked_store_constructed;
+  object_class->finalize = calls_blocked_store_finalize;
+
+  /* La lista de la UI se rehace con esto: anadido, cambio de estado o borrado. */
+  signals[SIGNAL_CHANGED] =
+    g_signal_new ("changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE,
+                  0, NULL);
+}
+
+
+static void
+calls_blocked_store_init (CallsBlockedStore *self)
+{
+  self->filename = g_build_filename (g_get_user_data_dir (),
+                                     "calls",
+                                     BLOCKED_STORE_FILENAME,
+                                     NULL);
+  /* Las claves son cadenas propias; los valores toman su referencia (el modelo
+   * es dueno, la cache no debe dejar colgando la entrada al vaciar). */
+  self->cache = g_hash_table_new_full (g_str_hash,
+                                       g_str_equal,
+                                       g_free,
+                                       g_object_unref);
+  self->model = g_list_store_new (CALLS_TYPE_BLOCKED_NUMBER);
+}
+
+
+CallsBlockedStore *
+calls_blocked_store_get_default (void)
+{
+  static volatile gsize inited = 0;
+  static CallsBlockedStore *store = NULL;
+
+  if (g_once_init_enter (&inited)) {
+    CallsBlockedStore *new_store = g_object_new (CALLS_TYPE_BLOCKED_STORE, NULL);
+
+    store = new_store;
+    g_once_init_leave (&inited, 1);
+  }
+
+  return store;
+}
