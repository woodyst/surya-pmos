# Contributor: Bart Ribbers <bribbers@disroot.org>
maintainer="team/gnome <achill@achill.org>"
pkgname=calls
pkgver=50.0
# 2026-09-21: r100 (antes r1) al añadir el 0002. Una recompilación de Alpine (r1..r99) pisaría el parche en un
# `apk upgrade` sin avisar; con r100 no. Mismo criterio que spacewar (spacewar/packages/calls).
# 2026-10-15: r101 suma 0003 (búsqueda por índice precalculado), 0004 (estrella de favorito) y
# 0005 (números bloqueados). Parches idénticos a spacewar; función en spacewar odd/tasks/llamadas-contactos.md.
pkgrel=101
pkgdesc="Phone dialer and call handler"
url="https://gitlab.gnome.org/GNOME/calls"
arch="all"
license="GPL-3.0-or-later"
depends="
	callaudiod
	modemmanager
	sofia-sip-linphone
	"
makedepends="
	abuild-meson
	mobile-broadband-provider-info
	callaudiod-dev
	desktop-file-utils
	evolution-data-server-dev
	feedbackd-dev
	folks-dev
	gettext-dev
	gmobile-dev
	gobject-introspection-dev
	gom-dev
	gsound-dev
	gstreamer-dev
	gtk4.0-dev
	libadwaita-dev
	libpeas2-dev
	meson
	modemmanager-dev
	ninja
	py3-docutils
	sofia-sip-linphone-dev
	vala
	"
subpackages="$pkgname-doc $pkgname-dbg $pkgname-lang $pkgname-systemd"
source="https://download.gnome.org/sources/calls/${pkgver%%.*}/calls-$pkgver.tar.xz
	0001-contacts-box-filtrar-a-plazos-para-no-congelar-el-buscador.patch
	0002-contacts-box-no-filtrar-hasta-tres-caracteres.patch
	0003-contacts-box-indice-de-busqueda-precalculado.patch
	0004-contacts-row-estrella-de-favorito-compartida.patch
	0005-bloqueados-tabla-pestana-rechazo-y-nota-eds.patch
	"
options="!check" # Requires running Wayland compositor

build() {
	abuild-meson \
		-Db_lto=true \
		-Dtests="$(want_check && echo true || echo false)" \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

