+ * Boston, MA 02110-1301 USA.
+ */
+
+#ifndef _LIBQMI_GLIB_QMI_LOC_HELPERS_H_
+#define _LIBQMI_GLIB_QMI_LOC_HELPERS_H_
+
+#if !defined (__LIBQMI_GLIB_H_INSIDE__) && !defined (LIBQMI_GLIB_COMPILATION)
+#error "Only <libqmi-glib.h> can be included directly."
+#endif
+
+#include <glib.h>
+
+#include "qmi-flags64-loc.h"
+#include "qmi-loc.h"
+
+G_BEGIN_DECLS
+
+/**
+ * SECTION:qmi-loc-helpers
+ * @title: LOC service helpers
+ * @short_description: Helpers to consume LOC replies.
+ *
+ * Adapters that turn raw LOC indication contents into a form a location
+ * manager such as ModemManager can use directly.
+ */
+
+/**
+ * qmi_loc_constellation_state_is_enabled:
+ * @state: a per-constellation state value, as reported by the Get Constellation
+ *  Control indication.
+ *
+ * Checks whether a per-constellation state value means the constellation is
+ * enabled.
+ *
+ * The modem does not report a boolean here but a small enumeration whose
+ * individual values are not published. The vendor stack splits them into two
+ * groups, values up to 2 and values from 100 to 103; which group means enabled
+ * was settled on hardware, by checking against a constellation known to be
+ * working. Anything outside both groups is neither, and both this function and
+ * qmi_loc_constellation_state_is_disabled() will return %FALSE for it.
+ *
+ * Returns: %TRUE if the constellation is enabled.
+ *
+ * Since: 1.39
+ */
+gboolean qmi_loc_constellation_state_is_enabled (guint32 state);
+
+/**
+ * qmi_loc_constellation_state_is_disabled:
+ * @state: a per-constellation state value, as reported by the Get Constellation
+ *  Control indication.
+ *
+ * Checks whether a per-constellation state value means the constellation is
+ * disabled. See qmi_loc_constellation_state_is_enabled() for the caveats.
+ *
+ * Returns: %TRUE if the constellation is disabled.
+ *
+ * Since: 1.39
+ */
+gboolean qmi_loc_constellation_state_is_disabled (guint32 state);
+
+#if defined HAVE_QMI_INDICATION_LOC_GET_CONSTELLATION_CONTROL
+
+/**
+ * qmi_indication_loc_get_constellation_control_output_get_constellations:
+ * @self: a #QmiIndicationLocGetConstellationControlOutput.
+ * @out_enabled: (out) (optional): return location for the set of enabled
+ *  constellations.
+ * @out_disabled: (out) (optional): return location for the set of disabled
+ *  constellations.
+ * @error: return location for a #GError, or %NULL.
+ *
+ * Collapses the per-constellation states reported by the modem into two sets.
+ *
+ * The indication carries one optional TLV per constellation, each holding an
+ * unpublished enumeration. This adapter maps them onto #QmiLocGnssConstellation
+ * so that a caller gets a single pair of values instead of six independent
+ * lookups.
+ *
+ * A constellation the modem did not report appears in neither set: absent is
+ * not the same as disabled. A constellation whose state is not recognised is
+ * also left out of both, rather than guessed.
+ *
+ * Returns: %TRUE if at least one constellation was reported, %FALSE otherwise,
+ *  in which case @error is set.
+ *
+ * Since: 1.39
+ */
+gboolean qmi_indication_loc_get_constellation_control_output_get_constellations (
+    QmiIndicationLocGetConstellationControlOutput  *self,
+    QmiLocGnssConstellation                        *out_enabled,
+    QmiLocGnssConstellation                        *out_disabled,
+    GError                                        **error);
+
+#endif /* HAVE_QMI_INDICATION_LOC_GET_CONSTELLATION_CONTROL */
+
+G_END_DECLS
+
+#endif /* _LIBQMI_GLIB_QMI_LOC_HELPERS_H_ */
