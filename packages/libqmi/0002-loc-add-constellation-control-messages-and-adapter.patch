diff --git a/src/libqmi-glib/qmi-flags64-loc.h b/src/libqmi-glib/qmi-flags64-loc.h
index 915af71..a6b9c82 100644
--- a/src/libqmi-glib/qmi-flags64-loc.h
+++ b/src/libqmi-glib/qmi-flags64-loc.h
@@ -148,4 +148,32 @@ typedef enum { /*< since=1.22 >*/
     QMI_LOC_DELETE_GNSS_DATA_FREQ_BIAS_EST =  1 << 18,
 } QmiLocDeleteGnssData;
 
+/**
+ * QmiLocGnssConstellation:
+ * @QMI_LOC_GNSS_CONSTELLATION_GPS: GPS.
+ * @QMI_LOC_GNSS_CONSTELLATION_GLONASS: GLONASS.
+ * @QMI_LOC_GNSS_CONSTELLATION_BEIDOU: BeiDou.
+ * @QMI_LOC_GNSS_CONSTELLATION_GALILEO: Galileo.
+ * @QMI_LOC_GNSS_CONSTELLATION_QZSS: QZSS.
+ * @QMI_LOC_GNSS_CONSTELLATION_NAVIC: NavIC (IRNSS).
+ *
+ * A set of GNSS constellations.
+ *
+ * This is a libqmi-side representation, used to report in a single value what
+ * the modem reports as one TLV per constellation. It is deliberately NOT used
+ * as the on-the-wire format of the constellation bitmasks taken by the
+ * constellation setters: those masks do not all share a single bit order, and
+ * the exact one has not been established for every message.
+ *
+ * Since: 1.39
+ */
+typedef enum { /*< since=1.39 >*/
+    QMI_LOC_GNSS_CONSTELLATION_GPS     = 1 << 0,
+    QMI_LOC_GNSS_CONSTELLATION_GLONASS = 1 << 1,
+    QMI_LOC_GNSS_CONSTELLATION_BEIDOU  = 1 << 2,
+    QMI_LOC_GNSS_CONSTELLATION_GALILEO = 1 << 3,
+    QMI_LOC_GNSS_CONSTELLATION_QZSS    = 1 << 4,
+    QMI_LOC_GNSS_CONSTELLATION_NAVIC   = 1 << 5,
+} QmiLocGnssConstellation;
+
 #endif /* _LIBQMI_GLIB_QMI_FLAGS64_LOC_H_ */
diff --git a/src/libqmi-glib/qmi-loc-helpers.c b/src/libqmi-glib/qmi-loc-helpers.c
new file mode 100644
index 0000000..badd22f
--- /dev/null
+++ b/src/libqmi-glib/qmi-loc-helpers.c
@@ -0,0 +1,102 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * libqmi-glib -- GLib/GIO based library to control QMI devices
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin Street, Fifth Floor,
+ * Boston, MA 02110-1301 USA.
+ */
+
+#include <glib.h>
+
+#include "qmi-loc-helpers.h"
+#include "qmi-errors.h"
+#include "qmi-error-types.h"
+
+/* The modem reports each constellation with a small enumeration rather than a
+ * boolean, and the individual values are not published. The vendor location
+ * stack splits them into two groups: values of 2 or below, and values of 100
+ * to 103 (it masks off the two low bits and compares against 100).
+ *
+ * Which group means what was settled on hardware, not by reading a header. A
+ * device that tracks GPS and GLONASS reports 0 for GPS, 1 for GLONASS, BeiDou,
+ * QZSS and Galileo, and 100 for NavIC. GPS demonstrably works there, so the low
+ * group is the one that is on; and NavIC being the odd one out fits, as it is
+ * regional and normally off outside its coverage.
+ *
+ * Anything outside both groups is left alone rather than folded into one. */
+#define QMI_LOC_CONSTELLATION_STATE_ENABLED_MAX   2
+#define QMI_LOC_CONSTELLATION_STATE_DISABLED_BASE 100
+
+gboolean
+qmi_loc_constellation_state_is_enabled (guint32 state)
+{
+    return (state <= QMI_LOC_CONSTELLATION_STATE_ENABLED_MAX);
+}
+
+gboolean
+qmi_loc_constellation_state_is_disabled (guint32 state)
+{
+    return ((state & ~0x3u) == QMI_LOC_CONSTELLATION_STATE_DISABLED_BASE);
+}
+
+#if defined HAVE_QMI_INDICATION_LOC_GET_CONSTELLATION_CONTROL
+
+gboolean
+qmi_indication_loc_get_constellation_control_output_get_constellations (
+    QmiIndicationLocGetConstellationControlOutput  *self,
+    QmiLocGnssConstellation                        *out_enabled,
+    QmiLocGnssConstellation                        *out_disabled,
+    GError                                        **error)
+{
+    QmiLocGnssConstellation  enabled = 0;
+    QmiLocGnssConstellation  disabled = 0;
+    guint                    n_reported = 0;
+    guint32                  state;
+
+    g_return_val_if_fail (self != NULL, FALSE);
+
+#define COLLECT(GETTER, CONSTELLATION)                                            \
+    if (qmi_indication_loc_get_constellation_control_output_get_##GETTER (        \
+            self, &state, NULL)) {                                                \
+        n_reported++;                                                             \
+        if (qmi_loc_constellation_state_is_enabled (state))                       \
+            enabled |= (CONSTELLATION);                                           \
+        else if (qmi_loc_constellation_state_is_disabled (state))                 \
+            disabled |= (CONSTELLATION);                                          \
+    }
+
+    COLLECT (gps_state,     QMI_LOC_GNSS_CONSTELLATION_GPS)
+    COLLECT (glonass_state, QMI_LOC_GNSS_CONSTELLATION_GLONASS)
+    COLLECT (beidou_state,  QMI_LOC_GNSS_CONSTELLATION_BEIDOU)
+    COLLECT (qzss_state,    QMI_LOC_GNSS_CONSTELLATION_QZSS)
+    COLLECT (galileo_state, QMI_LOC_GNSS_CONSTELLATION_GALILEO)
+    COLLECT (navic_state,   QMI_LOC_GNSS_CONSTELLATION_NAVIC)
+
+#undef COLLECT
+
+    if (!n_reported) {
+        g_set_error (error, QMI_CORE_ERROR, QMI_CORE_ERROR_TLV_NOT_FOUND,
+                     "The indication reported no constellation at all");
+        return FALSE;
+    }
+
+    if (out_enabled)
+        *out_enabled = enabled;
+    if (out_disabled)
+        *out_disabled = disabled;
+    return TRUE;
+}
+
+#endif /* HAVE_QMI_INDICATION_LOC_GET_CONSTELLATION_CONTROL */
