--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -25,11 +25,23 @@
 #include <stddef.h>
 #include <stdio.h>
 
+#include <stdlib.h>
+
 #include "aee_error.h"
 #include "interfaces/adsp_listener.def"
 #include "iobuffer.h"
 #include "listener.h"
 
+/*
+ * The FastRPC ioctl needs the input buffer's capacity fixed upfront (the
+ * remote side writes directly into it - there is no way to ask for the real
+ * size first and fetch again, since by the time we learn the size the
+ * message has already been consumed off the queue). 256B was too small for
+ * real calibration data (sensor registry entries here go up to ~1KB), so use
+ * a much larger budget instead of assuming every message is tiny.
+ */
+#define HEXAGONRPC_MAX_INBUF_SIZE 8192
+
 static int adsp_listener_init2(int fd)
 {
 	return fastrpc2(&adsp_listener_init2_def, fd, ADSP_LISTENER_HANDLE);
@@ -142,19 +154,26 @@
 				  struct fastrpc_io_buffer **decoded)
 {
 	struct fastrpc_decoder_context *ctx;
-	char inbufs[256];
+	char *inbufs;
 	char *outbufs = NULL;
 	uint32_t inbufs_len;
 	uint32_t outbufs_len;
 	int ret;
 
+	inbufs = malloc(HEXAGONRPC_MAX_INBUF_SIZE);
+	if (inbufs == NULL) {
+		perror("Could not allocate decoded input buffer");
+		return -1;
+	}
+
 	outbufs_len = outbufs_calculate_size(REMOTE_SCALARS_OUTBUFS(*sc), returned);
 
 	if (outbufs_len) {
 		outbufs = malloc(outbufs_len);
 		if (outbufs == NULL) {
 			perror("Could not allocate encoded output buffer");
-			return -1;
+			ret = -1;
+			goto err_free_inbufs;
 		}
 
 		outbufs_encode(REMOTE_SCALARS_OUTBUFS(*sc), returned, outbufs);
@@ -164,7 +183,7 @@
 				  *rctx, result,
 				  outbufs_len, outbufs,
 				  rctx, handle, sc,
-				  &inbufs_len, 256, inbufs);
+				  &inbufs_len, HEXAGONRPC_MAX_INBUF_SIZE, inbufs);
 	if (ret) {
 		if (ret == -1)
 			perror("Could not fetch next FastRPC message");
@@ -174,8 +193,9 @@
 		goto err_free_outbufs;
 	}
 
-	if (inbufs_len > 256) {
-		fprintf(stderr, "Large (>256B) input buffers aren't implemented\n");
+	if (inbufs_len > HEXAGONRPC_MAX_INBUF_SIZE) {
+		fprintf(stderr, "Large (>%uB) input buffers aren't implemented\n",
+				HEXAGONRPC_MAX_INBUF_SIZE);
 		ret = -1;
 		goto err_free_outbufs;
 	}
@@ -203,6 +223,8 @@
 
 err_free_outbufs:
 	free(outbufs);
+err_free_inbufs:
+	free(inbufs);
 	return ret;
 }
 
