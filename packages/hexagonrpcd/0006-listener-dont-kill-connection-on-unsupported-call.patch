+/*
+ * Rejects the current call cleanly: the remote gets *result back on the next
+ * round-trip as normal, with zero output buffers. This is deliberately
+ * different from returning nonzero (which tears down the whole reverse
+ * tunnel) - a single call this daemon doesn't support (unknown interface,
+ * unknown method, malformed argument count, ...) is routine (e.g. the ADSP
+ * probing for an optional interface that doesn't exist here) and must not
+ * kill every *other* already-working call on the same connection.
+ */
+static int reject_call(uint32_t *result, uint32_t code,
+		       struct fastrpc_io_buffer **returned,
+		       uint32_t *out_n_outbufs)
+{
+	*result = code;
+	*returned = NULL;
+	*out_n_outbufs = 0;
+
+	return 0;
+}
