+/*
+ * Like hexagonfs_openat(), but stops one path segment short: instead of
+ * opening the final segment, it returns the directory it would have been
+ * opened in (out_dir) and its name (out_segment), so the caller can operate
+ * on it directly (e.g. to rename it) without hexagonfs needing a way to
+ * "open for rename".
+ */
+static int resolve_parent_dir(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			      const char *name,
+			      struct hexagonfs_fd **out_dir,
+			      char **out_segment)
+{
+	struct hexagonfs_fd *fd;
+	const char *curr = name;
+	char *segment;
+	bool expect_dir;
+	int selected = dirfd;
+	int ret = 0;
+
+	if (*curr == '/') {
+		selected = rootfd;
+
+		while (*curr == '/')
+			curr++;
+	}
+
+	fd = fds[selected];
+
+	for (;;) {
+		segment = copy_segment_and_advance(curr, &expect_dir, &curr);
+		if (segment == NULL)
+			return -ENOMEM;
+
+		if (*curr == '\0')
+			break;
+
+		if (!strcmp(segment, ".")) {
+			// no-op
+		} else if (!strcmp(segment, "..")) {
+			fd = pop_dir(fd, fds[rootfd]);
+		} else {
+			ret = fd->ops->openat(fd, segment, true, false, &fd);
+		}
+
+		free(segment);
+
+		if (ret) {
+			destroy_file_descriptor(fd);
+			return ret;
+		}
+	}
+
+	*out_dir = fd;
+	*out_segment = segment;
+
+	return 0;
+}
+
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		     const char *oldname, const char *newname)
+{
+	struct hexagonfs_fd *old_dir, *new_dir;
+	char *old_segment, *new_segment;
+	int ret;
+
+	ret = resolve_parent_dir(fds, rootfd, dirfd, oldname, &old_dir, &old_segment);
+	if (ret)
+		return ret;
+
+	ret = resolve_parent_dir(fds, rootfd, dirfd, newname, &new_dir, &new_segment);
+	if (ret) {
+		free(old_segment);
+		destroy_file_descriptor(old_dir);
+		return ret;
+	}
+
+	if (old_dir->ops != new_dir->ops || old_dir->ops->rename == NULL)
+		ret = -EXDEV;
+	else
+		ret = old_dir->ops->rename(old_dir, old_segment, new_dir, new_segment);
+
+	free(old_segment);
+	free(new_segment);
+	destroy_file_descriptor(old_dir);
+	destroy_file_descriptor(new_dir);
+
+	return ret;
+}
