+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	int ret;
+
+	// The old and new names must be NULL-terminated
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
+	 || ((const char *) inbufs[2].p)[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_rename(ctx->fds, ctx->rootfd, ctx->rootfd,
+			      inbufs[1].p, inbufs[2].p);
+	if (ret) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+				(const char *) inbufs[1].p,
+				(const char *) inbufs[2].p,
+				strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("frename(%s, %s)\n", (const char *) inbufs[1].p,
+				    (const char *) inbufs[2].p);
+#endif
+
+	return 0;
+}
