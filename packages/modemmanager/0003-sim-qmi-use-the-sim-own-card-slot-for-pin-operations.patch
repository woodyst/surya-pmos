From: Eduardo Garcia-Madico Portabella <woodyst@gmail.com>
Date: Wed, 12 Aug 2026 15:50:00 +0200
Subject: [PATCH] sim-qmi: address the SIM's own card slot in PIN operations

The four UIM PIN operations (verify, unblock, change and set-protection)
hardcode QMI_UIM_SESSION_TYPE_CARD_SLOT_1. That session type selects a
physical card slot, so on any device whose SIM is not in slot 1 the modem
is asked to operate on an empty slot.

The failure is very hard to read, because it does not look like a slot
problem at all:

  <<<<<< TLV: type = "Session" (0x01)
  <<<<<<      translated = [ session_type = 'card-slot-1' ]
  ...
  Couldn't verify PIN: QMI protocol error (3): 'Internal'

Reads keep working, since those use the primary GW provisioning session,
and the PIN retry counter is never decremented -- the PIN never reaches
the card. Observed on a Xiaomi POCO X3 NFC (SM7150) running mainline,
where the SIM sits in slot 2 and slot 1 reports 'no-atr-received'.

SIM objects created from slot enumeration already carry their slot
number, so use it. Slot number 0 means unknown, and keeps the previous
behaviour.

Verified on the device: with the session type pointed at slot 2, the
same PIN that had failed four times in a row is accepted.
---
--- a/src/mm-sim-qmi.c	2026-08-12 15:55:07.514736759 +0200
+++ b/src/mm-sim-qmi.c	2026-08-12 15:55:07.574736179 +0200
@@ -1134,6 +1134,33 @@
     return qmi_error;
 }
 
+/* The PIN operations below address a *physical card slot*, not the
+ * provisioning session used elsewhere in this file. Hardcoding slot 1 breaks
+ * every device whose SIM lives in another slot: the modem is asked to verify a
+ * PIN against an empty slot and answers with a generic 'Internal' protocol
+ * error, which looks nothing like a SIM problem. Observed on a Xiaomi POCO X3
+ * NFC (SM7150), where the card sits in slot 2 and slot 1 reports
+ * 'no-atr-received'.
+ *
+ * Slot number 0 means "unknown" (SIM objects created without slot
+ * enumeration), so keep the previous behaviour in that case. */
+static QmiUimSessionType
+pin_session_type (MMSimQmi *self)
+{
+    switch (mm_base_sim_get_slot_number (MM_BASE_SIM (self))) {
+    case 2:
+        return QMI_UIM_SESSION_TYPE_CARD_SLOT_2;
+    case 3:
+        return QMI_UIM_SESSION_TYPE_CARD_SLOT_3;
+    case 4:
+        return QMI_UIM_SESSION_TYPE_CARD_SLOT_4;
+    case 5:
+        return QMI_UIM_SESSION_TYPE_CARD_SLOT_5;
+    default:
+        return QMI_UIM_SESSION_TYPE_CARD_SLOT_1;
+    }
+}
+
 static gboolean
 send_pin_finish (MMBaseSim     *self,
                  GAsyncResult  *res,
@@ -1187,7 +1214,7 @@
     aid = g_array_new (FALSE, FALSE, sizeof (guint8)); /* empty AID */
     qmi_message_uim_verify_pin_input_set_session (
         input,
-        QMI_UIM_SESSION_TYPE_CARD_SLOT_1,
+        pin_session_type (self),
         aid,
         NULL);
     g_array_unref (aid);
@@ -1349,7 +1376,7 @@
     aid = g_array_new (FALSE, FALSE, sizeof (guint8)); /* empty AID */
     qmi_message_uim_unblock_pin_input_set_session (
         input,
-        QMI_UIM_SESSION_TYPE_CARD_SLOT_1,
+        pin_session_type (self),
         aid,
         NULL);
     g_array_unref (aid);
@@ -1519,7 +1546,7 @@
     aid = g_array_new (FALSE, FALSE, sizeof (guint8)); /* empty AID */
     qmi_message_uim_change_pin_input_set_session (
         input,
-        QMI_UIM_SESSION_TYPE_CARD_SLOT_1,
+        pin_session_type (self),
         aid,
         NULL);
     g_array_unref (aid);
@@ -1688,7 +1715,7 @@
     aid = g_array_new (FALSE, FALSE, sizeof (guint8)); /* empty AID */
     qmi_message_uim_set_pin_protection_input_set_session (
         input,
-        QMI_UIM_SESSION_TYPE_CARD_SLOT_1,
+        pin_session_type (self),
         aid,
         NULL);
     g_array_unref (aid);
